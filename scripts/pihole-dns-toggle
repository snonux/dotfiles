#!/usr/bin/env bash
# Toggle Pi-hole DNS on/off for active network connection

set -euo pipefail

_PIHOLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/f3s-hosts.sh
source "${_PIHOLE_DIR}/lib/f3s-hosts.sh"

# Pi-hole DNS: pi2/pi3, intermediate fallback, LAN gateway (see f3s-hosts).
PIHOLE_DNS="$F3S_PIHOLE_DNS"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Get active Ethernet/Wi-Fi connection names.
get_active_connections() {
    nmcli -t -f NAME,DEVICE,TYPE connection show --active | \
        awk -F: '$2 != "lo" && ($3 == "802-3-ethernet" || $3 == "802-11-wireless") { print $1 }'
}

# Check if Pi-hole DNS is currently enabled: 0 = enabled, 1 = disabled,
# 2 = nmcli could not be queried. Callers test it under 'if'/'||', where
# set -e is off, so the queries are checked explicitly: a failed query
# must not read as "disabled" (toggle would then rewrite DNS).
is_pihole_enabled() {
    local connection="$1"
    local ignore_auto_dns
    local configured_dns

    ignore_auto_dns=$(nmcli -g ipv4.ignore-auto-dns connection show "$connection") \
        || return 2
    configured_dns=$(nmcli -g ipv4.dns connection show "$connection" | tr ',' ' ') \
        || return 2

    [[ "$ignore_auto_dns" == "yes" && "$configured_dns" == "$PIHOLE_DNS" ]]
}

# Enable Pi-hole DNS
enable_pihole() {
    local connection

    for connection in "$@"; do
        echo -e "${YELLOW}Enabling Pi-hole DNS for connection: $connection${NC}"
        nmcli con mod "$connection" ipv4.dns "$PIHOLE_DNS"
        nmcli con mod "$connection" ipv4.ignore-auto-dns yes
        nmcli con up "$connection" > /dev/null 2>&1
    done

    echo -e "${GREEN}✓ Pi-hole DNS enabled${NC}"
    echo "DNS servers: $PIHOLE_DNS"
}

# Disable Pi-hole DNS (use DHCP-provided DNS)
disable_pihole() {
    local connection

    for connection in "$@"; do
        echo -e "${YELLOW}Disabling Pi-hole DNS for connection: $connection${NC}"
        nmcli con mod "$connection" ipv4.dns ""
        nmcli con mod "$connection" ipv4.ignore-auto-dns no
        nmcli con up "$connection" > /dev/null 2>&1
    done

    echo -e "${GREEN}✓ Pi-hole DNS disabled (using DHCP DNS)${NC}"
}

# Same status codes as is_pihole_enabled, over all connections: stops at
# the first connection that is disabled (1) or cannot be queried (2).
all_connections_pihole_enabled() {
    local connection
    local -i rc

    for connection in "$@"; do
        rc=0
        # shellcheck disable=SC2310 # status is the answer, handled below
        is_pihole_enabled "$connection" || rc=$?
        if ((rc != 0)); then
            return "$rc"
        fi
    done

    return 0
}

# pihole_state CONNECTIONS... — set PIHOLE_STATE to "enabled" or
# "disabled", or exit 1 with an error when the DNS settings cannot be read.
# Called directly (not in a command substitution) so the exit ends the
# script before toggle can change anything.
pihole_state() {
    local -i rc=0
    # shellcheck disable=SC2310 # status is the answer, handled below
    all_connections_pihole_enabled "$@" || rc=$?
    case "$rc" in
        0) PIHOLE_STATE=enabled ;;
        1) PIHOLE_STATE=disabled ;;
        *)
            echo -e "${RED}Error: cannot read the DNS settings from nmcli${NC}" >&2
            exit 1
            ;;
    esac
}

# Show current DNS status
show_status() {
    echo -e "\n${YELLOW}Current DNS configuration:${NC}"
    nmcli dev show | awk -F: '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }
        /^GENERAL.DEVICE:/ { device=trim($2) }
        /^IP4.DNS/ { print device ": " trim($2) }
    '
}

# Check if running on Fedora
check_os() {
    if [[ ! -f /etc/fedora-release ]]; then
        echo -e "${RED}Error: This script is designed for Fedora Linux only${NC}"
        if [[ -f /etc/os-release ]]; then
            source /etc/os-release
            echo "Detected OS: $NAME"
        fi
        exit 1
    fi
}

usage() {
    cat <<EOF
Usage: ${0##*/} [toggle|on|enable|off|disable|status|-h|--help]

Toggle Pi-hole DNS on the active Ethernet/Wi-Fi connections.
With no argument, toggle.
EOF
}

# Validate the arguments before the OS gate and any nmcli call, so a typo
# or --help can never fall through to the toggle path and rewrite DNS.
# Sets ACTION; exits 0 for help and 2 for bad usage. Called directly (not
# in a command substitution) so those exits end the script itself.
parse_action() {
    if (($# > 1)); then
        usage >&2
        exit 2
    fi
    case "${1:-toggle}" in
        -h|--help|help)
            usage
            exit 0
            ;;
        toggle|on|enable|off|disable|status)
            ACTION="${1:-toggle}"
            ;;
        *)
            echo -e "${RED}Error: unknown argument: $1${NC}" >&2
            usage >&2
            exit 2
            ;;
    esac
}

# Main logic
main() {
    parse_action "$@"

    # Check OS compatibility
    check_os

    # Check if running as root
    if [[ $EUID -eq 0 ]]; then
        echo -e "${RED}Error: Do not run this script as root${NC}"
        exit 1
    fi

    # Active connections into a temp file so nmcli failures fail closed under
    # set -e (process substitution would mask them).
    connections_list="$(mktemp)"
    trap 'rm -f "$connections_list"' EXIT
    get_active_connections >"$connections_list"
    mapfile -t CONNECTIONS <"$connections_list"
    rm -f "$connections_list"
    trap - EXIT

    if [[ "${#CONNECTIONS[@]}" -eq 0 ]]; then
        echo -e "${RED}Error: No active network connection found${NC}"
        exit 1
    fi

    echo "Active connections: ${CONNECTIONS[*]}"

    # Dispatch the action validated by parse_action.
    case "$ACTION" in
        on|enable)
            enable_pihole "${CONNECTIONS[@]}"
            show_status
            ;;
        off|disable)
            disable_pihole "${CONNECTIONS[@]}"
            show_status
            ;;
        status)
            pihole_state "${CONNECTIONS[@]}"
            if [[ "$PIHOLE_STATE" == enabled ]]; then
                echo -e "${GREEN}Pi-hole DNS is currently ENABLED${NC}"
            else
                echo -e "${YELLOW}Pi-hole DNS is currently DISABLED${NC}"
            fi
            show_status
            ;;
        toggle)
            pihole_state "${CONNECTIONS[@]}"
            if [[ "$PIHOLE_STATE" == enabled ]]; then
                disable_pihole "${CONNECTIONS[@]}"
            else
                enable_pihole "${CONNECTIONS[@]}"
            fi
            show_status
            ;;
    esac
}

main "$@"
