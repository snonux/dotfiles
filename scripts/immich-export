#!/usr/bin/env bash
# Export Immich assets for given accounts within a date range.
# Usage: immich-export [options]
#
# Options / env (CLI overrides env; env overrides defaults):
#   --dest DIR              Output root (IMMICH_EXPORT_DEST)
#   --after DATETIME        takenAfter exclusive (IMMICH_EXPORT_AFTER)
#   --before DATETIME       takenBefore exclusive (IMMICH_EXPORT_BEFORE)
#   --account NAME          Account to export (repeatable; default paul, albena).
#                           Key file: ~/.immich_<name>_key
#   --lan-url URL           LAN Immich base (IMMICH_LAN_URL)
#   --public-url URL        Public Immich base (IMMICH_PUBLIC_URL)
#   -h, --help              Show usage
#
# Works in two phases per account:
#   1. Discovery — paginate through all search results and collect asset IDs
#   2. Download  — fetch each asset with real [X/total] progress
#
# Exits non-zero if an account's API key is missing/empty, asset discovery
# fails (search request or parse error on any page), any download or local
# write (temp file, rename) fails, or same-run id/dest collisions occur.
# Path-unsafe names and destinations that already exist are refused (logged)
# without failing the whole run.

set -euo pipefail

_IMMICH_EXPORT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/immich.sh
source "${_IMMICH_EXPORT_DIR}/lib/immich.sh"

# Export-only defaults — overridable by env, then CLI in main().
# IMMICH_LAN_URL / IMMICH_PUBLIC_URL / IMMICH_URL / CURL_* come from lib/immich.sh
# (inventory via f3s-hosts, env override, then --lan-url/--public-url).
DEST_DIR="${IMMICH_EXPORT_DEST:-/home/paul/Pictures/Pictures.Processing}"
# Immich treats takenAfter/takenBefore as exclusive boundaries.
DATE_AFTER="${IMMICH_EXPORT_AFTER:-2026-03-31T23:59:59.999Z}"
DATE_BEFORE="${IMMICH_EXPORT_BEFORE:-2026-07-01T00:00:00.000Z}"
PAGE_SIZE=100

# Download temps live under the account dir with this mktemp template.
# Cleanup matches the glob only — never '*.tmp' (could wipe real exports).
readonly _IMMICH_EXPORT_TMP_TEMPLATE='.immich-export.XXXXXX'
readonly _IMMICH_EXPORT_TMP_GLOB='.immich-export.*'

usage() {
    cat <<'EOF'
Usage: immich-export [options]

  --dest DIR           Output root (env: IMMICH_EXPORT_DEST)
  --after DATETIME     takenAfter exclusive (env: IMMICH_EXPORT_AFTER)
  --before DATETIME    takenBefore exclusive (env: IMMICH_EXPORT_BEFORE)
  --account NAME       Account to export; repeatable (default: paul albena).
                       Reads API key from ~/.immich_<NAME>_key
  --lan-url URL        LAN Immich base (env: IMMICH_LAN_URL)
  --public-url URL     Public Immich base (env: IMMICH_PUBLIC_URL)
  -h, --help           Show this help
EOF
}

# _safe_export_filename RAW — print a single path component safe to join under
# an account export directory. Never join RAW onto DEST unchanged: Immich
# originalFileName is attacker-influenced and may contain ../ or absolute
# paths. Returns 1 if RAW is empty, absolute, has control chars, or resolves
# to "." / "..".
_safe_export_filename() {
    local -r raw="$1"
    local base

    [[ -n "$raw" ]] || return 1
    # Absolute paths are refused even though basename would strip the prefix.
    [[ "$raw" != /* ]] || return 1
    # Tab/newline would break discover's id<TAB>filename lines and IFS reads.
    case "$raw" in
        *$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
    esac

    base=$(basename -- "$raw")
    [[ -n "$base" ]] || return 1
    case "$base" in
        .|..) return 1 ;;
        *$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
    esac
    # basename should never leave a slash; keep the guard anyway.
    [[ "$base" != */* ]] || return 1

    printf '%s\n' "$base"
}

# _safe_asset_id RAW — accept an Immich asset id for use in export names.
# Allowlist standard UUID form only. That keeps {id}_{basename} injective:
# UUIDs contain no '_', so the id is always the fixed UUID prefix before the
# first '_' and cannot ambiguously recombine with basename segments
# (e.g. ab+c_d vs ab_c+d). Also refuse path/control characters.
_safe_asset_id() {
    local -r raw="$1"

    [[ -n "$raw" ]] || return 1
    # UUID: 8-4-4-4-12 hex (any version). No other shapes.
    [[ "$raw" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
        || return 1

    printf '%s\n' "$raw"
}

# _unique_export_basename ASSET_ID SAFE_BASENAME — local name that stays unique
# across distinct assets even when originalFileName (or its basename) collides.
# Layout: {uuid}_{sanitized_basename}. Injective because uuid has no '_'.
_unique_export_basename() {
    local -r asset_id="$1"
    local -r safe="$2"
    local id

    # shellcheck disable=SC2310 # pure validator: non-zero means invalid
    id=$(_safe_asset_id "$asset_id") || return 1
    [[ -n "$safe" ]] || return 1
    printf '%s_%s\n' "$id" "$safe"
}

# _path_is_under DIR CANDIDATE — succeed if CANDIDATE resolves under DIR.
# Uses physical paths so symlink escapes cannot pass the check.
_path_is_under() {
    local -r dir="$1"
    local -r candidate="$2"
    local dir_real cand_real cand_parent

    dir_real=$(cd -- "$dir" && pwd -P) || return 1
    if [[ -e "$candidate" || -L "$candidate" ]]; then
        cand_real=$(realpath -e -- "$candidate" 2>/dev/null) || return 1
    else
        cand_parent=$(cd -- "$(dirname -- "$candidate")" && pwd -P) || return 1
        cand_real="$cand_parent/$(basename -- "$candidate")"
    fi

    [[ "$cand_real" == "$dir_real" || "$cand_real" == "$dir_real"/* ]]
}

# Phase 1: paginate through all search results and print "id\tfilename" lines.
# The API's 'total' field only reflects the current page size, not the grand
# total, so we must walk all pages to know how many assets there are.
#
# Returns 1 if any search request or JSON parse fails. Every step is checked
# explicitly: callers run this under 'if !', where bash ignores set -e for the
# whole call tree, so a failed page would otherwise silently truncate the list.
discover_assets() {
    local api_key="$1"
    local page=1

    while true; do
        local response
        # curl_immich_key keeps the API key off curl's argv (see lib). It
        # checks its one precondition itself; its status is curl's.
        # shellcheck disable=SC2310
        if ! response=$(curl_immich_key -f "$CURL_SEARCH_TIMEOUT" "$api_key" \
            -X POST "$IMMICH_URL/api/search/metadata" \
            -H "Content-Type: application/json" \
            -d "{\"takenAfter\":\"$DATE_AFTER\",\"takenBefore\":\"$DATE_BEFORE\",\"type\":\"IMAGE\",\"size\":$PAGE_SIZE,\"page\":$page}"); then
            echo "    ERROR: discovery failed: search request for page $page failed" >&2
            return 1
        fi

        # Print id<TAB>filename for each asset on this page. Skip names that
        # contain tab/newline/CR — those would corrupt the TSV stream.
        if ! printf '%s\n' "$response" | python3 -c "
import json, sys
d = json.load(sys.stdin)
for item in d['assets']['items']:
    name = item['originalFileName']
    if any(c in name for c in ('\t', '\n', '\r')):
        print(
            f\"discover: refusing unsafe originalFileName for {item['id']}: {name!r}\",
            file=sys.stderr,
        )
        continue
    print(item['id'] + '\t' + name)
"; then
            echo "    ERROR: discovery failed: cannot parse search response for page $page" >&2
            return 1
        fi
        # Use 'or ""' to handle null nextPage — .get() returns None when the key
        # exists with a JSON null value, and print(None) would yield "None" (non-empty).
        # A parse failure here must not look like "no next page" (empty output).
        local next_page
        if ! next_page=$(printf '%s\n' "$response" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['assets'].get('nextPage') or '')"); then
            echo "    ERROR: discovery failed: cannot read nextPage for page $page" >&2
            return 1
        fi

        echo "    Discovery: page $page done..." >&2
        [[ -z "$next_page" ]] && break
        page="$next_page"
    done
}

# _place_download TMP DEST — move a finished download into place without ever
# replacing an existing DEST. Returns 0 when placed, 2 when DEST already
# exists (a genuine refusal), 1 on a local write error. TMP is removed
# whenever it was not placed.
#
# GNU mv -n exits 0 when it declines to overwrite (coreutils 9.10; some older
# releases exit 1 instead), so the exit status alone cannot tell a refusal
# from success or a failure. TMP still being there after mv means it was not
# moved.
_place_download() {
    local -r tmp="$1"
    local -r dest="$2"
    local -i mv_rc=0

    # Re-check dest before rename (TOCTOU / planted symlink).
    if [[ -e "$dest" || -L "$dest" ]]; then
        rm -f -- "$tmp"
        return 2
    fi
    # -T: treat dest as a file name even if a directory (or a symlink to one)
    # appeared there after the check above. Without it mv would move the temp
    # file INTO that directory and exit 0, so the asset would count as
    # downloaded although it is not at dest, possibly outside the account dir.
    mv -nT -- "$tmp" "$dest" || mv_rc=$?
    if [[ ! -e "$tmp" && ! -L "$tmp" ]]; then
        ((mv_rc == 0)) && return 0
        return 1
    fi
    rm -f -- "$tmp"
    # Not moved: a dest that appeared meanwhile is a refusal, else a failure.
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 2
    fi
    return 1
}

# Outcome codes of one asset row in phase 2. The per-row helpers below
# return one of these and download_assets turns it into its counters, so
# the helpers never touch the caller's counters.
readonly _ROW_DOWNLOADED=0
readonly _ROW_FAILED=1     # download or local write error (fails the run)
readonly _ROW_REFUSED=2    # bad input or dest already present (logged only)
readonly _ROW_SKIPPED=3    # regular file already at dest

# Same-run collision tracking for download_assets (documented globals, reset
# by download_assets at its start): asset id -> safe basename, and unique
# name -> asset id. Globals instead of the caller's locals so that
# _claim_run_slot can update them without reaching into download_assets.
declare -gA _RUN_SEEN_IDS=()
declare -gA _RUN_DEST_OWNERS=()

# _resolve_export_dest ACCOUNT_DIR ASSET_ID FILENAME PROGRESS — run the three
# name checks for one row and print its unique local name
# ({uuid}_{sanitized_basename}) on stdout. On a refusal it logs why to stderr
# (prefixed with PROGRESS, "n/total") and returns 1. Every step is an
# explicit check, so callers may run it under 'if !'.
_resolve_export_dest() {
    local -r account_dir="$1" asset_id="$2" filename="$3" progress="$4"
    local safe unique

    # The three checks below are pure validators: non-zero means refuse.
    # shellcheck disable=SC2310
    if ! safe=$(_safe_export_filename "$filename"); then
        echo "    [$progress] ERROR: refusing unsafe originalFileName: ${filename@Q}" >&2
        return 1
    fi
    # shellcheck disable=SC2310
    if ! unique=$(_unique_export_basename "$asset_id" "$safe"); then
        echo "    [$progress] ERROR: refusing unsafe asset id: ${asset_id@Q}" >&2
        return 1
    fi
    local -r dest="$account_dir/$unique"
    # shellcheck disable=SC2310
    if ! _path_is_under "$account_dir" "$dest"; then
        echo "    [$progress] ERROR: dest escapes account dir: ${dest@Q}" >&2
        return 1
    fi
    printf '%s\n' "$unique"
}

# _claim_run_slot ASSET_ID SAFE UNIQUE PROGRESS — record this row in the
# same-run collision maps (_RUN_SEEN_IDS, _RUN_DEST_OWNERS). Returns 1 and
# logs if the asset id or the unique name was already claimed in this run.
_claim_run_slot() {
    local -r asset_id="$1" safe="$2" unique="$3" progress="$4"

    # Same asset id twice in one run (even with different basenames) is a
    # corrupt/duplicated discover stream — refuse clearly by id, not dest.
    if [[ -n "${_RUN_SEEN_IDS[$asset_id]+x}" ]]; then
        echo "    [$progress] ERROR: duplicate asset id ${asset_id@Q} (earlier basename ${_RUN_SEEN_IDS[$asset_id]@Q}, this ${safe@Q})" >&2
        return 1
    fi
    _RUN_SEEN_IDS[$asset_id]="$safe"

    # Defense in depth: final unique name should be unique once ids are.
    if [[ -n "${_RUN_DEST_OWNERS[$unique]+x}" ]]; then
        echo "    [$progress] ERROR: destination collision for ${unique@Q}: assets ${_RUN_DEST_OWNERS[$unique]@Q} and ${asset_id@Q}" >&2
        return 1
    fi
    _RUN_DEST_OWNERS[$unique]="$asset_id"
}

# _download_asset API_KEY ACCOUNT_DIR ASSET_ID UNIQUE PROGRESS — fetch one
# asset to ACCOUNT_DIR/UNIQUE unless something is already there. Logs the
# result and returns a _ROW_* code.
_download_asset() {
    local -r api_key="$1" account_dir="$2" asset_id="$3" unique="$4" progress="$5"
    local -r dest="$account_dir/$unique"

    if [[ -e "$dest" || -L "$dest" ]]; then
        if [[ -f "$dest" && ! -L "$dest" ]]; then
            echo "    [$progress] skip (exists): $unique"
            return "$_ROW_SKIPPED"
        fi
        echo "    [$progress] ERROR: refusing non-regular dest: ${dest@Q}" >&2
        return "$_ROW_REFUSED"
    fi

    # Create a fresh regular file under account_dir (mktemp uses O_EXCL).
    # Never write to "$dest.tmp": curl -o follows a planted symlink and
    # can escape the account directory.
    # A failed mktemp is a local write error (unwritable dir, full disk),
    # not bad input: count it as failed so the run exits non-zero.
    local tmp
    if ! tmp=$(mktemp -p "$account_dir" "$_IMMICH_EXPORT_TMP_TEMPLATE"); then
        echo "    [$progress] ERROR: mktemp failed under $account_dir" >&2
        return "$_ROW_FAILED"
    fi
    # shellcheck disable=SC2310 # pure check: non-zero means escape
    if ! _path_is_under "$account_dir" "$tmp"; then
        rm -f -- "$tmp"
        echo "    [$progress] ERROR: temp path escapes account dir: ${tmp@Q}" >&2
        return "$_ROW_REFUSED"
    fi
    _fetch_and_place "$api_key" "$asset_id" "$tmp" "$dest" "$unique" "$progress"
}

# _fetch_and_place API_KEY ASSET_ID TMP DEST UNIQUE PROGRESS — download the
# asset into TMP, then move it to DEST with _place_download. Logs the result
# and returns a _ROW_* code; TMP never survives a failure.
_fetch_and_place() {
    local -r api_key="$1" asset_id="$2" tmp="$3" dest="$4" unique="$5" progress="$6"
    local -i place_rc=0

    # Status is curl's (see discover_assets); both branches handle it.
    # shellcheck disable=SC2310
    if ! curl_immich_key -f "$CURL_DOWNLOAD_TIMEOUT" "$api_key" -o "$tmp" \
        "$IMMICH_URL/api/assets/$asset_id/original"; then
        echo "    [$progress] ERROR: failed to download $asset_id ($unique)" >&2
        rm -f -- "$tmp"
        return "$_ROW_FAILED"
    fi
    # _place_download returns an explicit code from checked steps.
    # shellcheck disable=SC2310
    _place_download "$tmp" "$dest" || place_rc=$?
    case "$place_rc" in
        0)
            echo "    [$progress] downloaded: $unique"
            return "$_ROW_DOWNLOADED"
            ;;
        2)
            echo "    [$progress] ERROR: dest appeared before rename: ${dest@Q}" >&2
            return "$_ROW_REFUSED"
            ;;
        *)
            echo "    [$progress] ERROR: failed to place $unique" >&2
            return "$_ROW_FAILED"
            ;;
    esac
}

# Phase 2: download each asset by ID, showing real [X/total] progress.
# Destinations are {uuid}_{sanitized_basename} so distinct assets that share
# originalFileName (or collapse to the same basename) all export. UUID
# allowlisting keeps that join injective. Returns non-zero on download or
# local write failures (mktemp, rename) or same-run duplicate asset id /
# destination collision. 'refused' (bad input, dest already present) alone
# does not fail the run.
#
# The per-row work lives in the helpers above; this loop only counts their
# outcomes. Every helper is called under 'if !' or '|| rc=$?' and checks its
# own steps, as set -e is off here anyway (main runs the account under 'if !').
download_assets() {
    local api_key="$1"
    local account_dir="$2"
    local asset_list="$3"   # path to temp file with "id\tfilename" lines
    local total
    total=$(wc -l < "$asset_list")
    local -i downloaded=0 skipped=0 refused=0 collided=0 failed=0 n=0
    _RUN_SEEN_IDS=()
    _RUN_DEST_OWNERS=()

    while IFS=$'\t' read -r asset_id filename; do
        ((n++)) || true

        local unique
        # shellcheck disable=SC2310 # every step is an explicit check
        if ! unique=$(_resolve_export_dest "$account_dir" "$asset_id" "$filename" "$n/$total"); then
            ((refused++)) || true
            continue
        fi
        # unique is "{asset_id}_{safe}"; the id is a UUID, which has no '_'.
        # shellcheck disable=SC2310 # every step is an explicit check
        if ! _claim_run_slot "$asset_id" "${unique#"${asset_id}_"}" "$unique" "$n/$total"; then
            ((collided++)) || true
            continue
        fi

        local -i row_rc=0
        # shellcheck disable=SC2310 # returns an explicit _ROW_* code
        _download_asset "$api_key" "$account_dir" "$asset_id" "$unique" "$n/$total" \
            || row_rc=$?
        case "$row_rc" in
            "$_ROW_DOWNLOADED") ((downloaded++)) || true ;;
            "$_ROW_SKIPPED") ((skipped++)) || true ;;
            "$_ROW_REFUSED") ((refused++)) || true ;;
            *) ((failed++)) || true ;;
        esac
    done < "$asset_list"

    echo "    Done: $downloaded downloaded, $skipped skipped (already exist), $refused refused (unsafe/invalid input or dest already present), $collided collisions (duplicate id/dest), $failed failed (download/write errors)"
    ((failed == 0 && collided == 0))
}

# _clean_stale_temps ACCOUNT_DIR — remove leftover download temps from a
# previously aborted run only. Matches the mktemp prefix, never '*.tmp'
# (could be real exports). A failed cleanup only leaves stale temps behind,
# so it warns and never fails.
_clean_stale_temps() {
    local -r account_dir="$1"
    local stale_tmp
    stale_tmp=$(find "$account_dir" -maxdepth 1 -type f -name "$_IMMICH_EXPORT_TMP_GLOB" 2>/dev/null | wc -l)
    if [[ "$stale_tmp" -gt 0 ]]; then
        echo "    Cleaning up $stale_tmp leftover download temp(s) from previous run..."
        find "$account_dir" -maxdepth 1 -type f -name "$_IMMICH_EXPORT_TMP_GLOB" -delete \
            || echo "    WARN: could not remove all leftover download temps" >&2
    fi
}

# download_assets_for_account ACCOUNT API_KEY — discover, then download one
# account. main calls this under 'if !' (via _export_account), where bash
# ignores set -e for the whole call tree, so every step whose failure
# matters is checked explicitly and returns 1.
download_assets_for_account() {
    local account
    # shellcheck disable=SC2310 # pure validator: non-zero means invalid
    account=$(_safe_account_name "$1") \
        || die "Invalid account name: ${1@Q} (allowed: [A-Za-z0-9_-]+)"
    local api_key="$2"
    local account_dir="$DEST_DIR/$account"
    if ! mkdir -p "$account_dir"; then
        echo "    ERROR: cannot create account directory $account_dir" >&2
        return 1
    fi

    echo "==> Account: $account"

    # Collect full asset list into a temp file so we know the total upfront
    local asset_list
    if ! asset_list=$(mktemp); then
        echo "    ERROR: cannot create the asset list temp file" >&2
        return 1
    fi
    # Expand asset_list when the trap runs (still in this function scope).
    trap 'rm -f -- "$asset_list"' EXIT

    echo "    Phase 1: discovering assets..."
    # Checked explicitly (set -e is off under main's 'if !'). A partial list
    # is never downloaded: the account fails instead of exporting a subset.
    # shellcheck disable=SC2310 # discover_assets checks every step itself
    if ! discover_assets "$api_key" > "$asset_list"; then
        rm -f -- "$asset_list"
        trap - EXIT
        return 1
    fi
    echo "    Found $(wc -l < "$asset_list") images total"

    _clean_stale_temps "$account_dir"

    echo "    Phase 2: downloading..."
    local -i dl_rc=0
    set +e
    download_assets "$api_key" "$account_dir" "$asset_list"
    dl_rc=$?
    set -e

    rm -f -- "$asset_list"
    trap - EXIT
    return "$dl_rc"
}

# _export_account ACCOUNT — read the account's API key, then export it.
# The key is read in its own checked step: passed as "$(_account_api_key ...)"
# inside an 'if !' argument list, a die in $(...) only killed the subshell and
# the account ran with an empty key (401 -> 0 assets -> counted as success).
_export_account() {
    local -r account="$1"
    local api_key
    # Every failure in _account_api_key is an explicit die.
    # shellcheck disable=SC2310
    api_key=$(_account_api_key "$account") || return 1
    download_assets_for_account "$account" "$api_key"
}

# _parse_args ARGS... — apply the command line to the settings globals
# (DEST_DIR, DATE_AFTER, DATE_BEFORE, IMMICH_LAN_URL, IMMICH_PUBLIC_URL) and
# collect validated --account names in the documented global array
# _EXPORT_ACCOUNTS (reset here; main reads it). Dies on bad input; --help
# exits 0. A long but flat option loop, kept in one piece on purpose.
_parse_args() {
    _EXPORT_ACCOUNTS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest)
                [[ $# -ge 2 ]] || die "--dest requires a directory argument"
                DEST_DIR="$2"
                shift 2
                ;;
            --after)
                [[ $# -ge 2 ]] || die "--after requires a datetime argument"
                DATE_AFTER="$2"
                shift 2
                ;;
            --before)
                [[ $# -ge 2 ]] || die "--before requires a datetime argument"
                DATE_BEFORE="$2"
                shift 2
                ;;
            --account)
                [[ $# -ge 2 ]] || die "--account requires a name argument"
                local acct
                # shellcheck disable=SC2310 # pure validator
                acct=$(_safe_account_name "$2") \
                    || die "Invalid account name: ${2@Q} (allowed: [A-Za-z0-9_-]+)"
                _EXPORT_ACCOUNTS+=("$acct")
                shift 2
                ;;
            --lan-url)
                [[ $# -ge 2 ]] || die "--lan-url requires a URL argument"
                IMMICH_LAN_URL="$2"
                shift 2
                ;;
            --public-url)
                [[ $# -ge 2 ]] || die "--public-url requires a URL argument"
                IMMICH_PUBLIC_URL="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "Unknown option: $1 (try --help)"
                ;;
        esac
    done
}

main() {
    _parse_args "$@"
    local -a accounts=("${_EXPORT_ACCOUNTS[@]}")

    if ((${#accounts[@]} == 0)); then
        accounts=(paul albena)
    fi

    # Re-validate defaults too (defense in depth if defaults ever change).
    local account
    for account in "${accounts[@]}"; do
        # shellcheck disable=SC2310 # pure validator
        _safe_account_name "$account" >/dev/null \
            || die "Invalid account name: ${account@Q} (allowed: [A-Za-z0-9_-]+)"
    done

    detect_immich_url

    mkdir -p "$DEST_DIR"

    local -i account_failures=0
    for account in "${accounts[@]}"; do
        # set -e is off in this call tree; _export_account and
        # download_assets_for_account check each step explicitly instead.
        # shellcheck disable=SC2310
        if ! _export_account "$account"; then
            ((account_failures++)) || true
            echo "ERROR: export failed for account ${account@Q}" >&2
        fi
    done

    if ((account_failures > 0)); then
        die "Export finished with failures for $account_failures account(s) -> $DEST_DIR"
    fi

    echo ""
    echo "Export complete -> $DEST_DIR"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
