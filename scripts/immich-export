#!/usr/bin/env bash
# Export Immich assets for given accounts within a date range.
# Usage: immich-export [options]
#
# Options / env (CLI overrides env; env overrides defaults):
#   --dest DIR              Output root (IMMICH_EXPORT_DEST)
#   --after DATETIME        takenAfter exclusive (IMMICH_EXPORT_AFTER)
#   --before DATETIME       takenBefore exclusive (IMMICH_EXPORT_BEFORE)
#   --account NAME          Account to export (repeatable; default paul, albena).
#                           Key file: ~/.immich_<name>_key
#   --lan-url URL           LAN Immich base (IMMICH_LAN_URL)
#   --public-url URL        Public Immich base (IMMICH_PUBLIC_URL)
#   -h, --help              Show usage
#
# Works in two phases per account:
#   1. Discovery — paginate through all search results and collect asset IDs
#   2. Download  — fetch each asset with real [X/total] progress
#
# Exits non-zero if any download fails or same-run id/dest collisions occur.
# Path-unsafe names are refused (logged) without failing the whole run.

set -euo pipefail

# Defaults — overridable by env, then CLI in main().
IMMICH_LAN_URL="${IMMICH_LAN_URL:-http://immich.f3s.lan.buetow.org}"
IMMICH_PUBLIC_URL="${IMMICH_PUBLIC_URL:-https://immich.f3s.buetow.org}"
IMMICH_URL=""   # set by detect_immich_url()
DEST_DIR="${IMMICH_EXPORT_DEST:-/home/paul/Pictures/Pictures.Processing}"
# Immich treats takenAfter/takenBefore as exclusive boundaries.
DATE_AFTER="${IMMICH_EXPORT_AFTER:-2026-03-31T23:59:59.999Z}"
DATE_BEFORE="${IMMICH_EXPORT_BEFORE:-2026-07-01T00:00:00.000Z}"
PAGE_SIZE=100

# Curl max-time (seconds). Ping is short; search/download allow larger payloads.
readonly CURL_PING_TIMEOUT=5
readonly CURL_SEARCH_TIMEOUT=60
readonly CURL_DOWNLOAD_TIMEOUT=300

# Download temps live under the account dir with this mktemp template.
# Cleanup matches the glob only — never '*.tmp' (could wipe real exports).
readonly _IMMICH_EXPORT_TMP_TEMPLATE='.immich-export.XXXXXX'
readonly _IMMICH_EXPORT_TMP_GLOB='.immich-export.*'

die() { echo "ERROR: $1" >&2; exit 1; }

info() { echo "==> $1"; }

usage() {
    cat <<'EOF'
Usage: immich-export [options]

  --dest DIR           Output root (env: IMMICH_EXPORT_DEST)
  --after DATETIME     takenAfter exclusive (env: IMMICH_EXPORT_AFTER)
  --before DATETIME    takenBefore exclusive (env: IMMICH_EXPORT_BEFORE)
  --account NAME       Account to export; repeatable (default: paul albena).
                       Reads API key from ~/.immich_<NAME>_key
  --lan-url URL        LAN Immich base (env: IMMICH_LAN_URL)
  --public-url URL     Public Immich base (env: IMMICH_PUBLIC_URL)
  -h, --help           Show this help
EOF
}

# Probe the Immich /api/server/ping endpoint at the given base URL.
# Returns success only on HTTP 200 within a short timeout (follows redirects).
immich_reachable() {
    local url="$1"
    local code
    code=$(curl -sL -m "$CURL_PING_TIMEOUT" -o /dev/null -w '%{http_code}' \
        "$url/api/server/ping" 2>/dev/null) || return 1
    [[ "$code" == "200" ]]
}

# Pick the LAN URL if reachable, otherwise fall back to the public URL.
detect_immich_url() {
    if immich_reachable "$IMMICH_LAN_URL"; then
        IMMICH_URL="$IMMICH_LAN_URL"
        info "Using LAN ingress: $IMMICH_URL"
    elif immich_reachable "$IMMICH_PUBLIC_URL"; then
        IMMICH_URL="$IMMICH_PUBLIC_URL"
        info "LAN ingress unreachable, using public ingress: $IMMICH_URL"
    else
        die "Immich is not reachable via LAN ($IMMICH_LAN_URL) or public ($IMMICH_PUBLIC_URL)"
    fi
}

# _safe_export_filename RAW — print a single path component safe to join under
# an account export directory. Never join RAW onto DEST unchanged: Immich
# originalFileName is attacker-influenced and may contain ../ or absolute
# paths. Returns 1 if RAW is empty, absolute, has control chars, or resolves
# to "." / "..".
_safe_export_filename() {
    local -r raw="$1"
    local base

    [[ -n "$raw" ]] || return 1
    # Absolute paths are refused even though basename would strip the prefix.
    [[ "$raw" != /* ]] || return 1
    # Tab/newline would break discover's id<TAB>filename lines and IFS reads.
    case "$raw" in
        *$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
    esac

    base=$(basename -- "$raw")
    [[ -n "$base" ]] || return 1
    case "$base" in
        .|..) return 1 ;;
        *$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
    esac
    # basename should never leave a slash; keep the guard anyway.
    [[ "$base" != */* ]] || return 1

    printf '%s\n' "$base"
}

# _safe_asset_id RAW — accept an Immich asset id for use in export names.
# Allowlist standard UUID form only. That keeps {id}_{basename} injective:
# UUIDs contain no '_', so the id is always the fixed UUID prefix before the
# first '_' and cannot ambiguously recombine with basename segments
# (e.g. ab+c_d vs ab_c+d). Also refuse path/control characters.
_safe_asset_id() {
    local -r raw="$1"

    [[ -n "$raw" ]] || return 1
    # UUID: 8-4-4-4-12 hex (any version). No other shapes.
    [[ "$raw" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
        || return 1

    printf '%s\n' "$raw"
}

# _unique_export_basename ASSET_ID SAFE_BASENAME — local name that stays unique
# across distinct assets even when originalFileName (or its basename) collides.
# Layout: {uuid}_{sanitized_basename}. Injective because uuid has no '_'.
_unique_export_basename() {
    local -r asset_id="$1"
    local -r safe="$2"
    local id

    id=$(_safe_asset_id "$asset_id") || return 1
    [[ -n "$safe" ]] || return 1
    printf '%s_%s\n' "$id" "$safe"
}

# _path_is_under DIR CANDIDATE — succeed if CANDIDATE resolves under DIR.
# Uses physical paths so symlink escapes cannot pass the check.
_path_is_under() {
    local -r dir="$1"
    local -r candidate="$2"
    local dir_real cand_real cand_parent

    dir_real=$(cd -- "$dir" && pwd -P) || return 1
    if [[ -e "$candidate" || -L "$candidate" ]]; then
        cand_real=$(realpath -e -- "$candidate" 2>/dev/null) || return 1
    else
        cand_parent=$(cd -- "$(dirname -- "$candidate")" && pwd -P) || return 1
        cand_real="$cand_parent/$(basename -- "$candidate")"
    fi

    [[ "$cand_real" == "$dir_real" || "$cand_real" == "$dir_real"/* ]]
}

# Phase 1: paginate through all search results and print "id\tfilename" lines.
# The API's 'total' field only reflects the current page size, not the grand
# total, so we must walk all pages to know how many assets there are.
discover_assets() {
    local api_key="$1"
    local page=1

    while true; do
        local response
        response=$(curl -sf -m "$CURL_SEARCH_TIMEOUT" -X POST \
            "$IMMICH_URL/api/search/metadata" \
            -H "x-api-key: $api_key" \
            -H "Content-Type: application/json" \
            -d "{\"takenAfter\":\"$DATE_AFTER\",\"takenBefore\":\"$DATE_BEFORE\",\"type\":\"IMAGE\",\"size\":$PAGE_SIZE,\"page\":$page}")

        # Print id<TAB>filename for each asset on this page. Skip names that
        # contain tab/newline/CR — those would corrupt the TSV stream.
        echo "$response" | python3 -c "
import json, sys
d = json.load(sys.stdin)
for item in d['assets']['items']:
    name = item['originalFileName']
    if any(c in name for c in ('\t', '\n', '\r')):
        print(
            f\"discover: refusing unsafe originalFileName for {item['id']}: {name!r}\",
            file=sys.stderr,
        )
        continue
    print(item['id'] + '\t' + name)
"
        # Use 'or ""' to handle null nextPage — .get() returns None when the key
        # exists with a JSON null value, and print(None) would yield "None" (non-empty).
        local next_page
        next_page=$(echo "$response" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['assets'].get('nextPage') or '')")

        echo "    Discovery: page $page done..." >&2
        [[ -z "$next_page" ]] && break
        page="$next_page"
    done
}

# Phase 2: download each asset by ID, showing real [X/total] progress.
# Destinations are {uuid}_{sanitized_basename} so distinct assets that share
# originalFileName (or collapse to the same basename) all export. UUID
# allowlisting keeps that join injective. Returns non-zero on download
# failures or same-run duplicate asset id / destination collision.
download_assets() {
    local api_key="$1"
    local account_dir="$2"
    local asset_list="$3"   # path to temp file with "id\tfilename" lines
    local total
    total=$(wc -l < "$asset_list")
    local -i downloaded=0
    local -i skipped=0
    local -i refused=0
    local -i collided=0
    local -i failed=0
    local -i n=0
    declare -A run_seen_ids=()
    declare -A run_dest_owners=()

    while IFS=$'\t' read -r asset_id filename; do
        ((n++)) || true

        local safe
        if ! safe=$(_safe_export_filename "$filename"); then
            ((refused++)) || true
            echo "    [$n/$total] ERROR: refusing unsafe originalFileName: ${filename@Q}" >&2
            continue
        fi

        local unique
        if ! unique=$(_unique_export_basename "$asset_id" "$safe"); then
            ((refused++)) || true
            echo "    [$n/$total] ERROR: refusing unsafe asset id: ${asset_id@Q}" >&2
            continue
        fi

        local dest="$account_dir/$unique"
        if ! _path_is_under "$account_dir" "$dest"; then
            ((refused++)) || true
            echo "    [$n/$total] ERROR: dest escapes account dir: ${dest@Q}" >&2
            continue
        fi

        # Same asset id twice in one run (even with different basenames) is a
        # corrupt/duplicated discover stream — refuse clearly by id, not dest.
        if [[ -n "${run_seen_ids[$asset_id]+x}" ]]; then
            ((collided++)) || true
            echo "    [$n/$total] ERROR: duplicate asset id ${asset_id@Q} (earlier basename ${run_seen_ids[$asset_id]@Q}, this ${safe@Q})" >&2
            continue
        fi
        run_seen_ids[$asset_id]="$safe"

        # Defense in depth: final unique name should be unique once ids are.
        if [[ -n "${run_dest_owners[$unique]+x}" ]]; then
            ((collided++)) || true
            echo "    [$n/$total] ERROR: destination collision for ${unique@Q}: assets ${run_dest_owners[$unique]@Q} and ${asset_id@Q}" >&2
            continue
        fi
        run_dest_owners[$unique]="$asset_id"

        if [[ -e "$dest" || -L "$dest" ]]; then
            if [[ -f "$dest" && ! -L "$dest" ]]; then
                ((skipped++)) || true
                echo "    [$n/$total] skip (exists): $unique"
                continue
            fi
            ((refused++)) || true
            echo "    [$n/$total] ERROR: refusing non-regular dest: ${dest@Q}" >&2
            continue
        fi

        # Create a fresh regular file under account_dir (mktemp uses O_EXCL).
        # Never write to "$dest.tmp": curl -o follows a planted symlink and
        # can escape the account directory.
        local tmp
        if ! tmp=$(mktemp -p "$account_dir" "$_IMMICH_EXPORT_TMP_TEMPLATE"); then
            echo "    [$n/$total] ERROR: mktemp failed under $account_dir" >&2
            ((refused++)) || true
            continue
        fi
        if ! _path_is_under "$account_dir" "$tmp"; then
            rm -f -- "$tmp"
            ((refused++)) || true
            echo "    [$n/$total] ERROR: temp path escapes account dir: ${tmp@Q}" >&2
            continue
        fi

        if curl -sf -m "$CURL_DOWNLOAD_TIMEOUT" -o "$tmp" \
            -H "x-api-key: $api_key" \
            "$IMMICH_URL/api/assets/$asset_id/original"; then
            # Re-check dest before rename (TOCTOU / planted symlink).
            if [[ -e "$dest" || -L "$dest" ]]; then
                rm -f -- "$tmp"
                ((refused++)) || true
                echo "    [$n/$total] ERROR: dest appeared before rename: ${dest@Q}" >&2
                continue
            fi
            if ! mv -n -- "$tmp" "$dest"; then
                rm -f -- "$tmp"
                ((refused++)) || true
                echo "    [$n/$total] ERROR: failed to place $unique" >&2
                continue
            fi
            ((downloaded++)) || true
            echo "    [$n/$total] downloaded: $unique"
        else
            echo "    [$n/$total] ERROR: failed to download $asset_id ($unique)" >&2
            rm -f -- "$tmp"
            ((failed++)) || true
        fi
    done < "$asset_list"

    echo "    Done: $downloaded downloaded, $skipped skipped (already exist), $refused refused (unsafe/invalid input), $collided collisions (duplicate id/dest), $failed failed (download errors)"
    ((failed == 0 && collided == 0))
}

download_assets_for_account() {
    local account
    account=$(_safe_account_name "$1") \
        || die "Invalid account name: ${1@Q} (allowed: [A-Za-z0-9_-]+)"
    local api_key="$2"
    local account_dir="$DEST_DIR/$account"
    mkdir -p "$account_dir"

    echo "==> Account: $account"

    # Collect full asset list into a temp file so we know the total upfront
    local asset_list
    asset_list=$(mktemp)
    # Expand asset_list when the trap runs (still in this function scope).
    trap 'rm -f -- "$asset_list"' EXIT

    echo "    Phase 1: discovering assets..."
    discover_assets "$api_key" > "$asset_list"
    echo "    Found $(wc -l < "$asset_list") images total"

    # Clean leftover download temps from a previously aborted run only.
    # Match the mktemp prefix — never delete '*.tmp' (could be real exports).
    local stale_tmp
    stale_tmp=$(find "$account_dir" -maxdepth 1 -type f -name "$_IMMICH_EXPORT_TMP_GLOB" 2>/dev/null | wc -l)
    if [[ "$stale_tmp" -gt 0 ]]; then
        echo "    Cleaning up $stale_tmp leftover download temp(s) from previous run..."
        find "$account_dir" -maxdepth 1 -type f -name "$_IMMICH_EXPORT_TMP_GLOB" -delete
    fi

    echo "    Phase 2: downloading..."
    local -i dl_rc=0
    set +e
    download_assets "$api_key" "$account_dir" "$asset_list"
    dl_rc=$?
    set -e

    rm -f -- "$asset_list"
    trap - EXIT
    return "$dl_rc"
}

# _safe_account_name RAW — allowlist a single path-safe account label used under
# DEST_DIR and in ~/.immich_<name>_key. Reject path escape (../elsewhere),
# absolute paths, empty, and any character outside [A-Za-z0-9_-].
_safe_account_name() {
    local -r raw="$1"

    [[ -n "$raw" ]] || return 1
    [[ "$raw" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
    # Defense: allowlist already excludes '/', '.', but keep explicit bans.
    case "$raw" in
        .|..|*"/"*|*"\\"*) return 1 ;;
    esac

    printf '%s\n' "$raw"
}

# Load API key for an account name from ~/.immich_<name>_key.
_account_api_key() {
    local account
    account=$(_safe_account_name "$1") \
        || die "Invalid account name: ${1@Q} (allowed: [A-Za-z0-9_-]+)"
    local -r key_file="$HOME/.immich_${account}_key"

    [[ -f "$key_file" ]] || die "API key file not found: $key_file"
    local key
    key=$(cat -- "$key_file")
    [[ -n "$key" ]] || die "API key file is empty: $key_file"
    printf '%s\n' "$key"
}

main() {
    local -a accounts=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest)
                [[ $# -ge 2 ]] || die "--dest requires a directory argument"
                DEST_DIR="$2"
                shift 2
                ;;
            --after)
                [[ $# -ge 2 ]] || die "--after requires a datetime argument"
                DATE_AFTER="$2"
                shift 2
                ;;
            --before)
                [[ $# -ge 2 ]] || die "--before requires a datetime argument"
                DATE_BEFORE="$2"
                shift 2
                ;;
            --account)
                [[ $# -ge 2 ]] || die "--account requires a name argument"
                local acct
                acct=$(_safe_account_name "$2") \
                    || die "Invalid account name: ${2@Q} (allowed: [A-Za-z0-9_-]+)"
                accounts+=("$acct")
                shift 2
                ;;
            --lan-url)
                [[ $# -ge 2 ]] || die "--lan-url requires a URL argument"
                IMMICH_LAN_URL="$2"
                shift 2
                ;;
            --public-url)
                [[ $# -ge 2 ]] || die "--public-url requires a URL argument"
                IMMICH_PUBLIC_URL="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "Unknown option: $1 (try --help)"
                ;;
        esac
    done

    if ((${#accounts[@]} == 0)); then
        accounts=(paul albena)
    fi

    # Re-validate defaults too (defense in depth if defaults ever change).
    local account
    for account in "${accounts[@]}"; do
        _safe_account_name "$account" >/dev/null \
            || die "Invalid account name: ${account@Q} (allowed: [A-Za-z0-9_-]+)"
    done

    detect_immich_url

    mkdir -p "$DEST_DIR"

    local -i account_failures=0
    for account in "${accounts[@]}"; do
        if ! download_assets_for_account "$account" "$(_account_api_key "$account")"; then
            ((account_failures++)) || true
            echo "ERROR: export failed for account ${account@Q}" >&2
        fi
    done

    if ((account_failures > 0)); then
        die "Export finished with failures for $account_failures account(s) -> $DEST_DIR"
    fi

    echo ""
    echo "Export complete -> $DEST_DIR"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
