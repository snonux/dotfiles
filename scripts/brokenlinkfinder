#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'uri'
require 'set'

# True for http and https URIs (URI::HTTPS < URI::HTTP).
def http_uri?(uri)
  uri.is_a?(URI::HTTP)
end

# Resolve href against a page URL (root-relative, path-relative, protocol-relative, absolute).
# Returns nil when href is not a usable http(s) URI.
def resolve_url(base_url, href)
  uri = URI.join(base_url, href)
  return nil unless http_uri?(uri)

  uri.to_s
rescue URI::Error, ArgumentError
  nil
end

# True when url is http(s) and its host matches domain (case-insensitive).
def same_http_host?(url, domain)
  uri = URI(url)
  return false unless http_uri?(uri)
  return false if uri.host.nil? || domain.nil?

  uri.host.casecmp?(domain)
rescue URI::Error, ArgumentError
  false
end

# True when href resolves against base_url to an http(s) URL on domain.
# Classification happens after resolve so filter and check stay consistent
# (protocol-relative //evil.com is external; bare/../ relatives are internal).
def internal_link?(href, domain, base_url)
  resolved = resolve_url(base_url, href)
  return false if resolved.nil?

  same_http_host?(resolved, domain)
end

# Resolved http(s) same-host URLs that will be checked (deduplicated, order preserved).
def urls_to_check(base_url, domain, hrefs)
  hrefs.filter_map do |href|
    full = resolve_url(base_url, href)
    full if full && same_http_host?(full, domain)
  end.uniq
end

# Fetch and return HTML body for a successful response, else nil.
def fetch_html(url)
  response = Net::HTTP.get_response(URI(url))
  response.body if response.is_a?(Net::HTTPSuccess)
rescue StandardError => e
  puts "Error fetching #{url}: #{e.message}"
  nil
end

# Collect broken internal links found on the page at url.
# Always returns a Set (empty on fetch failure) so callers can iterate safely.
def check_links(url, domain)
  require 'nokogiri'

  html = fetch_html(url)
  return Set.new unless html

  checked = Set.new
  broken = Set.new

  document = Nokogiri::HTML(html)
  links = document.css('a').map { |link| link['href'] }.compact

  to_check = urls_to_check(url, domain, links)
  puts "Internal links: #{to_check}"

  to_check.each do |full_url|
    next if checked.include?(full_url)

    broken << full_url unless check_link(full_url)
    checked << full_url
  end

  broken
end

# True when url responds with HTTP success.
def check_link(url)
  uri = URI(url)
  response = Net::HTTP.get_response(uri)

  if response.is_a?(Net::HTTPSuccess)
    puts "Working link: #{url}"
    true
  else
    puts "Broken link: #{url} (HTTP #{response.code})"
    false
  end
rescue StandardError => e
  puts "Error checking #{url}: #{e.message}"
  false
end

if $PROGRAM_NAME == __FILE__
  if ARGV.length != 1
    puts 'Usage: ruby brokenlinkfinder.rb <URL>'
    exit
  end

  start_url = ARGV.first
  domain = URI(start_url).host

  check_links(start_url, domain).each do |broken|
    puts "Broken: #{broken}"
  end
end
