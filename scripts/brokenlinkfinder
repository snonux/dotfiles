#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'uri'
require 'set'

# Resolve href against a page URL (root-relative, ./, and absolute).
# Returns nil when href is not a usable URI.
def resolve_url(base_url, href)
  URI.join(base_url, href).to_s
rescue URI::InvalidURIError, ArgumentError
  nil
end

# True when href targets the same site (path-relative or matching host).
def internal_link?(href, domain)
  return true if href.start_with?('/') || href.start_with?('./')

  URI(href).host == domain
rescue URI::InvalidURIError, ArgumentError
  false
end

# Fetch and return HTML body for a successful response, else nil.
def fetch_html(url)
  response = Net::HTTP.get_response(URI(url))
  response.body if response.is_a?(Net::HTTPSuccess)
rescue StandardError => e
  puts "Error fetching #{url}: #{e.message}"
  nil
end

# Collect broken internal links found on the page at url.
def check_links(url, domain)
  require 'nokogiri'

  html = fetch_html(url)
  return unless html

  checked = Set.new
  broken = Set.new

  document = Nokogiri::HTML(html)
  links = document.css('a').map { |link| link['href'] }.compact

  internal_links = links.select { |link| internal_link?(link, domain) }
  puts "Internal links: #{internal_links}"

  internal_links.uniq.each do |link|
    full_url = resolve_url(url, link)
    next if full_url.nil? || checked.include?(full_url)

    broken << full_url unless check_link(full_url)
    checked << full_url
  end

  broken
end

# True when url responds with HTTP success.
def check_link(url)
  uri = URI(url)
  response = Net::HTTP.get_response(uri)

  if response.is_a?(Net::HTTPSuccess)
    puts "Working link: #{url}"
    true
  else
    puts "Broken link: #{url} (HTTP #{response.code})"
    false
  end
rescue StandardError => e
  puts "Error checking #{url}: #{e.message}"
  false
end

if $PROGRAM_NAME == __FILE__
  if ARGV.length != 1
    puts 'Usage: ruby brokenlinkfinder.rb <URL>'
    exit
  end

  start_url = ARGV.first
  domain = URI(start_url).host

  check_links(start_url, domain).each do |broken|
    puts "Broken: #{broken}"
  end
end
