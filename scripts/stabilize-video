#!/usr/bin/env bash
# Stabilize shaky Fujifilm X100V .MOV clips with ffmpeg's 2-pass vidstab
# filter and encode compact 4K HEVC .mp4 output on Intel VAAPI (software
# libx265 fallback when the GPU is unavailable).
#
# Usage:
#   stabilize-video [DIR]                 # stabilize all *.MOV in DIR
#   stabilize-video ~/Videos              # specify a directory
#   stabilize-video clip1.MOV clip2.MOV   # or pass explicit files
#   stabilize-video --delete-source ...   # also remove originals after OK
#
# Outputs are written next to each source as `stabilised-<base>.mp4`.
# Encode writes `stabilised-<base>.mp4.partial` first and renames only on
# success, so a mid-encode crash cannot leave a final path that forever
# skips retries. Skip-if-exists requires a decodable output; undecodable
# leftovers are discarded and retried.
#
# Sources are kept by default (POLA: stabilize must not destroy masters).
# Pass --delete-source to remove the original after decode-OK and a
# duration/size sanity check (ratios must be positive numbers; non-numeric,
# empty, N/A, or ≤0 durations fail closed — refuse delete).
#
# Delete policy:
#   • Fresh encode in this run: also require the ephemeral pass1 TRF path
#     still present (presence / defense-in-depth only — not content↔source
#     binding). Unique keys + _assert_unique_trfs prevent wrong-transform
#     collisions.
#   • Inspect-then-delete: if --delete-source and a decodable stabilised-*
#     already exists from a prior keep-default run, re-verify decode +
#     duration/size sanity and may rm the source without re-encoding.
#     The live TRF gate is skipped here — that TRF lived only in a prior
#     process's temp dir and cannot be required on a later cleanup pass.

set -euo pipefail

VADEVICE="${VADEVICE:-/dev/dri/renderD128}"
trf_dir=""              # set by main; cleaned up by EXIT trap
QUALITY="${QUALITY:-34}"          # HEVC CQP quality (higher = smaller)
SHAKINESS="${SHAKINESS:-5}"       # vidstab shakiness 1..10
ACCURACY="${ACCURACY:-15}"        # vidstab accuracy 1..15
UNSHARP="unsharp=5:5:0.8:3:3:0.4"
DELETE_SOURCE=no                  # yes only with --delete-source
# Refuse delete when out duration < this fraction of source duration.
DELETE_MIN_DUR_RATIO="${DELETE_MIN_DUR_RATIO:-0.5}"
# Refuse delete when out size < this fraction of source size.
DELETE_MIN_SIZE_RATIO="${DELETE_MIN_SIZE_RATIO:-0.01}"

# Display label (basename without .MOV). Not used for TRF identity.
_base() { basename "${1%.MOV}"; }

# Collision-free TRF stem: sha256 of the absolute source path. Basename
# alone is unsafe when the same clip name appears in different directories.
_trf_key() {
  local -r src="$1"
  local abs
  abs=$(realpath -m -- "$src")
  printf '%s' "$abs" | sha256sum | cut -d' ' -f1
}

_trf_for() {
  local -r src="$1"
  printf '%s/%s.trf' "$trf_dir" "$(_trf_key "$src")"
}

_outfor() {
  printf '%s/stabilised-%s.mp4' "$(dirname "$1")" "$(basename "${1%.MOV}")"
}

# Sidecar path for in-progress encodes (never a skip reason).
_partial_for() {
  printf '%s.partial' "$1"
}

# True when path exists and ffmpeg can decode it end-to-end.
_output_decodes() {
  local -r path="$1"
  [[ -f "$path" ]] || return 1
  ffmpeg -v error -i "$path" -f null - >/dev/null 2>&1
}

_vaapi_label() {
  if [[ "$_vaapi_ok" == yes ]]; then
    echo "vaapi hevc"
  else
    echo "software libx265"
  fi
}

# Detect whether VAAPI HEVC is usable on the configured device.
_detect_vaapi() {
  _vaapi_ok=no
  if [[ -c "$VADEVICE" ]] \
    && ffmpeg -hide_banner -vaapi_device "$VADEVICE" \
         -f lavfi -i color=black:s=320x240:d=0.1 \
         -vf 'format=nv12,hwupload' \
         -c:v hevc_vaapi -f null - 2>/dev/null; then
    _vaapi_ok=yes
  fi
}

# Collect the list of .MOV files to process into _mov_files.
_collect_mov_files() {
  _mov_files=()
  if [[ $# -gt 0 ]]; then
    for arg in "$@"; do
      if [[ -d "$arg" ]]; then
        while IFS= read -r -d '' f; do
          _mov_files+=("$f")
        done < <(find "$arg" -maxdepth 1 -type f -iname '*.MOV' -print0)
      elif [[ -f "$arg" ]]; then
        _mov_files+=("$arg")
      else
        echo "stabilize-video: not a file or directory: $arg" >&2
        return 1
      fi
    done
  else
    while IFS= read -r -d '' f; do
      _mov_files+=("$f")
    done < <(find . -maxdepth 1 -type f -iname '*.MOV' -print0)
  fi
}

# Pass 1: motion detection (all clips in parallel — CPU-bound, read-only).
_pass1() {
  local src="$1" trf="$2"
  ffmpeg -y -i "$src" \
    -vf "vidstabdetect=shakiness=${SHAKINESS}:accuracy=${ACCURACY}:result=${trf}" \
    -f null - 2>&1
}

# Pass 2: transform + sharpen + encode (serial — GPU is the bottleneck).
_pass2() {
  local src="$1" trf="$2" out="$3"
  local vf="vidstabtransform=input=${trf},${UNSHARP}"
  if [[ "$_vaapi_ok" == yes ]]; then
    ffmpeg -y -vaapi_device "$VADEVICE" -i "$src" \
      -map 0:v:0 -map '0:a:0?' \
      -vf "${vf},format=nv12,hwupload" \
      -c:v hevc_vaapi -rc_mode CQP -global_quality "$QUALITY" -tag:v hvc1 \
      -c:a aac -b:a 128k -movflags +faststart "$out" 2>&1
  else
    ffmpeg -y -i "$src" \
      -map 0:v:0 -map '0:a:0?' \
      -vf "$vf" \
      -c:v libx265 -preset medium -crf 28 -tag:v hvc1 \
      -c:a aac -b:a 128k -movflags +faststart "$out" 2>&1
  fi
}

# Abort if two sources would share a TRF path (ambiguous transform identity).
_assert_unique_trfs() {
  local -A trf_owners=()
  local src trf
  for src in "$@"; do
    trf=$(_trf_for "$src")
    if [[ -n "${trf_owners[$trf]:-}" ]]; then
      echo "stabilize-video: TRF key collision between" \
        "${trf_owners[$trf]} and $src — refusing to stabilize" >&2
      return 1
    fi
    trf_owners[$trf]="$src"
  done
}

# Probe media duration in seconds; empty + non-zero status on failure.
_probe_duration() {
  local -r path="$1"
  ffprobe -v error -show_entries format=duration \
    -of csv=p=0 "$path" 2>/dev/null
}

# True when $1 is a finite positive decimal (rejects empty, N/A, 0, signs).
_is_positive_number() {
  local -r v="$1"
  [[ "$v" =~ ^[0-9]+([.][0-9]+)?$|^[.][0-9]+$ ]] || return 1
  awk -v n="$v" 'BEGIN { exit !(n > 0) }'
}

# True when out looks sane vs src (duration + size) before deleting source.
# Fail closed: non-numeric / empty / N/A / ≤0 durations, or invalid/empty
# DELETE_MIN_*_RATIO env, must refuse delete (never treat as OK).
_delete_sanity_ok() {
  local -r src="$1" out="$2"
  local src_dur out_dur
  local -i src_bytes out_bytes
  local src_rc=0 out_rc=0

  if ! _is_positive_number "$DELETE_MIN_DUR_RATIO" \
    || ! _is_positive_number "$DELETE_MIN_SIZE_RATIO"; then
    echo "stabilize-video: sanity check failed (invalid" \
      "DELETE_MIN_DUR_RATIO='${DELETE_MIN_DUR_RATIO}' or" \
      "DELETE_MIN_SIZE_RATIO='${DELETE_MIN_SIZE_RATIO}')" \
      "for $src — keeping source" >&2
    return 1
  fi

  set +e
  src_dur=$(_probe_duration "$src")
  src_rc=$?
  out_dur=$(_probe_duration "$out")
  out_rc=$?
  set -e
  if ((src_rc != 0 || out_rc != 0)) \
    || ! _is_positive_number "$src_dur" \
    || ! _is_positive_number "$out_dur"; then
    echo "stabilize-video: sanity check failed (duration probe:" \
      "src=${src_dur:-<empty>} out=${out_dur:-<empty>})" \
      "for $src — keeping source" >&2
    return 1
  fi

  # awk: out_dur < src_dur * ratio → refuse (handles floats).
  if awk -v o="$out_dur" -v s="$src_dur" -v r="$DELETE_MIN_DUR_RATIO" \
    'BEGIN { exit !(o < s * r) }'; then
    echo "stabilize-video: sanity check failed (duration" \
      "${out_dur}s < ${DELETE_MIN_DUR_RATIO}× ${src_dur}s)" \
      "for $src — keeping source" >&2
    return 1
  fi

  src_bytes=$(stat -c '%s' -- "$src")
  out_bytes=$(stat -c '%s' -- "$out")
  if ((src_bytes > 0)) \
    && awk -v o="$out_bytes" -v s="$src_bytes" \
      -v r="$DELETE_MIN_SIZE_RATIO" \
      'BEGIN { exit !(o < s * r) }'; then
    echo "stabilize-video: sanity check failed (size" \
      "${out_bytes}B < ${DELETE_MIN_SIZE_RATIO}× ${src_bytes}B)" \
      "for $src — keeping source" >&2
    return 1
  fi
  return 0
}

# Strip flags; set DELETE_SOURCE; remaining paths go to _cli_paths.
_parse_cli() {
  DELETE_SOURCE=no
  _cli_paths=()
  local arg saw_dd=no
  for arg in "$@"; do
    if [[ "$saw_dd" == yes ]]; then
      _cli_paths+=("$arg")
      continue
    fi
    case "$arg" in
      --)
        saw_dd=yes
        ;;
      --delete-source)
        DELETE_SOURCE=yes
        ;;
      -h|--help)
        cat <<'EOF'
Usage: stabilize-video [--delete-source] [DIR|FILE ...]

Stabilize .MOV clips to stabilised-<base>.mp4 next to each source.
Sources are kept by default. Pass --delete-source to remove originals
after decode OK + duration/size sanity (fresh encodes also require the
live pass1 TRF). If a decodable output already exists, --delete-source
inspects it and may delete the source without re-encoding (no TRF gate).
EOF
        exit 0
        ;;
      -*)
        echo "stabilize-video: unknown option: $arg" >&2
        echo "Try 'stabilize-video --help' for usage." >&2
        return 1
        ;;
      *)
        _cli_paths+=("$arg")
        ;;
    esac
  done
}

main() {
  _parse_cli "$@" || exit 1
  _collect_mov_files "${_cli_paths[@]+"${_cli_paths[@]}"}" || exit 1

  if [[ ${#_mov_files[@]} -eq 0 ]]; then
    echo "stabilize-video: no .MOV files found" >&2
    exit 0
  fi

  _detect_vaapi

  echo "stabilize-video: ${#_mov_files[@]} clip(s) to process"
  echo "  device : $VADEVICE"
  echo "  quality: $QUALITY (vaapi: $_vaapi_ok)"
  echo "  delete : $DELETE_SOURCE"

  # Build the work list. Skip only decodable finals (unless
  # --delete-source → inspect-then-delete); drop stale partials and
  # undecodable leftovers so a failed prior run can retry.
  local -a todo=()
  local -a delete_only=()
  trf_dir=$(mktemp -d -t stabilize-video.XXXXXX)
  trap '[[ -n "$trf_dir" ]] && rm -rf "$trf_dir"' EXIT

  local src out partial
  for src in "${_mov_files[@]}"; do
    out=$(_outfor "$src")
    partial=$(_partial_for "$out")
    rm -f -- "$partial"
    if [[ -f "$out" ]]; then
      if _output_decodes "$out"; then
        if [[ "$DELETE_SOURCE" == yes && -f "$src" ]]; then
          echo "  inspect-then-delete: $out"
          delete_only+=("$src")
        else
          echo "  skip (exists): $out"
        fi
        continue
      fi
      echo "  discard (undecodable): $out"
      rm -f -- "$out"
    fi
    todo+=("$src")
  done

  if [[ ${#todo[@]} -eq 0 && ${#delete_only[@]} -eq 0 ]]; then
    echo "stabilize-video: nothing to do (all outputs present)" >&2
    exit 0
  fi

  local pids=() base trf
  local fail=0
  local pid
  local -i enc_rc
  local src_h out_h dur
  local -i verify_fail=0 probe_rc decode_rc

  if [[ ${#todo[@]} -gt 0 ]]; then
    _assert_unique_trfs "${todo[@]}" || exit 1

    # Pass 1 — parallel motion detection.
    echo ""
    echo "==> Pass 1: motion detection"
    for src in "${todo[@]}"; do
      base=$(_base "$src")
      trf=$(_trf_for "$src")
      echo "  [P1] $src"
      _pass1 "$src" "$trf" | sed "s/^/    [$base P1] /" &
      pids+=("$!")
    done
    for pid in "${pids[@]}"; do
      wait "$pid" || ((++fail))
    done
    if ((fail > 0)); then
      echo "stabilize-video: pass 1 failed for $fail clip(s)" >&2
      exit 1
    fi

    # Pass 2 — serial stabilize + encode to .partial, then atomic rename.
    echo ""
    echo "==> Pass 2: stabilize + encode ($(_vaapi_label))"
    for src in "${todo[@]}"; do
      base=$(_base "$src")
      trf=$(_trf_for "$src")
      out=$(_outfor "$src")
      partial=$(_partial_for "$out")
      echo "  [P2] $src -> $out"
      rm -f -- "$partial"
      set +e
      _pass2 "$src" "$trf" "$partial" \
        | tail -3 \
        | sed "s/^/    [$base P2] /"
      enc_rc=${PIPESTATUS[0]}
      set -e
      if ((enc_rc != 0)); then
        rm -f -- "$partial"
        echo "stabilize-video: pass 2 failed for $src" >&2
        exit 1
      fi
      mv -f -- "$partial" "$out"
    done

    # Verify fresh encodes decode cleanly; TRF presence gates delete.
    # Probe/decode failures must not abort under set -e before we discard
    # a bad final — otherwise junk remains and callers see false success.
    echo ""
    echo "==> Verify"
    for src in "${todo[@]}"; do
      base=$(_base "$src")
      out=$(_outfor "$src")
      trf=$(_trf_for "$src")
      src_h=$(du -h "$src" | cut -f1)
      out_h=$(du -h "$out" | cut -f1)
      set +e
      dur=$(_probe_duration "$out")
      probe_rc=$?
      ffmpeg -v error -i "$out" -f null - >/dev/null 2>&1
      decode_rc=$?
      set -e
      if ((probe_rc != 0 || decode_rc != 0)); then
        printf '  %-28s %s -> %s  DECODE ERROR\n' \
          "$base" "$src_h" "$out_h" >&2
        rm -f -- "$out"
        ((++verify_fail))
        continue
      fi
      if [[ ! -f "$trf" ]]; then
        # Presence check only (defense-in-depth): TRF path gone after a
        # decode-OK output — do not claim content↔source binding here.
        printf '  %-28s %s -> %s  (%ss, decode OK; missing TRF — keeping source)\n' \
          "$base" "$src_h" "$out_h" "$dur" >&2
        continue
      fi
      printf '  %-28s %s -> %s  (%ss, decode OK)\n' \
        "$base" "$src_h" "$out_h" "$dur"
      if [[ "$DELETE_SOURCE" != yes ]]; then
        echo "    keeping source (default; pass --delete-source to remove)"
        continue
      fi
      if ! _delete_sanity_ok "$src" "$out"; then
        continue
      fi
      rm -f -- "$src"
      echo "    deleted source: $src"
    done
  fi

  # Inspect-then-delete: prior keep-default left a good out + source.
  # No live TRF from this run — require decode + duration/size only.
  if [[ ${#delete_only[@]} -gt 0 ]]; then
    echo ""
    echo "==> Inspect-then-delete (existing output, --delete-source)"
    for src in "${delete_only[@]}"; do
      base=$(_base "$src")
      out=$(_outfor "$src")
      if [[ ! -f "$src" ]]; then
        echo "  skip (source already gone): $src"
        continue
      fi
      src_h=$(du -h "$src" | cut -f1)
      out_h=$(du -h "$out" | cut -f1)
      set +e
      dur=$(_probe_duration "$out")
      probe_rc=$?
      ffmpeg -v error -i "$out" -f null - >/dev/null 2>&1
      decode_rc=$?
      set -e
      if ((probe_rc != 0 || decode_rc != 0)); then
        printf '  %-28s %s -> %s  DECODE ERROR — keeping source\n' \
          "$base" "$src_h" "$out_h" >&2
        # Do not rm a previously skip-worthy final here; only refuse delete.
        ((++verify_fail))
        continue
      fi
      printf '  %-28s %s -> %s  (%ss, decode OK; no TRF gate)\n' \
        "$base" "$src_h" "$out_h" "$dur"
      if ! _delete_sanity_ok "$src" "$out"; then
        continue
      fi
      rm -f -- "$src"
      echo "    deleted source: $src"
    done
  fi

  echo ""
  if ((verify_fail > 0)); then
    echo "stabilize-video: verify failed for $verify_fail clip(s)" >&2
    exit 1
  fi
  echo "stabilize-video: done"
}

# Allow unit-testing helpers without running main when sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
