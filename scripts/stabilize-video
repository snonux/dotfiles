#!/usr/bin/env bash
# Stabilize shaky Fujifilm X100V .MOV clips with ffmpeg's 2-pass vidstab
# filter and encode compact 4K HEVC .mp4 output on Intel VAAPI (software
# libx265 fallback when the GPU is unavailable).
#
# Usage:
#   stabilize-video [DIR]                 # stabilize all *.MOV in DIR
#   stabilize-video ~/Videos              # specify a directory
#   stabilize-video clip1.MOV clip2.MOV   # or pass explicit files
#
# Outputs are written next to each source as `stabilised-<base>.mp4`.
# Encode writes `stabilised-<base>.mp4.partial` first and renames only on
# success, so a mid-encode crash cannot leave a final path that forever
# skips retries. Skip-if-exists requires a decodable output; undecodable
# leftovers are discarded and retried.
# On successful stabilization (output decodes OK and the per-source TRF
# file is still present) the original .MOV is deleted.
#
# Missing-TRF refuse-delete is presence / defense-in-depth only: it checks
# that the expected TRF path still exists before rm, not that TRF contents
# bind to the source (content-identity). Unique keys + _assert_unique_trfs
# are what prevent wrong-transform collisions.

set -euo pipefail

VADEVICE="${VADEVICE:-/dev/dri/renderD128}"
trf_dir=""              # set by main; cleaned up by EXIT trap
QUALITY="${QUALITY:-34}"          # HEVC CQP quality (higher = smaller)
SHAKINESS="${SHAKINESS:-5}"       # vidstab shakiness 1..10
ACCURACY="${ACCURACY:-15}"        # vidstab accuracy 1..15
UNSHARP="unsharp=5:5:0.8:3:3:0.4"

# Display label (basename without .MOV). Not used for TRF identity.
_base() { basename "${1%.MOV}"; }

# Collision-free TRF stem: sha256 of the absolute source path. Basename
# alone is unsafe when the same clip name appears in different directories.
_trf_key() {
  local -r src="$1"
  local abs
  abs=$(realpath -m -- "$src")
  printf '%s' "$abs" | sha256sum | cut -d' ' -f1
}

_trf_for() {
  local -r src="$1"
  printf '%s/%s.trf' "$trf_dir" "$(_trf_key "$src")"
}

_outfor() {
  printf '%s/stabilised-%s.mp4' "$(dirname "$1")" "$(basename "${1%.MOV}")"
}

# Sidecar path for in-progress encodes (never a skip reason).
_partial_for() {
  printf '%s.partial' "$1"
}

# True when path exists and ffmpeg can decode it end-to-end.
_output_decodes() {
  local -r path="$1"
  [[ -f "$path" ]] || return 1
  ffmpeg -v error -i "$path" -f null - >/dev/null 2>&1
}

_vaapi_label() {
  if [[ "$_vaapi_ok" == yes ]]; then
    echo "vaapi hevc"
  else
    echo "software libx265"
  fi
}

# Detect whether VAAPI HEVC is usable on the configured device.
_detect_vaapi() {
  _vaapi_ok=no
  if [[ -c "$VADEVICE" ]] \
    && ffmpeg -hide_banner -vaapi_device "$VADEVICE" \
         -f lavfi -i color=black:s=320x240:d=0.1 \
         -vf 'format=nv12,hwupload' \
         -c:v hevc_vaapi -f null - 2>/dev/null; then
    _vaapi_ok=yes
  fi
}

# Collect the list of .MOV files to process into _mov_files.
_collect_mov_files() {
  _mov_files=()
  if [[ $# -gt 0 ]]; then
    for arg in "$@"; do
      if [[ -d "$arg" ]]; then
        while IFS= read -r -d '' f; do
          _mov_files+=("$f")
        done < <(find "$arg" -maxdepth 1 -type f -iname '*.MOV' -print0)
      elif [[ -f "$arg" ]]; then
        _mov_files+=("$arg")
      else
        echo "stabilize-video: not a file or directory: $arg" >&2
        return 1
      fi
    done
  else
    while IFS= read -r -d '' f; do
      _mov_files+=("$f")
    done < <(find . -maxdepth 1 -type f -iname '*.MOV' -print0)
  fi
}

# Pass 1: motion detection (all clips in parallel — CPU-bound, read-only).
_pass1() {
  local src="$1" trf="$2"
  ffmpeg -y -i "$src" \
    -vf "vidstabdetect=shakiness=${SHAKINESS}:accuracy=${ACCURACY}:result=${trf}" \
    -f null - 2>&1
}

# Pass 2: transform + sharpen + encode (serial — GPU is the bottleneck).
_pass2() {
  local src="$1" trf="$2" out="$3"
  local vf="vidstabtransform=input=${trf},${UNSHARP}"
  if [[ "$_vaapi_ok" == yes ]]; then
    ffmpeg -y -vaapi_device "$VADEVICE" -i "$src" \
      -map 0:v:0 -map '0:a:0?' \
      -vf "${vf},format=nv12,hwupload" \
      -c:v hevc_vaapi -rc_mode CQP -global_quality "$QUALITY" -tag:v hvc1 \
      -c:a aac -b:a 128k -movflags +faststart "$out" 2>&1
  else
    ffmpeg -y -i "$src" \
      -map 0:v:0 -map '0:a:0?' \
      -vf "$vf" \
      -c:v libx265 -preset medium -crf 28 -tag:v hvc1 \
      -c:a aac -b:a 128k -movflags +faststart "$out" 2>&1
  fi
}

# Abort if two sources would share a TRF path (ambiguous transform identity).
_assert_unique_trfs() {
  local -A trf_owners=()
  local src trf
  for src in "$@"; do
    trf=$(_trf_for "$src")
    if [[ -n "${trf_owners[$trf]:-}" ]]; then
      echo "stabilize-video: TRF key collision between" \
        "${trf_owners[$trf]} and $src — refusing to stabilize" >&2
      return 1
    fi
    trf_owners[$trf]="$src"
  done
}

main() {
  _collect_mov_files "$@" || exit 1

  if [[ ${#_mov_files[@]} -eq 0 ]]; then
    echo "stabilize-video: no .MOV files found" >&2
    exit 0
  fi

  _detect_vaapi

  echo "stabilize-video: ${#_mov_files[@]} clip(s) to process"
  echo "  device : $VADEVICE"
  echo "  quality: $QUALITY (vaapi: $_vaapi_ok)"

  # Build the work list. Skip only decodable finals; drop stale partials
  # and undecodable leftovers so a failed prior run can retry.
  local -a todo=()
  trf_dir=$(mktemp -d -t stabilize-video.XXXXXX)
  trap '[[ -n "$trf_dir" ]] && rm -rf "$trf_dir"' EXIT

  local src out partial
  for src in "${_mov_files[@]}"; do
    out=$(_outfor "$src")
    partial=$(_partial_for "$out")
    rm -f -- "$partial"
    if [[ -f "$out" ]]; then
      if _output_decodes "$out"; then
        echo "  skip (exists): $out"
        continue
      fi
      echo "  discard (undecodable): $out"
      rm -f -- "$out"
    fi
    todo+=("$src")
  done

  if [[ ${#todo[@]} -eq 0 ]]; then
    echo "stabilize-video: nothing to do (all outputs present)" >&2
    exit 0
  fi

  _assert_unique_trfs "${todo[@]}" || exit 1

  # Pass 1 — parallel motion detection.
  echo ""
  echo "==> Pass 1: motion detection"
  local pids=() base trf
  for src in "${todo[@]}"; do
    base=$(_base "$src")
    trf=$(_trf_for "$src")
    echo "  [P1] $src"
    _pass1 "$src" "$trf" | sed "s/^/    [$base P1] /" &
    pids+=("$!")
  done
  local fail=0
  local pid
  for pid in "${pids[@]}"; do
    wait "$pid" || ((++fail))
  done
  if ((fail > 0)); then
    echo "stabilize-video: pass 1 failed for $fail clip(s)" >&2
    exit 1
  fi

  # Pass 2 — serial stabilize + encode to .partial, then atomic rename.
  echo ""
  echo "==> Pass 2: stabilize + encode ($(_vaapi_label))"
  local -i enc_rc
  for src in "${todo[@]}"; do
    base=$(_base "$src")
    trf=$(_trf_for "$src")
    out=$(_outfor "$src")
    partial=$(_partial_for "$out")
    echo "  [P2] $src -> $out"
    rm -f -- "$partial"
    set +e
    _pass2 "$src" "$trf" "$partial" \
      | tail -3 \
      | sed "s/^/    [$base P2] /"
    enc_rc=${PIPESTATUS[0]}
    set -e
    if ((enc_rc != 0)); then
      rm -f -- "$partial"
      echo "stabilize-video: pass 2 failed for $src" >&2
      exit 1
    fi
    mv -f -- "$partial" "$out"
  done

  # Verify outputs decode cleanly and report size reduction.
  # Probe/decode failures must not abort under set -e before we discard a
  # bad final — otherwise junk remains and callers see a false success.
  echo ""
  echo "==> Verify"
  local src_h out_h dur
  local -i verify_fail=0 probe_rc decode_rc
  for src in "${todo[@]}"; do
    base=$(_base "$src")
    out=$(_outfor "$src")
    trf=$(_trf_for "$src")
    src_h=$(du -h "$src" | cut -f1)
    out_h=$(du -h "$out" | cut -f1)
    set +e
    dur=$(ffprobe -v error -show_entries format=duration \
      -of csv=p=0 "$out" 2>/dev/null)
    probe_rc=$?
    ffmpeg -v error -i "$out" -f null - >/dev/null 2>&1
    decode_rc=$?
    set -e
    if ((probe_rc != 0 || decode_rc != 0)); then
      printf '  %-28s %s -> %s  DECODE ERROR\n' "$base" "$src_h" "$out_h" >&2
      rm -f -- "$out"
      ((++verify_fail))
      continue
    fi
    if [[ ! -f "$trf" ]]; then
      # Presence check only (defense-in-depth): TRF path gone after a
      # decode-OK output — do not claim content↔source binding here.
      printf '  %-28s %s -> %s  (%ss, decode OK; missing TRF — keeping source)\n' \
        "$base" "$src_h" "$out_h" "$dur" >&2
      continue
    fi
    printf '  %-28s %s -> %s  (%ss, decode OK)\n' \
      "$base" "$src_h" "$out_h" "$dur"
    rm -f -- "$src"
    echo "    deleted source: $src"
  done

  echo ""
  if ((verify_fail > 0)); then
    echo "stabilize-video: verify failed for $verify_fail clip(s)" >&2
    exit 1
  fi
  echo "stabilize-video: done"
}

# Allow unit-testing helpers without running main when sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
