#!/usr/bin/env bash
# Exercise stabilize-video without real ffmpeg / GPU work.
#
# Covers the c33 failure mode: same basename in different directories must
# not share a .trf (wrong stabilize → wrong transform). Also covers paths
# with spaces, main/CLI same-realpath collision abort, missing-TRF
# refuse-delete (presence / defense-in-depth — not content-identity),
# d33: mid-encode failure must not leave a final output that forever skips
# retries (atomic .partial + verify-before-skip), and p33: keep sources by
# default; delete only with --delete-source after duration/size sanity.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
script="$repo/scripts/stabilize-video"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT

mkdir -p "$sandbox/bin" "$sandbox/a" "$sandbox/b" \
  "$sandbox/dir with spaces" "$sandbox/real"

# --- fake ffmpeg / ffprobe -------------------------------------------------
# Records which TRF each source used in pass 1/2 so the harness can assert
# identity. VAAPI probe fails so the script takes the software encode path.
#
# STAB_FAKE_RM_TRF_AFTER_PASS2=1 — after a successful pass 2, delete the
# TRF that was just consumed so main's verify sees decode-OK + missing TRF.
# STAB_FAKE_FAIL_PASS2=1 — write a corrupt partial then exit 1 (mid-encode).
# STAB_FAKE_PASS2_BAD_FINAL=1 — pass 2 exits 0 but writes undecodable bytes
# (verify-time DECODE ERROR path after successful rename).
# STAB_FAKE_FFPROBE_FAIL=1 — ffprobe exits 1 (verify must still rm bad out).
# STAB_FAKE_SRC_DURATION / STAB_FAKE_OUT_DURATION — ffprobe duration values
# (defaults 1.23) for delete-source sanity checks.

cat > "$sandbox/bin/ffmpeg" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
log="${STAB_FAKE_LOG:-/dev/null}"

# VAAPI capability probe — always fail so software path is used.
for arg in "$@"; do
  if [[ "$arg" == -vaapi_device || "$arg" == hevc_vaapi ]]; then
    exit 1
  fi
done

src=""
out=""
vf=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -i) src=$arg ;;
    -vf) vf=$arg ;;
  esac
  prev=$arg
done
# Output file is the final argument when not -f null.
out=${*: -1}
if [[ "$out" == - ]]; then
  out=""
fi

# Pass 1: vidstabdetect → write a TRF that records the source path.
if [[ "$vf" == *vidstabdetect=* ]]; then
  trf=${vf#*result=}
  trf=${trf%%,*}
  trf=${trf%%:*}
  printf 'TRF_FOR=%s\n' "$src" > "$trf"
  printf 'pass1\t%s\t%s\n' "$src" "$trf" >> "$log"
  exit 0
fi

# Decode-verify: ffmpeg -v error -i "$path" -f null -
# Only files with OUT_FOR= count as decodable (successful encode marker).
# (Pass 1 also ends in -f null -, but is handled above via vidstabdetect.)
if [[ "$*" == *' -f null -'* || "$*" == *'-f null -' ]]; then
  if [[ -n "$src" && -f "$src" ]] && grep -q '^OUT_FOR=' "$src" 2>/dev/null; then
    exit 0
  fi
  exit 1
fi

# Pass 2: vidstabtransform → write output embedding which TRF was applied.
if [[ "$vf" == *vidstabtransform=* ]]; then
  trf=${vf#*input=}
  trf=${trf%%,*}
  trf=${trf%%:*}
  if [[ ! -f "$trf" ]]; then
    echo "fake-ffmpeg: missing trf $trf for $src" >&2
    exit 1
  fi
  # Mid-encode crash: leave corrupt bytes at the encode target (.partial).
  if [[ "${STAB_FAKE_FAIL_PASS2:-}" == 1 ]]; then
    printf 'CORRUPT_PARTIAL\n' > "$out"
    printf 'pass2fail\t%s\t%s\t%s\n' "$src" "$trf" "$out" >> "$log"
    exit 1
  fi
  # Pass 2 "succeeds" but final is undecodable (no OUT_FOR= marker).
  if [[ "${STAB_FAKE_PASS2_BAD_FINAL:-}" == 1 ]]; then
    printf 'CORRUPT_FINAL\n' > "$out"
    printf 'pass2bad\t%s\t%s\t%s\n' "$src" "$trf" "$out" >> "$log"
    exit 0
  fi
  {
    echo "OUT_FOR=$src"
    echo "USED_TRF=$trf"
    cat "$trf"
  } > "$out"
  printf 'pass2\t%s\t%s\t%s\n' "$src" "$trf" "$out" >> "$log"
  # Simulate TRF vanishing after encode so verify must refuse delete.
  if [[ "${STAB_FAKE_RM_TRF_AFTER_PASS2:-}" == 1 ]]; then
    rm -f -- "$trf"
  fi
  exit 0
fi

echo "fake-ffmpeg: unhandled argv: $*" >&2
exit 1
EOF

cat > "$sandbox/bin/ffprobe" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${STAB_FAKE_FFPROBE_FAIL:-}" == 1 ]]; then
  exit 1
fi
path=${*: -1}
# Encoded outputs carry OUT_FOR=; sources do not.
if [[ -f "$path" ]] && grep -q '^OUT_FOR=' "$path" 2>/dev/null; then
  echo "${STAB_FAKE_OUT_DURATION:-1.23}"
else
  echo "${STAB_FAKE_SRC_DURATION:-1.23}"
fi
EOF

chmod +x "$sandbox/bin/ffmpeg" "$sandbox/bin/ffprobe"
export PATH="$sandbox/bin:$PATH"
export VADEVICE="/dev/null"   # force non-char-device → skip VAAPI probe early
export STAB_FAKE_LOG="$sandbox/ffmpeg.log"
: > "$STAB_FAKE_LOG"

assert_eq() {
  local -r label=$1 want=$2 got=$3
  if [[ "$want" != "$got" ]]; then
    printf 'FAIL %s: want %q got %q\n' "$label" "$want" "$got" >&2
    exit 1
  fi
  printf 'ok: %s\n' "$label"
}

# --- unit: TRF keys are unique for same basename, different dirs ----------
# shellcheck source=scripts/stabilize-video
source "$script"

key_a=$(_trf_key "$sandbox/a/clip.MOV")
key_b=$(_trf_key "$sandbox/b/clip.MOV")
key_sp=$(_trf_key "$sandbox/dir with spaces/clip.MOV")

if [[ "$key_a" == "$key_b" ]]; then
  echo "FAIL: TRF keys collided for a/clip.MOV and b/clip.MOV" >&2
  exit 1
fi
if [[ "$key_a" == "$key_sp" || "$key_b" == "$key_sp" ]]; then
  echo "FAIL: TRF key collided with spaces-path clip" >&2
  exit 1
fi
printf 'ok: distinct TRF keys for same basename in different dirs\n'

# Same absolute path → same key (stability).
key_a2=$(_trf_key "$sandbox/a/clip.MOV")
assert_eq "stable key for same path" "$key_a" "$key_a2"

# --- negative: collision guard refuses ambiguous TRF identity -------------
trf_dir="$sandbox/trf-collision"
mkdir -p "$trf_dir"
# Override _trf_for to the OLD basename-only scheme — must abort.
_trf_for() {
  local -r src=$1
  printf '%s/%s.trf' "$trf_dir" "$(basename "${src%.MOV}")"
}
touch "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV"
if _assert_unique_trfs "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV" 2>"$sandbox/collision.err"
then
  echo "FAIL: expected collision abort for basename-only TRF keys" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/collision.err"
printf 'ok: negative — basename collision aborts before stabilize\n'

# Restore real _trf_for from the script (re-source helpers).
# shellcheck source=scripts/stabilize-video
source "$script"
trf_dir="$sandbox/trf-ok"
mkdir -p "$trf_dir"
_assert_unique_trfs "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV"
printf 'ok: hash-based keys pass uniqueness guard\n'

# --- e2e: full run with colliding basenames + spaces path -----------------
printf 'mov-a\n' > "$sandbox/a/clip.MOV"
printf 'mov-b\n' > "$sandbox/b/clip.MOV"
printf 'mov-sp\n' > "$sandbox/dir with spaces/clip.MOV"

"$script" \
  "$sandbox/a/clip.MOV" \
  "$sandbox/b/clip.MOV" \
  "$sandbox/dir with spaces/clip.MOV" \
  >"$sandbox/run.out" 2>"$sandbox/run.err" || {
    echo "FAIL: stabilize-video exited $?" >&2
    cat "$sandbox/run.out" "$sandbox/run.err" >&2
    exit 1
  }

for dir in a b "dir with spaces"; do
  out="$sandbox/$dir/stabilised-clip.mp4"
  [[ -f "$out" ]] || {
    echo "FAIL: missing output $out" >&2
    exit 1
  }
  used_trf=$(grep '^USED_TRF=' "$out" | cut -d= -f2-)
  trf_for=$(grep '^TRF_FOR=' "$out" | cut -d= -f2-)
  out_for=$(grep '^OUT_FOR=' "$out" | cut -d= -f2-)
  expected_src="$sandbox/$dir/clip.MOV"
  # p33: default keeps masters even after decode-OK + TRF present.
  if [[ ! -f "$expected_src" ]]; then
    echo "FAIL: source deleted by default (want keep): $expected_src" >&2
    exit 1
  fi
  assert_eq "$dir OUT_FOR" "$expected_src" "$out_for"
  assert_eq "$dir TRF_FOR matches source" "$expected_src" "$trf_for"
  [[ -n "$used_trf" ]] || {
    echo "FAIL: empty USED_TRF in $out" >&2
    exit 1
  }
  printf 'ok: e2e correct TRF + keep-default for %s\n' "$dir"
done
grep -q 'keeping source (default' "$sandbox/run.out" \
  || grep -q 'keeping source (default' "$sandbox/run.err" || {
  echo "FAIL: expected keeping-source default message" >&2
  cat "$sandbox/run.out" "$sandbox/run.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/run.out" "$sandbox/run.err"; then
  echo "FAIL: default run reported source delete" >&2
  exit 1
fi
printf 'ok: e2e default run keeps sources (p33)\n'

# Distinct TRF paths actually used in the fake log (tab-separated).
mapfile -t trf_paths < <(awk -F'\t' '$1=="pass1"{print $3}' "$STAB_FAKE_LOG" | sort -u)
if ((${#trf_paths[@]} != 3)); then
  echo "FAIL: expected 3 distinct pass1 TRF paths, got ${#trf_paths[@]}" >&2
  printf '  %s\n' "${trf_paths[@]}" >&2
  exit 1
fi
printf 'ok: e2e used 3 distinct TRF files for 3 same-basename clips\n'

# --- p33: --delete-source removes originals after decode-OK + TRF --------
mkdir -p "$sandbox/del"
printf 'del-src\n' > "$sandbox/del/clip.MOV"
rm -f -- "$sandbox/del/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/del/clip.MOV" \
  >"$sandbox/del.out" 2>"$sandbox/del.err" || {
  echo "FAIL: --delete-source run exited $?" >&2
  cat "$sandbox/del.out" "$sandbox/del.err" >&2
  exit 1
}
if [[ -e "$sandbox/del/clip.MOV" ]]; then
  echo "FAIL: --delete-source left source in place" >&2
  cat "$sandbox/del.out" "$sandbox/del.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/del/stabilised-clip.mp4" ]]; then
  echo "FAIL: --delete-source missing stabilized output" >&2
  exit 1
fi
grep -q 'deleted source:' "$sandbox/del.out" \
  || grep -q 'deleted source:' "$sandbox/del.err" || {
  echo "FAIL: expected deleted-source message with --delete-source" >&2
  cat "$sandbox/del.out" "$sandbox/del.err" >&2
  exit 1
}
printf 'ok: --delete-source removes original after success\n'

# --- p33 negative: unknown option aborts before work --------------------
printf 'opt-src\n' > "$sandbox/del/clip.MOV"
rm -f -- "$sandbox/del/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
set +e
"$script" --not-a-real-flag "$sandbox/del/clip.MOV" \
  >"$sandbox/badopt.out" 2>"$sandbox/badopt.err"
badopt_rc=$?
set -e
if ((badopt_rc == 0)); then
  echo "FAIL: unknown option should exit non-zero" >&2
  exit 1
fi
grep -q 'unknown option' "$sandbox/badopt.err" || {
  echo "FAIL: missing unknown-option message" >&2
  cat "$sandbox/badopt.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/del/clip.MOV" ]]; then
  echo "FAIL: unknown-option run deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/del/stabilised-clip.mp4" ]]; then
  echo "FAIL: unknown-option run wrote output" >&2
  exit 1
fi
printf 'ok: negative — unknown option aborts, source kept\n'

# --- main/CLI: same-realpath collision abort (duplicate args) -------------
# Exercises _assert_unique_trfs through main. Removing that call from main
# must make this test fail (stabilize would proceed and delete the source).
printf 'dup-src\n' > "$sandbox/real/clip.MOV"
: > "$STAB_FAKE_LOG"
set +e
"$script" "$sandbox/real/clip.MOV" "$sandbox/real/clip.MOV" \
  >"$sandbox/dup.out" 2>"$sandbox/dup.err"
dup_rc=$?
set -e
if ((dup_rc == 0)); then
  echo "FAIL: expected non-zero exit for duplicate-arg same realpath" >&2
  cat "$sandbox/dup.out" "$sandbox/dup.err" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/dup.err" || {
  echo "FAIL: missing collision message on duplicate args" >&2
  cat "$sandbox/dup.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/real/clip.MOV" ]]; then
  echo "FAIL: duplicate-arg run deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/real/stabilised-clip.mp4" ]]; then
  echo "FAIL: duplicate-arg run wrote output before abort" >&2
  exit 1
fi
printf 'ok: main/CLI — duplicate args abort, source kept\n'

# --- main/CLI: same-realpath collision abort (two symlinks) ---------------
ln -sfn "$sandbox/real/clip.MOV" "$sandbox/a/via-a.MOV"
ln -sfn "$sandbox/real/clip.MOV" "$sandbox/b/via-b.MOV"
: > "$STAB_FAKE_LOG"
set +e
"$script" "$sandbox/a/via-a.MOV" "$sandbox/b/via-b.MOV" \
  >"$sandbox/sym.out" 2>"$sandbox/sym.err"
sym_rc=$?
set -e
if ((sym_rc == 0)); then
  echo "FAIL: expected non-zero exit for symlink same-realpath pair" >&2
  cat "$sandbox/sym.out" "$sandbox/sym.err" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/sym.err" || {
  echo "FAIL: missing collision message on symlink pair" >&2
  cat "$sandbox/sym.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/real/clip.MOV" ]]; then
  echo "FAIL: symlink-pair run deleted real source" >&2
  exit 1
fi
if [[ ! -L "$sandbox/a/via-a.MOV" || ! -L "$sandbox/b/via-b.MOV" ]]; then
  echo "FAIL: symlink-pair run removed symlink args" >&2
  exit 1
fi
if [[ -e "$sandbox/a/stabilised-via-a.mp4" || -e "$sandbox/b/stabilised-via-b.mp4" ]]; then
  echo "FAIL: symlink-pair run wrote output before abort" >&2
  exit 1
fi
printf 'ok: main/CLI — symlink same-realpath abort, sources kept\n'

# --- main: missing TRF after decode-OK keeps source (presence check) ------
# Drive full main: fake ffmpeg encodes OK then removes the TRF so verify
# sees decode-OK + absent expected TRF path. This is a presence /
# defense-in-depth guard — not a content-identity binding test.
# Removing the keep-source branch in main must make this fail (source rm'd).
rm -f -- "$sandbox/a/stabilised-clip.mp4"
printf 'keep-me\n' > "$sandbox/a/clip.MOV"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_RM_TRF_AFTER_PASS2=1
set +e
"$script" "$sandbox/a/clip.MOV" \
  >"$sandbox/miss.out" 2>"$sandbox/miss.err"
miss_rc=$?
set -e
unset STAB_FAKE_RM_TRF_AFTER_PASS2
if ((miss_rc != 0)); then
  echo "FAIL: missing-TRF run exited $miss_rc (expected 0)" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/a/clip.MOV" ]]; then
  echo "FAIL: source deleted despite missing TRF after decode-OK" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/a/stabilised-clip.mp4" ]]; then
  echo "FAIL: missing stabilized output for missing-TRF case" >&2
  exit 1
fi
grep -q 'missing TRF — keeping source' "$sandbox/miss.err" \
  || grep -q 'missing TRF — keeping source' "$sandbox/miss.out" || {
  echo "FAIL: expected keeping-source message for missing TRF" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/miss.out" "$sandbox/miss.err"; then
  echo "FAIL: reported source delete when TRF was missing" >&2
  exit 1
fi
printf 'ok: main — missing TRF after decode-OK keeps source (presence)\n'

# Same presence guard must refuse delete even with --delete-source.
rm -f -- "$sandbox/a/stabilised-clip.mp4"
printf 'keep-me-flag\n' > "$sandbox/a/clip.MOV"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_RM_TRF_AFTER_PASS2=1
set +e
"$script" --delete-source "$sandbox/a/clip.MOV" \
  >"$sandbox/miss2.out" 2>"$sandbox/miss2.err"
miss2_rc=$?
set -e
unset STAB_FAKE_RM_TRF_AFTER_PASS2
if ((miss2_rc != 0)); then
  echo "FAIL: missing-TRF + --delete-source exited $miss2_rc" >&2
  cat "$sandbox/miss2.out" "$sandbox/miss2.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/a/clip.MOV" ]]; then
  echo "FAIL: --delete-source deleted source despite missing TRF" >&2
  exit 1
fi
grep -q 'missing TRF — keeping source' "$sandbox/miss2.err" \
  || grep -q 'missing TRF — keeping source' "$sandbox/miss2.out" || {
  echo "FAIL: expected keeping-source message for missing TRF + flag" >&2
  cat "$sandbox/miss2.out" "$sandbox/miss2.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/miss2.out" "$sandbox/miss2.err"; then
  echo "FAIL: --delete-source reported delete when TRF missing" >&2
  exit 1
fi
printf 'ok: negative — missing TRF refuses --delete-source\n'

# --- d33: mid-encode fail must not leave a final skip-forever output ------
mkdir -p "$sandbox/fail"
printf 'fail-src\n' > "$sandbox/fail/clip.MOV"
rm -f -- "$sandbox/fail/stabilised-clip.mp4" \
  "$sandbox/fail/stabilised-clip.mp4.partial"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_FAIL_PASS2=1
set +e
"$script" "$sandbox/fail/clip.MOV" \
  >"$sandbox/fail.out" 2>"$sandbox/fail.err"
fail_rc=$?
set -e
unset STAB_FAKE_FAIL_PASS2
if ((fail_rc == 0)); then
  echo "FAIL: expected non-zero exit when pass 2 fails" >&2
  cat "$sandbox/fail.out" "$sandbox/fail.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/fail/clip.MOV" ]]; then
  echo "FAIL: pass2-fail run deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/fail/stabilised-clip.mp4" ]]; then
  echo "FAIL: pass2-fail left final output (would skip forever)" >&2
  exit 1
fi
if [[ -e "$sandbox/fail/stabilised-clip.mp4.partial" ]]; then
  echo "FAIL: pass2-fail left .partial behind" >&2
  exit 1
fi
grep -q 'pass 2 failed' "$sandbox/fail.err" || {
  echo "FAIL: missing pass-2-failed message" >&2
  cat "$sandbox/fail.err" >&2
  exit 1
}
printf 'ok: negative — mid-encode fail leaves no final/partial\n'

# Retry after failure must succeed (not permanently skipped); keep source.
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/fail/clip.MOV" \
  >"$sandbox/retry.out" 2>"$sandbox/retry.err" || {
  echo "FAIL: retry after pass2-fail exited $?" >&2
  cat "$sandbox/retry.out" "$sandbox/retry.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/fail/clip.MOV" ]]; then
  echo "FAIL: retry deleted source by default (want keep)" >&2
  exit 1
fi
if [[ ! -f "$sandbox/fail/stabilised-clip.mp4" ]]; then
  echo "FAIL: retry did not produce final output" >&2
  exit 1
fi
if [[ -e "$sandbox/fail/stabilised-clip.mp4.partial" ]]; then
  echo "FAIL: retry left .partial behind" >&2
  exit 1
fi
grep -q '^OUT_FOR=' "$sandbox/fail/stabilised-clip.mp4"
printf 'ok: retry after mid-encode fail succeeds (source kept)\n'

# --- d33: undecodable leftover is discarded and retried (not skipped) -----
mkdir -p "$sandbox/corrupt"
printf 'corrupt-src\n' > "$sandbox/corrupt/clip.MOV"
# Simulate a prior -y truncate / crash that left a final path.
printf 'CORRUPT_LEFTOVER\n' > "$sandbox/corrupt/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/corrupt/clip.MOV" \
  >"$sandbox/corrupt.out" 2>"$sandbox/corrupt.err" || {
  echo "FAIL: undecodable-leftover run exited $?" >&2
  cat "$sandbox/corrupt.out" "$sandbox/corrupt.err" >&2
  exit 1
}
grep -q 'discard (undecodable)' "$sandbox/corrupt.out" \
  || grep -q 'discard (undecodable)' "$sandbox/corrupt.err" || {
  echo "FAIL: expected discard message for undecodable leftover" >&2
  cat "$sandbox/corrupt.out" "$sandbox/corrupt.err" >&2
  exit 1
}
if grep -q 'skip (exists)' "$sandbox/corrupt.out" "$sandbox/corrupt.err"; then
  echo "FAIL: skipped undecodable leftover instead of retrying" >&2
  exit 1
fi
if [[ ! -f "$sandbox/corrupt/clip.MOV" ]]; then
  echo "FAIL: re-stabilize deleted source by default (want keep)" >&2
  exit 1
fi
grep -q '^OUT_FOR=' "$sandbox/corrupt/stabilised-clip.mp4" || {
  echo "FAIL: re-stabilize did not rewrite undecodable leftover" >&2
  exit 1
}
printf 'ok: negative — undecodable leftover discarded and retried\n'

# --- d33: verify-time undecodable after pass2 success (DECODE ERROR) ------
# pass2 exits 0 and renames .partial → final, but final is undecodable.
# Verify must DECODE ERROR, rm the final (this assertion fails if that rm
# is deleted), exit non-zero, keep source, and allow a clean retry.
mkdir -p "$sandbox/badfinal"
printf 'badfinal-src\n' > "$sandbox/badfinal/clip.MOV"
rm -f -- "$sandbox/badfinal/stabilised-clip.mp4" \
  "$sandbox/badfinal/stabilised-clip.mp4.partial"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_PASS2_BAD_FINAL=1
set +e
"$script" "$sandbox/badfinal/clip.MOV" \
  >"$sandbox/badfinal.out" 2>"$sandbox/badfinal.err"
badfinal_rc=$?
set -e
unset STAB_FAKE_PASS2_BAD_FINAL
if ((badfinal_rc == 0)); then
  echo "FAIL: expected non-zero exit on verify-time DECODE ERROR" >&2
  cat "$sandbox/badfinal.out" "$sandbox/badfinal.err" >&2
  exit 1
fi
grep -q 'DECODE ERROR' "$sandbox/badfinal.err" \
  || grep -q 'DECODE ERROR' "$sandbox/badfinal.out" || {
  echo "FAIL: missing DECODE ERROR message for bad final" >&2
  cat "$sandbox/badfinal.out" "$sandbox/badfinal.err" >&2
  exit 1
}
grep -q 'verify failed' "$sandbox/badfinal.err" || {
  echo "FAIL: missing verify-failed summary on bad final" >&2
  cat "$sandbox/badfinal.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/badfinal/clip.MOV" ]]; then
  echo "FAIL: verify DECODE ERROR deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/badfinal/stabilised-clip.mp4" ]]; then
  echo "FAIL: verify DECODE ERROR left final (rm missing?)" >&2
  exit 1
fi
if [[ -e "$sandbox/badfinal/stabilised-clip.mp4.partial" ]]; then
  echo "FAIL: verify DECODE ERROR left .partial behind" >&2
  exit 1
fi
printf 'ok: negative — verify-time bad final DECODE ERROR + rm + exit 1\n'

: > "$STAB_FAKE_LOG"
"$script" "$sandbox/badfinal/clip.MOV" \
  >"$sandbox/badfinal-retry.out" 2>"$sandbox/badfinal-retry.err" || {
  echo "FAIL: retry after verify DECODE ERROR exited $?" >&2
  cat "$sandbox/badfinal-retry.out" "$sandbox/badfinal-retry.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/badfinal/clip.MOV" ]]; then
  echo "FAIL: retry after DECODE ERROR deleted source by default" >&2
  exit 1
fi
grep -q '^OUT_FOR=' "$sandbox/badfinal/stabilised-clip.mp4" || {
  echo "FAIL: retry after DECODE ERROR did not rewrite final" >&2
  exit 1
}
printf 'ok: retry after verify-time DECODE ERROR succeeds (source kept)\n'

# --- d33: ffprobe failure at verify still discards final ------------------
# Isolates set -e + ffprobe: decode may succeed (OUT_FOR present) but
# ffprobe exits 1 — must still DECODE ERROR, rm final, exit non-zero.
mkdir -p "$sandbox/probefail"
printf 'probe-src\n' > "$sandbox/probefail/clip.MOV"
rm -f -- "$sandbox/probefail/stabilised-clip.mp4" \
  "$sandbox/probefail/stabilised-clip.mp4.partial"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_FFPROBE_FAIL=1
set +e
"$script" "$sandbox/probefail/clip.MOV" \
  >"$sandbox/probefail.out" 2>"$sandbox/probefail.err"
probefail_rc=$?
set -e
unset STAB_FAKE_FFPROBE_FAIL
if ((probefail_rc == 0)); then
  echo "FAIL: expected non-zero exit when ffprobe fails at verify" >&2
  cat "$sandbox/probefail.out" "$sandbox/probefail.err" >&2
  exit 1
fi
grep -q 'DECODE ERROR' "$sandbox/probefail.err" \
  || grep -q 'DECODE ERROR' "$sandbox/probefail.out" || {
  echo "FAIL: missing DECODE ERROR when ffprobe fails" >&2
  cat "$sandbox/probefail.out" "$sandbox/probefail.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/probefail/clip.MOV" ]]; then
  echo "FAIL: ffprobe-fail verify deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/probefail/stabilised-clip.mp4" ]]; then
  echo "FAIL: ffprobe-fail left final (set -e skipped rm?)" >&2
  exit 1
fi
printf 'ok: negative — ffprobe fail at verify discards final + exit 1\n'

# --- d33: decodable existing output still skips ---------------------------
printf 'should-not-touch\n' > "$sandbox/corrupt/clip.MOV"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/corrupt/clip.MOV" \
  >"$sandbox/skip.out" 2>"$sandbox/skip.err" || {
  echo "FAIL: skip-existing run exited $?" >&2
  cat "$sandbox/skip.out" "$sandbox/skip.err" >&2
  exit 1
}
grep -q 'skip (exists)' "$sandbox/skip.out" \
  || grep -q 'skip (exists)' "$sandbox/skip.err" || {
  echo "FAIL: expected skip for decodable existing output" >&2
  cat "$sandbox/skip.out" "$sandbox/skip.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/corrupt/clip.MOV" ]]; then
  echo "FAIL: skip run deleted source" >&2
  exit 1
fi
if grep -q $'^pass2\t' "$STAB_FAKE_LOG"; then
  echo "FAIL: skip run still encoded" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
printf 'ok: decodable existing output still skipped\n'

# --- p33 negative: --delete-source refuses short-duration output ----------
mkdir -p "$sandbox/shortdur"
printf 'short-src\n' > "$sandbox/shortdur/clip.MOV"
rm -f -- "$sandbox/shortdur/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_SRC_DURATION=10
export STAB_FAKE_OUT_DURATION=1
set +e
"$script" --delete-source "$sandbox/shortdur/clip.MOV" \
  >"$sandbox/shortdur.out" 2>"$sandbox/shortdur.err"
shortdur_rc=$?
set -e
unset STAB_FAKE_SRC_DURATION STAB_FAKE_OUT_DURATION
if ((shortdur_rc != 0)); then
  echo "FAIL: short-duration run exited $shortdur_rc (want 0 + keep)" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/shortdur/clip.MOV" ]]; then
  echo "FAIL: short-duration sanity deleted source" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
fi
grep -q 'sanity check failed (duration' "$sandbox/shortdur.err" \
  || grep -q 'sanity check failed (duration' "$sandbox/shortdur.out" || {
  echo "FAIL: expected duration sanity-failure message" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/shortdur.out" "$sandbox/shortdur.err"
then
  echo "FAIL: reported delete after duration sanity failure" >&2
  exit 1
fi
printf 'ok: negative — duration sanity blocks --delete-source\n'

# --- p33 negative: --delete-source refuses tiny output vs large source ----
mkdir -p "$sandbox/tinysize"
# Large source so out_bytes < DELETE_MIN_SIZE_RATIO * src_bytes.
dd if=/dev/zero of="$sandbox/tinysize/clip.MOV" bs=1024 count=100 status=none
rm -f -- "$sandbox/tinysize/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/tinysize/clip.MOV" \
  >"$sandbox/tinysize.out" 2>"$sandbox/tinysize.err" || {
  echo "FAIL: tiny-size run exited $?" >&2
  cat "$sandbox/tinysize.out" "$sandbox/tinysize.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/tinysize/clip.MOV" ]]; then
  echo "FAIL: tiny-size sanity deleted source" >&2
  cat "$sandbox/tinysize.out" "$sandbox/tinysize.err" >&2
  exit 1
fi
grep -q 'sanity check failed (size' "$sandbox/tinysize.err" \
  || grep -q 'sanity check failed (size' "$sandbox/tinysize.out" || {
  echo "FAIL: expected size sanity-failure message" >&2
  cat "$sandbox/tinysize.out" "$sandbox/tinysize.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/tinysize.out" "$sandbox/tinysize.err"
then
  echo "FAIL: reported delete after size sanity failure" >&2
  exit 1
fi
printf 'ok: negative — size sanity blocks --delete-source\n'

# --- unit: _partial_for / _output_decodes / _parse_cli --------------------
# shellcheck source=scripts/stabilize-video
source "$script"
partial_path=$(_partial_for "$sandbox/corrupt/stabilised-clip.mp4")
assert_eq "_partial_for suffix" \
  "$sandbox/corrupt/stabilised-clip.mp4.partial" "$partial_path"
if ! _output_decodes "$sandbox/corrupt/stabilised-clip.mp4"; then
  echo "FAIL: _output_decodes rejected known-good encode marker" >&2
  exit 1
fi
printf 'junk\n' > "$sandbox/unit-bad.mp4"
if _output_decodes "$sandbox/unit-bad.mp4"; then
  echo "FAIL: _output_decodes accepted undecodable junk" >&2
  exit 1
fi
if _output_decodes "$sandbox/does-not-exist.mp4"; then
  echo "FAIL: _output_decodes accepted missing path" >&2
  exit 1
fi
_parse_cli --delete-source "$sandbox/a/clip.MOV"
assert_eq "DELETE_SOURCE after --delete-source" yes "$DELETE_SOURCE"
assert_eq "_cli_paths[0]" "$sandbox/a/clip.MOV" "${_cli_paths[0]}"
_parse_cli "$sandbox/b/clip.MOV"
assert_eq "DELETE_SOURCE default" no "$DELETE_SOURCE"
printf 'ok: unit — _partial_for + _output_decodes + _parse_cli\n'

# --- syntax / shellcheck --------------------------------------------------
bash -n "$script"
bash -n "$repo/scripts/stabilize-video-e2e"
shellcheck -x "$script"
shellcheck -x "$repo/scripts/stabilize-video-e2e"
printf 'ok: bash -n + shellcheck\n'

echo ""
echo "stabilize-video-e2e: all checks passed"
