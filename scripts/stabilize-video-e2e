  >"$sandbox/shortdur.out" 2>"$sandbox/shortdur.err"
shortdur_rc=$?
set -e
unset STAB_FAKE_SRC_DURATION STAB_FAKE_OUT_DURATION
if ((shortdur_rc != 0)); then
  echo "FAIL: short-duration run exited $shortdur_rc (want 0 + keep)" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/shortdur/clip.MOV" ]]; then
  echo "FAIL: short-duration sanity deleted source" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
fi
grep -q 'sanity check failed (duration' "$sandbox/shortdur.err" \
  || grep -q 'sanity check failed (duration' "$sandbox/shortdur.out" || {
  echo "FAIL: expected duration sanity-failure message" >&2
  cat "$sandbox/shortdur.out" "$sandbox/shortdur.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/shortdur.out" "$sandbox/shortdur.err"
then
  echo "FAIL: reported delete after duration sanity failure" >&2
  exit 1
fi
printf 'ok: negative — duration sanity blocks --delete-source\n'

# --- p33 negative: --delete-source refuses tiny output vs large source ----
mkdir -p "$sandbox/tinysize"
# Large source so out_bytes < DELETE_MIN_SIZE_RATIO * src_bytes.
dd if=/dev/zero of="$sandbox/tinysize/clip.MOV" bs=1024 count=100 status=none
rm -f -- "$sandbox/tinysize/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/tinysize/clip.MOV" \
  >"$sandbox/tinysize.out" 2>"$sandbox/tinysize.err" || {
