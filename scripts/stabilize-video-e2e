  echo "FAIL: tiny-size sanity deleted source" >&2
  cat "$sandbox/tinysize.out" "$sandbox/tinysize.err" >&2
  exit 1
fi
grep -q 'sanity check failed (size' "$sandbox/tinysize.err" \
  || grep -q 'sanity check failed (size' "$sandbox/tinysize.out" || {
  echo "FAIL: expected size sanity-failure message" >&2
  cat "$sandbox/tinysize.out" "$sandbox/tinysize.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/tinysize.out" "$sandbox/tinysize.err"
then
  echo "FAIL: reported delete after size sanity failure" >&2
  exit 1
fi
printf 'ok: negative — size sanity blocks --delete-source\n'

# --- p33 negative: non-numeric / N/A / zero / empty duration refuse -------
# Fail closed: awk would treat N/A as 0 and previously allow delete.
_refuse_bad_duration() {
  local -r label=$1 src_dur=$2 out_dur=$3
  local dir="$sandbox/baddur-$label"
  mkdir -p "$dir"
  printf 'baddur-%s\n' "$label" > "$dir/clip.MOV"
  rm -f -- "$dir/stabilised-clip.mp4"
  : > "$STAB_FAKE_LOG"
  export STAB_FAKE_SRC_DURATION="$src_dur"
  export STAB_FAKE_OUT_DURATION="$out_dur"
  set +e
  "$script" --delete-source "$dir/clip.MOV" \
    >"$dir/run.out" 2>"$dir/run.err"
  local rc=$?
  set -e
  unset STAB_FAKE_SRC_DURATION STAB_FAKE_OUT_DURATION
  if ((rc != 0)); then
    echo "FAIL: bad-duration ($label) exited $rc (want 0 + keep)" >&2
    cat "$dir/run.out" "$dir/run.err" >&2
    exit 1
  fi
  if [[ ! -f "$dir/clip.MOV" ]]; then
    echo "FAIL: bad-duration ($label) deleted source" >&2
    cat "$dir/run.out" "$dir/run.err" >&2
    exit 1
  fi
  grep -q 'sanity check failed (duration' "$dir/run.err" \
    || grep -q 'sanity check failed (duration' "$dir/run.out" || {
    echo "FAIL: bad-duration ($label) missing sanity message" >&2
    cat "$dir/run.out" "$dir/run.err" >&2
    exit 1
  }
  if grep -q 'deleted source:' "$dir/run.out" "$dir/run.err"; then
    echo "FAIL: bad-duration ($label) reported delete" >&2
    exit 1
  fi
  printf 'ok: negative — duration %s refuses --delete-source\n' "$label"
}
_refuse_bad_duration na-out 10 N/A
_refuse_bad_duration na-src N/A 10
_refuse_bad_duration zero-out 10 0
_refuse_bad_duration zero-src 0 10
_refuse_bad_duration empty-out 10 ''
_refuse_bad_duration empty-src '' 10
_refuse_bad_duration junk-out 10 not-a-number

# Invalid / empty DELETE_MIN_*_RATIO must also fail closed.
mkdir -p "$sandbox/badratio"
printf 'badratio-src\n' > "$sandbox/badratio/clip.MOV"
rm -f -- "$sandbox/badratio/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
export DELETE_MIN_DUR_RATIO=bogus
set +e
"$script" --delete-source "$sandbox/badratio/clip.MOV" \
  >"$sandbox/badratio.out" 2>"$sandbox/badratio.err"
badratio_rc=$?
set -e
unset DELETE_MIN_DUR_RATIO
# Restore defaults used by the script when sourced later.
DELETE_MIN_DUR_RATIO=0.5
DELETE_MIN_SIZE_RATIO=0.01
if ((badratio_rc != 0)); then
  echo "FAIL: bad-ratio run exited $badratio_rc (want 0 + keep)" >&2
  cat "$sandbox/badratio.out" "$sandbox/badratio.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/badratio/clip.MOV" ]]; then
  echo "FAIL: bad-ratio deleted source" >&2
  exit 1
fi
grep -q 'invalid' "$sandbox/badratio.err" \
  || grep -q 'invalid' "$sandbox/badratio.out" || {
  echo "FAIL: expected invalid-ratio sanity message" >&2
  cat "$sandbox/badratio.out" "$sandbox/badratio.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/badratio.out" "$sandbox/badratio.err"
then
  echo "FAIL: reported delete with invalid DELETE_MIN_DUR_RATIO" >&2
  exit 1
fi
printf 'ok: negative — invalid DELETE_MIN_DUR_RATIO refuses delete\n'

# Invalid DELETE_MIN_SIZE_RATIO must also fail closed.
mkdir -p "$sandbox/badsizeratio"
printf 'badsizeratio-src\n' > "$sandbox/badsizeratio/clip.MOV"
rm -f -- "$sandbox/badsizeratio/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
export DELETE_MIN_SIZE_RATIO=bogus
set +e
"$script" --delete-source "$sandbox/badsizeratio/clip.MOV" \
  >"$sandbox/badsizeratio.out" 2>"$sandbox/badsizeratio.err"
badsizeratio_rc=$?
set -e
unset DELETE_MIN_SIZE_RATIO
DELETE_MIN_SIZE_RATIO=0.01
if ((badsizeratio_rc != 0)); then
  echo "FAIL: bad-size-ratio run exited $badsizeratio_rc (want 0 + keep)" >&2
  cat "$sandbox/badsizeratio.out" "$sandbox/badsizeratio.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/badsizeratio/clip.MOV" ]]; then
  echo "FAIL: bad-size-ratio deleted source" >&2
  exit 1
fi
grep -q 'invalid' "$sandbox/badsizeratio.err" \
  || grep -q 'invalid' "$sandbox/badsizeratio.out" || {
  echo "FAIL: expected invalid-size-ratio sanity message" >&2
  cat "$sandbox/badsizeratio.out" "$sandbox/badsizeratio.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/badsizeratio.out" \
  "$sandbox/badsizeratio.err"; then
  echo "FAIL: reported delete with invalid DELETE_MIN_SIZE_RATIO" >&2
  exit 1
fi
printf 'ok: negative — invalid DELETE_MIN_SIZE_RATIO refuses delete\n'

# --- p33: keep-default then --delete-source cleans source (no re-encode) -
mkdir -p "$sandbox/keepdel"
printf 'keepdel-src\n' > "$sandbox/keepdel/clip.MOV"
rm -f -- "$sandbox/keepdel/stabilised-clip.mp4" \
  "$sandbox/keepdel/stabilised-clip.mp4.srcid"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/keepdel/clip.MOV" \
  >"$sandbox/keepdel1.out" 2>"$sandbox/keepdel1.err" || {
  echo "FAIL: keep-default prelude exited $?" >&2
  cat "$sandbox/keepdel1.out" "$sandbox/keepdel1.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/keepdel/clip.MOV" ]]; then
  echo "FAIL: keep-default prelude deleted source" >&2
  exit 1
fi
if [[ ! -f "$sandbox/keepdel/stabilised-clip.mp4" ]]; then
  echo "FAIL: keep-default prelude missing output" >&2
  exit 1
fi
if [[ ! -f "$sandbox/keepdel/stabilised-clip.mp4.srcid" ]]; then
  echo "FAIL: keep-default prelude missing .srcid sidecar" >&2
  exit 1
fi
# Out is newer than source after encode; .srcid matches — no touch needed.
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/keepdel/clip.MOV" \
  >"$sandbox/keepdel2.out" 2>"$sandbox/keepdel2.err" || {
  echo "FAIL: keep-then-delete exited $?" >&2
  cat "$sandbox/keepdel2.out" "$sandbox/keepdel2.err" >&2
  exit 1
}
grep -q 'inspect-then-delete' "$sandbox/keepdel2.out" \
  || grep -q 'inspect-then-delete' "$sandbox/keepdel2.err" || {
  echo "FAIL: expected inspect-then-delete path" >&2
  cat "$sandbox/keepdel2.out" "$sandbox/keepdel2.err" >&2
  exit 1
}
if grep -q $'^pass1\t' "$STAB_FAKE_LOG" || grep -q $'^pass2\t' "$STAB_FAKE_LOG"
then
  echo "FAIL: keep-then-delete re-encoded instead of inspect-only" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
if [[ -e "$sandbox/keepdel/clip.MOV" ]]; then
  echo "FAIL: keep-then-delete left source in place" >&2
  cat "$sandbox/keepdel2.out" "$sandbox/keepdel2.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/keepdel/stabilised-clip.mp4" ]]; then
  echo "FAIL: keep-then-delete removed stabilized output" >&2
  exit 1
fi
grep -q 'deleted source:' "$sandbox/keepdel2.out" \
  || grep -q 'deleted source:' "$sandbox/keepdel2.err" || {
  echo "FAIL: expected deleted-source message on inspect-then-delete" >&2
  cat "$sandbox/keepdel2.out" "$sandbox/keepdel2.err" >&2
  exit 1
}
printf 'ok: keep-then --delete-source cleans source without re-encode\n'

# --- p33: keep-default → replace newer source → --delete-source re-encodes
# If the master is replaced after a keep run, inspect-then-delete must NOT
# rm the new source against a stale stabilised-*.mp4 (mtime guard → todo).
mkdir -p "$sandbox/staleout"
printf 'staleout-old\n' > "$sandbox/staleout/clip.MOV"
rm -f -- "$sandbox/staleout/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/staleout/clip.MOV" \
  >"$sandbox/staleout1.out" 2>"$sandbox/staleout1.err" || {
  echo "FAIL: staleout keep-default exited $?" >&2
  cat "$sandbox/staleout1.out" "$sandbox/staleout1.err" >&2
  exit 1
}
[[ -f "$sandbox/staleout/stabilised-clip.mp4" ]] || {
  echo "FAIL: staleout keep-default missing output" >&2
  exit 1
}
old_out_for=$(grep '^OUT_FOR=' "$sandbox/staleout/stabilised-clip.mp4" | cut -d= -f2-)
# Pin out older than the replaced source (second-resolution mtime).
out_m=$(stat -c '%Y' -- "$sandbox/staleout/stabilised-clip.mp4")
touch -d "@$out_m" -- "$sandbox/staleout/stabilised-clip.mp4"
printf 'staleout-NEW-footage\n' > "$sandbox/staleout/clip.MOV"
touch -d "@$((out_m + 60))" -- "$sandbox/staleout/clip.MOV"
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/staleout/clip.MOV" \
  >"$sandbox/staleout2.out" 2>"$sandbox/staleout2.err" || {
  echo "FAIL: staleout --delete-source exited $?" >&2
  cat "$sandbox/staleout2.out" "$sandbox/staleout2.err" >&2
  exit 1
}
grep -q 're-encode (source newer than out)' "$sandbox/staleout2.out" \
  || grep -q 're-encode (source newer than out)' "$sandbox/staleout2.err" || {
  echo "FAIL: expected re-encode for newer source vs stale out" >&2
  cat "$sandbox/staleout2.out" "$sandbox/staleout2.err" >&2
  exit 1
}
if grep -q 'inspect-then-delete' "$sandbox/staleout2.out" \
  "$sandbox/staleout2.err"; then
  echo "FAIL: took inspect-then-delete with newer source" >&2
  cat "$sandbox/staleout2.out" "$sandbox/staleout2.err" >&2
  exit 1
fi
if ! grep -q $'^pass1\t' "$STAB_FAKE_LOG" || ! grep -q $'^pass2\t' "$STAB_FAKE_LOG"
then
  echo "FAIL: newer-source --delete-source did not re-encode" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
if [[ -e "$sandbox/staleout/clip.MOV" ]]; then
  echo "FAIL: newer-source re-encode left source (want delete after OK)" >&2
  cat "$sandbox/staleout2.out" "$sandbox/staleout2.err" >&2
  exit 1
fi
new_out_for=$(grep '^OUT_FOR=' "$sandbox/staleout/stabilised-clip.mp4" | cut -d= -f2-)
# OUT_FOR records the path at encode time; content must be the new encode
# (USED_TRF / TRF_FOR present) — not the pre-replacement out bytes alone.
grep -q '^USED_TRF=' "$sandbox/staleout/stabilised-clip.mp4" || {
  echo "FAIL: re-encode did not rewrite stabilized output" >&2
  exit 1
}
assert_eq "staleout OUT_FOR path" "$sandbox/staleout/clip.MOV" "$new_out_for"
# Path is the same; ensure we did not keep the old OUT_FOR payload blindly
# by checking the second-run log wrote pass2 for this source.
grep -q $'^pass2\t'"$sandbox/staleout/clip.MOV"$'\t' "$STAB_FAKE_LOG" || {
  echo "FAIL: pass2 log missing for replaced source" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
}
# Sanity: old keep-run OUT_FOR path equals new (same path); content changed
# via re-encode — assert the prelude still had an out (already checked).
[[ -n "$old_out_for" ]] || {
  echo "FAIL: prelude OUT_FOR empty" >&2
  exit 1
}
printf 'ok: newer source vs stale out re-encodes under --delete-source\n'

# --- p33: same whole-second content replace must not inspect-delete -------
# Whole-second %Y equality is not enough: replace content, pin equal
# seconds on src+out; .srcid size mismatch must force re-encode.
mkdir -p "$sandbox/samesec"
printf 'samesec-old\n' > "$sandbox/samesec/clip.MOV"
rm -f -- "$sandbox/samesec/stabilised-clip.mp4" \
  "$sandbox/samesec/stabilised-clip.mp4.srcid"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/samesec/clip.MOV" \
  >"$sandbox/samesec1.out" 2>"$sandbox/samesec1.err" || {
  echo "FAIL: samesec keep-default exited $?" >&2
  cat "$sandbox/samesec1.out" "$sandbox/samesec1.err" >&2
  exit 1
}
[[ -f "$sandbox/samesec/stabilised-clip.mp4.srcid" ]] || {
  echo "FAIL: samesec missing .srcid after keep-default" >&2
  exit 1
}
t=$(stat -c '%Y' -- "$sandbox/samesec/stabilised-clip.mp4")
printf 'samesec-REPLACED-same-second\n' > "$sandbox/samesec/clip.MOV"
touch -d "@$t" -- "$sandbox/samesec/clip.MOV" \
  "$sandbox/samesec/stabilised-clip.mp4"
# Stale .srcid still has old size — must not inspect-then-delete.
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/samesec/clip.MOV" \
  >"$sandbox/samesec2.out" 2>"$sandbox/samesec2.err" || {
  echo "FAIL: samesec --delete-source exited $?" >&2
  cat "$sandbox/samesec2.out" "$sandbox/samesec2.err" >&2
  exit 1
}
if grep -q 'inspect-then-delete' "$sandbox/samesec2.out" \
  "$sandbox/samesec2.err"; then
  echo "FAIL: same-second replace took inspect-then-delete" >&2
  cat "$sandbox/samesec2.out" "$sandbox/samesec2.err" >&2
  exit 1
fi
grep -q 're-encode (source identity mismatch)' "$sandbox/samesec2.out" \
  || grep -q 're-encode (source identity mismatch)' "$sandbox/samesec2.err" \
  || grep -q 're-encode (source newer than out)' "$sandbox/samesec2.out" \
  || grep -q 're-encode (source newer than out)' "$sandbox/samesec2.err" || {
  echo "FAIL: expected re-encode for same-second content replace" >&2
  cat "$sandbox/samesec2.out" "$sandbox/samesec2.err" >&2
  exit 1
}
if ! grep -q $'^pass2\t' "$STAB_FAKE_LOG"; then
  echo "FAIL: same-second replace did not re-encode" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
if [[ -e "$sandbox/samesec/clip.MOV" ]]; then
  echo "FAIL: same-second re-encode left source (want delete after OK)" >&2
  exit 1
fi
printf 'ok: same-second content replace re-encodes (not inspect-delete)\n'

# --- p33: same-size in-place replace + restored mtime must not inspect-delete
# Old size+mtime+inode .srcid would still match after an in-place overwrite
# of equal length with touch -r restoring mtime (same inode). Content hash
# must force re-encode instead of destroying the replacement master.
mkdir -p "$sandbox/samesize"
printf 'samesizeA\n' > "$sandbox/samesize/clip.MOV"
rm -f -- "$sandbox/samesize/stabilised-clip.mp4" \
  "$sandbox/samesize/stabilised-clip.mp4.srcid"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/samesize/clip.MOV" \
  >"$sandbox/samesize1.out" 2>"$sandbox/samesize1.err" || {
  echo "FAIL: samesize keep-default exited $?" >&2
  cat "$sandbox/samesize1.out" "$sandbox/samesize1.err" >&2
  exit 1
}
[[ -f "$sandbox/samesize/stabilised-clip.mp4.srcid" ]] || {
  echo "FAIL: samesize missing .srcid after keep-default" >&2
  exit 1
}
src_inode_before=$(stat -c '%i' -- "$sandbox/samesize/clip.MOV")
src_bytes_before=$(stat -c '%s' -- "$sandbox/samesize/clip.MOV")
# In-place same-size replace; restore mtime from out (equal -nt relation).
printf 'samesizeB\n' > "$sandbox/samesize/clip.MOV"
touch -r "$sandbox/samesize/stabilised-clip.mp4" -- "$sandbox/samesize/clip.MOV"
src_inode_after=$(stat -c '%i' -- "$sandbox/samesize/clip.MOV")
src_bytes_after=$(stat -c '%s' -- "$sandbox/samesize/clip.MOV")
assert_eq "samesize byte length" "$src_bytes_before" "$src_bytes_after"
assert_eq "samesize inode" "$src_inode_before" "$src_inode_after"
: > "$STAB_FAKE_LOG"
"$script" --delete-source "$sandbox/samesize/clip.MOV" \
  >"$sandbox/samesize2.out" 2>"$sandbox/samesize2.err" || {
  echo "FAIL: samesize --delete-source exited $?" >&2
  cat "$sandbox/samesize2.out" "$sandbox/samesize2.err" >&2
  exit 1
}
if grep -q 'inspect-then-delete' "$sandbox/samesize2.out" \
  "$sandbox/samesize2.err"; then
  echo "FAIL: same-size+mtime replace took inspect-then-delete" >&2
  cat "$sandbox/samesize2.out" "$sandbox/samesize2.err" >&2
  exit 1
fi
grep -q 're-encode (source identity mismatch)' "$sandbox/samesize2.out" \
  || grep -q 're-encode (source identity mismatch)' "$sandbox/samesize2.err" || {
  echo "FAIL: expected identity-mismatch re-encode for same-size replace" >&2
  cat "$sandbox/samesize2.out" "$sandbox/samesize2.err" >&2
  exit 1
}
if ! grep -q $'^pass2\t' "$STAB_FAKE_LOG"; then
  echo "FAIL: same-size replace did not re-encode" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
if [[ -e "$sandbox/samesize/clip.MOV" ]]; then
  echo "FAIL: same-size re-encode left source (want delete after OK)" >&2
  exit 1
fi
printf 'ok: same-size+mtime in-place replace re-encodes (not inspect-delete)\n'

# --- p33: TOCTOU — replace during sibling encode → keep + re-encode -------
# A needs re-encode (no .srcid); B is inspect-then-delete. During A's pass2,
# replace B's master; B must refuse delete and late-re-encode.
mkdir -p "$sandbox/toctou/a" "$sandbox/toctou/b"
printf 'toctou-a\n' > "$sandbox/toctou/a/clip.MOV"
printf 'toctou-b\n' > "$sandbox/toctou/b/clip.MOV"
rm -f -- "$sandbox/toctou/a/stabilised-clip.mp4" \
  "$sandbox/toctou/a/stabilised-clip.mp4.srcid" \
  "$sandbox/toctou/b/stabilised-clip.mp4" \
  "$sandbox/toctou/b/stabilised-clip.mp4.srcid"
: > "$STAB_FAKE_LOG"
"$script" "$sandbox/toctou/a/clip.MOV" "$sandbox/toctou/b/clip.MOV" \
  >"$sandbox/toctou1.out" 2>"$sandbox/toctou1.err" || {
  echo "FAIL: toctou keep-default exited $?" >&2
  cat "$sandbox/toctou1.out" "$sandbox/toctou1.err" >&2
  exit 1
}
# Force A into todo; keep B as inspect-then-delete candidate.
rm -f -- "$sandbox/toctou/a/stabilised-clip.mp4.srcid"
touch -r "$sandbox/toctou/b/stabilised-clip.mp4" -- "$sandbox/toctou/b/clip.MOV"
# shellcheck source=scripts/stabilize-video
source "$script"
_write_srcid "$sandbox/toctou/b/clip.MOV" "$sandbox/toctou/b/stabilised-clip.mp4"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_REPLACE_SRC="$sandbox/toctou/b/clip.MOV"
export STAB_FAKE_REPLACE_WITH='toctou-b-REPLACED-during-sibling-encode'
export STAB_FAKE_REPLACE_ONCE="$sandbox/toctou.replace-once"
rm -f -- "$STAB_FAKE_REPLACE_ONCE"
"$script" --delete-source \
  "$sandbox/toctou/a/clip.MOV" "$sandbox/toctou/b/clip.MOV" \
  >"$sandbox/toctou2.out" 2>"$sandbox/toctou2.err" || {
  echo "FAIL: toctou --delete-source exited $?" >&2
  cat "$sandbox/toctou2.out" "$sandbox/toctou2.err" >&2
  exit 1
}
unset STAB_FAKE_REPLACE_SRC STAB_FAKE_REPLACE_WITH STAB_FAKE_REPLACE_ONCE
grep -q $'^replace\t' "$STAB_FAKE_LOG" || {
  echo "FAIL: sibling encode did not trigger replace hook" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
}
grep -q 'queue re-encode' "$sandbox/toctou2.out" \
  || grep -q 'queue re-encode' "$sandbox/toctou2.err" || {
  echo "FAIL: expected TOCTOU queue re-encode for replaced sibling" >&2
  cat "$sandbox/toctou2.out" "$sandbox/toctou2.err" >&2
  exit 1
}
grep -q 'Late re-encode' "$sandbox/toctou2.out" \
  || grep -q 'Late re-encode' "$sandbox/toctou2.err" || {
  echo "FAIL: expected late re-encode section" >&2
  cat "$sandbox/toctou2.out" "$sandbox/toctou2.err" >&2
  exit 1
}
# B must have been re-encoded after replace (pass2 for B after replace).
mapfile -t toctou_pass2 < <(awk -F'\t' '$1=="pass2"{print $2}' "$STAB_FAKE_LOG")
b_encoded=no
for p2src in "${toctou_pass2[@]}"; do
  if [[ "$p2src" == "$sandbox/toctou/b/clip.MOV" ]]; then
    b_encoded=yes
  fi
done
if [[ "$b_encoded" != yes ]]; then
  echo "FAIL: replaced sibling B was not re-encoded" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
if [[ -e "$sandbox/toctou/b/clip.MOV" ]]; then
  echo "FAIL: TOCTOU path left B source (want delete after late encode)" >&2
  cat "$sandbox/toctou2.out" "$sandbox/toctou2.err" >&2
  exit 1
fi
if [[ -e "$sandbox/toctou/a/clip.MOV" ]]; then
  echo "FAIL: TOCTOU path left A source after --delete-source" >&2
  exit 1
fi
grep -q '^OUT_FOR=' "$sandbox/toctou/b/stabilised-clip.mp4" || {
  echo "FAIL: B out missing after late re-encode" >&2
  exit 1
}
printf 'ok: TOCTOU sibling replace → keep + late re-encode + delete\n'

# --- y33: pass-1 concurrency capped by PASS1_MAX_JOBS --------------------
mkdir -p "$sandbox/throttle"
for i in 1 2 3 4; do
  printf 'clip-%s\n' "$i" > "$sandbox/throttle/c${i}.MOV"
done
: > "$STAB_FAKE_LOG"
export STAB_FAKE_PASS1_ACTIVE="$sandbox/throttle.active"
export STAB_FAKE_PASS1_PEAK="$sandbox/throttle.peak"
export STAB_FAKE_PASS1_SLEEP=0.35
printf '0\n' > "$STAB_FAKE_PASS1_ACTIVE"
printf '0\n' > "$STAB_FAKE_PASS1_PEAK"
export PASS1_MAX_JOBS=2
"$script" "$sandbox/throttle" \
  >"$sandbox/throttle.out" 2>"$sandbox/throttle.err" || {
  echo "FAIL: throttle run exited $?" >&2
  cat "$sandbox/throttle.out" "$sandbox/throttle.err" >&2
  exit 1
}
unset STAB_FAKE_PASS1_SLEEP STAB_FAKE_PASS1_ACTIVE STAB_FAKE_PASS1_PEAK
unset PASS1_MAX_JOBS
peak=$(<"$sandbox/throttle.peak")
active=$(<"$sandbox/throttle.active")
if ((peak > 2)); then
  echo "FAIL: pass1 peak concurrency ${peak} > PASS1_MAX_JOBS=2" >&2
  cat "$sandbox/throttle.out" "$sandbox/throttle.err" >&2
  exit 1
fi
if ((peak < 2)); then
  echo "FAIL: pass1 peak concurrency ${peak} < 2 (throttle too serial?)" >&2
  cat "$sandbox/throttle.out" "$sandbox/throttle.err" >&2
  exit 1
fi
if ((active != 0)); then
  echo "FAIL: pass1 active counter not drained (got ${active})" >&2
  exit 1
fi
pass1_n=$(awk -F'\t' '$1=="pass1"{c++} END{print c+0}' "$STAB_FAKE_LOG")
assert_eq "throttle pass1 count" 4 "$pass1_n"
grep -q 'up to 2 parallel' "$sandbox/throttle.out" || {
  echo "FAIL: missing pass1 parallel cap message" >&2
  cat "$sandbox/throttle.out" >&2
  exit 1
}
for i in 1 2 3 4; do
  [[ -f "$sandbox/throttle/stabilised-c${i}.mp4" ]] || {
    echo "FAIL: throttle missing out for c${i}.MOV" >&2
    exit 1
  }
  [[ -f "$sandbox/throttle/c${i}.MOV" ]] || {
    echo "FAIL: throttle deleted source c${i}.MOV (want keep)" >&2
    exit 1
  }
done
printf 'ok: y33 pass1 throttle peak=%s under PASS1_MAX_JOBS=2\n' "$peak"

# --- y33: pass-1 failures under throttle must abort (no silent proceed) ---
mkdir -p "$sandbox/p1fail"
for i in 1 2 3; do
  printf 'p1fail-%s\n' "$i" > "$sandbox/p1fail/c${i}.MOV"
done
: > "$STAB_FAKE_LOG"
export PASS1_MAX_JOBS=2
export STAB_FAKE_PASS1_FAIL=1
export STAB_FAKE_PASS1_SLEEP=0.15
export STAB_FAKE_PASS1_ACTIVE="$sandbox/p1fail.active"
export STAB_FAKE_PASS1_PEAK="$sandbox/p1fail.peak"
printf '0\n' > "$STAB_FAKE_PASS1_ACTIVE"
printf '0\n' > "$STAB_FAKE_PASS1_PEAK"
set +e
"$script" "$sandbox/p1fail" \
  >"$sandbox/p1fail.out" 2>"$sandbox/p1fail.err"
p1fail_rc=$?
set -e
unset STAB_FAKE_PASS1_FAIL STAB_FAKE_PASS1_SLEEP
unset STAB_FAKE_PASS1_ACTIVE STAB_FAKE_PASS1_PEAK
unset PASS1_MAX_JOBS
if ((p1fail_rc == 0)); then
  echo "FAIL: expected non-zero exit when pass-1 fails under throttle" >&2
  cat "$sandbox/p1fail.out" "$sandbox/p1fail.err" >&2
  exit 1
fi
grep -q 'pass 1 failed' "$sandbox/p1fail.err" || {
  echo "FAIL: missing pass-1-failed message under throttle" >&2
  cat "$sandbox/p1fail.err" >&2
  exit 1
}
if grep -q $'^pass2\t' "$STAB_FAKE_LOG"; then
  echo "FAIL: pass-2 ran after pass-1 failures (fail count dropped?)" >&2
  cat "$STAB_FAKE_LOG" >&2
  exit 1
fi
for i in 1 2 3; do
  [[ -f "$sandbox/p1fail/c${i}.MOV" ]] || {
    echo "FAIL: pass1-fail run deleted source c${i}.MOV" >&2
    exit 1
  }
  if [[ -e "$sandbox/p1fail/stabilised-c${i}.mp4" ]]; then
    echo "FAIL: pass1-fail left final for c${i}.MOV" >&2
    exit 1
  fi
done
printf 'ok: y33 negative — pass1 failures under throttle abort before pass2\n'

# --- unit: _partial_for / _output_decodes / _parse_cli / srcid ------------
# shellcheck source=scripts/stabilize-video
source "$script"
partial_path=$(_partial_for "$sandbox/corrupt/stabilised-clip.mp4")
assert_eq "_partial_for suffix" \
  "$sandbox/corrupt/stabilised-clip.mp4.partial" "$partial_path"
assert_eq "_srcid_for suffix" \
  "$sandbox/corrupt/stabilised-clip.mp4.srcid" \
  "$(_srcid_for "$sandbox/corrupt/stabilised-clip.mp4")"
if ! _output_decodes "$sandbox/corrupt/stabilised-clip.mp4"; then
  echo "FAIL: _output_decodes rejected known-good encode marker" >&2
  exit 1
fi
printf 'junk\n' > "$sandbox/unit-bad.mp4"
if _output_decodes "$sandbox/unit-bad.mp4"; then
  echo "FAIL: _output_decodes accepted undecodable junk" >&2
  exit 1
fi
if _output_decodes "$sandbox/does-not-exist.mp4"; then
  echo "FAIL: _output_decodes accepted missing path" >&2
  exit 1
fi
_parse_cli --delete-source "$sandbox/a/clip.MOV"
assert_eq "DELETE_SOURCE after --delete-source" yes "$DELETE_SOURCE"
assert_eq "_cli_paths[0]" "$sandbox/a/clip.MOV" "${_cli_paths[0]}"
_parse_cli "$sandbox/b/clip.MOV"
assert_eq "DELETE_SOURCE default" no "$DELETE_SOURCE"
_is_positive_number 1.23 || {
  echo "FAIL: _is_positive_number rejected 1.23" >&2
  exit 1
}
if _is_positive_number N/A || _is_positive_number 0 || _is_positive_number '' \
  || _is_positive_number -1 || _is_positive_number bogus; then
  echo "FAIL: _is_positive_number accepted non-positive/non-numeric" >&2
  exit 1
fi
printf 'older\n' > "$sandbox/mtime-src"
printf 'newer\n' > "$sandbox/mtime-out"
touch -d '@1000' -- "$sandbox/mtime-src"
touch -d '@2000' -- "$sandbox/mtime-out"
if _source_newer_than_out "$sandbox/mtime-src" "$sandbox/mtime-out"; then
  echo "FAIL: _source_newer_than_out true when src older" >&2
  exit 1
fi
touch -d '@3000' -- "$sandbox/mtime-src"
_source_newer_than_out "$sandbox/mtime-src" "$sandbox/mtime-out" || {
  echo "FAIL: _source_newer_than_out false when src newer" >&2
  exit 1
}
printf 'id-src-AAAA\n' > "$sandbox/id-src"
printf 'OUT_FOR=x\n' > "$sandbox/id-out.mp4"
_write_srcid "$sandbox/id-src" "$sandbox/id-out.mp4"
_srcid_matches "$sandbox/id-src" "$sandbox/id-out.mp4" || {
  echo "FAIL: _srcid_matches false right after _write_srcid" >&2
  exit 1
}
# mtime-only change must not invalidate content-hash .srcid
touch -d '@9999' -- "$sandbox/id-src"
_srcid_matches "$sandbox/id-src" "$sandbox/id-out.mp4" || {
  echo "FAIL: _srcid_matches false after mtime-only change" >&2
  exit 1
}
# Same-size content replace must invalidate (hash), not size/mtime/inode.
printf 'id-src-BBBB\n' > "$sandbox/id-src"
touch -r "$sandbox/id-out.mp4" -- "$sandbox/id-src"
if _srcid_matches "$sandbox/id-src" "$sandbox/id-out.mp4"; then
  echo "FAIL: _srcid_matches true after same-size content replace" >&2
  exit 1
fi
_out_stale_for_source "$sandbox/id-src" "$sandbox/id-out.mp4" || {
  echo "FAIL: _out_stale_for_source false after identity mismatch" >&2
  exit 1
}
fp=$(_src_fingerprint "$sandbox/id-src")
[[ "$fp" =~ ^[0-9]+[[:space:]]+[0-9a-f]{64}$ ]] || {
  echo "FAIL: fingerprint not 'size sha256': $fp" >&2
  exit 1
}
PASS1_MAX_JOBS=3
assert_eq "_pass1_max_jobs override" 3 "$(_pass1_max_jobs)"
PASS1_MAX_JOBS=0
nproc_fallback=$(_pass1_max_jobs)
[[ "$nproc_fallback" =~ ^[1-9][0-9]*$ ]] || {
  echo "FAIL: _pass1_max_jobs bad fallback for PASS1_MAX_JOBS=0: $nproc_fallback" >&2
  exit 1
}
PASS1_MAX_JOBS=bogus
assert_eq "_pass1_max_jobs ignores bogus" "$nproc_fallback" "$(_pass1_max_jobs)"
unset PASS1_MAX_JOBS
printf 'ok: unit — helpers + [[ -nt ]] + .srcid content hash + pass1 max jobs\n'

# --- syntax / shellcheck --------------------------------------------------
bash -n "$script"
bash -n "$repo/scripts/stabilize-video-e2e"
shellcheck -x "$script"
shellcheck -x "$repo/scripts/stabilize-video-e2e"
printf 'ok: bash -n + shellcheck\n'

echo ""
echo "stabilize-video-e2e: all checks passed"
