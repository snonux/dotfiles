#!/usr/bin/env bash
# Exercise stabilize-video TRF identity without real ffmpeg / GPU work.
#
# Covers the c33 failure mode: same basename in different directories must
# not share a .trf (wrong stabilize → delete originals). Also covers paths
# with spaces, main/CLI same-realpath collision abort, and missing-TRF
# refuse-delete (presence / defense-in-depth — not content-identity).
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
script="$repo/scripts/stabilize-video"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT

mkdir -p "$sandbox/bin" "$sandbox/a" "$sandbox/b" \
  "$sandbox/dir with spaces" "$sandbox/real"

# --- fake ffmpeg / ffprobe -------------------------------------------------
# Records which TRF each source used in pass 1/2 so the harness can assert
# identity. VAAPI probe fails so the script takes the software encode path.
#
# STAB_FAKE_RM_TRF_AFTER_PASS2=1 — after a successful pass 2, delete the
# TRF that was just consumed so main's verify sees decode-OK + missing TRF.

cat > "$sandbox/bin/ffmpeg" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
log="${STAB_FAKE_LOG:-/dev/null}"

# VAAPI capability probe — always fail so software path is used.
for arg in "$@"; do
  if [[ "$arg" == -vaapi_device || "$arg" == hevc_vaapi ]]; then
    exit 1
  fi
done

src=""
out=""
vf=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -i) src=$arg ;;
    -vf) vf=$arg ;;
  esac
  prev=$arg
done
# Output file is the final argument when not -f null.
out=${*: -1}
if [[ "$out" == - ]]; then
  out=""
fi

# Pass 1: vidstabdetect → write a TRF that records the source path.
if [[ "$vf" == *vidstabdetect=* ]]; then
  trf=${vf#*result=}
  trf=${trf%%,*}
  trf=${trf%%:*}
  printf 'TRF_FOR=%s\n' "$src" > "$trf"
  printf 'pass1\t%s\t%s\n' "$src" "$trf" >> "$log"
  exit 0
fi

# Decode-verify: ffmpeg -v error -i "$out" -f null -
# (Pass 1 also ends in -f null -, but is handled above via vidstabdetect.)
if [[ "$*" == *' -f null -'* || "$*" == *'-f null -' ]]; then
  if [[ -n "$src" && -f "$src" ]]; then
    exit 0
  fi
  exit 1
fi

# Pass 2: vidstabtransform → write output embedding which TRF was applied.
if [[ "$vf" == *vidstabtransform=* ]]; then
  trf=${vf#*input=}
  trf=${trf%%,*}
  trf=${trf%%:*}
  if [[ ! -f "$trf" ]]; then
    echo "fake-ffmpeg: missing trf $trf for $src" >&2
    exit 1
  fi
  {
    echo "OUT_FOR=$src"
    echo "USED_TRF=$trf"
    cat "$trf"
  } > "$out"
  printf 'pass2\t%s\t%s\t%s\n' "$src" "$trf" "$out" >> "$log"
  # Simulate TRF vanishing after encode so verify must refuse delete.
  if [[ "${STAB_FAKE_RM_TRF_AFTER_PASS2:-}" == 1 ]]; then
    rm -f -- "$trf"
  fi
  exit 0
fi

echo "fake-ffmpeg: unhandled argv: $*" >&2
exit 1
EOF

cat > "$sandbox/bin/ffprobe" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo 1.23
EOF

chmod +x "$sandbox/bin/ffmpeg" "$sandbox/bin/ffprobe"
export PATH="$sandbox/bin:$PATH"
export VADEVICE="/dev/null"   # force non-char-device → skip VAAPI probe early
export STAB_FAKE_LOG="$sandbox/ffmpeg.log"
: > "$STAB_FAKE_LOG"

assert_eq() {
  local -r label=$1 want=$2 got=$3
  if [[ "$want" != "$got" ]]; then
    printf 'FAIL %s: want %q got %q\n' "$label" "$want" "$got" >&2
    exit 1
  fi
  printf 'ok: %s\n' "$label"
}

# --- unit: TRF keys are unique for same basename, different dirs ----------
# shellcheck source=scripts/stabilize-video
source "$script"

key_a=$(_trf_key "$sandbox/a/clip.MOV")
key_b=$(_trf_key "$sandbox/b/clip.MOV")
key_sp=$(_trf_key "$sandbox/dir with spaces/clip.MOV")

if [[ "$key_a" == "$key_b" ]]; then
  echo "FAIL: TRF keys collided for a/clip.MOV and b/clip.MOV" >&2
  exit 1
fi
if [[ "$key_a" == "$key_sp" || "$key_b" == "$key_sp" ]]; then
  echo "FAIL: TRF key collided with spaces-path clip" >&2
  exit 1
fi
printf 'ok: distinct TRF keys for same basename in different dirs\n'

# Same absolute path → same key (stability).
key_a2=$(_trf_key "$sandbox/a/clip.MOV")
assert_eq "stable key for same path" "$key_a" "$key_a2"

# --- negative: collision guard refuses ambiguous TRF identity -------------
trf_dir="$sandbox/trf-collision"
mkdir -p "$trf_dir"
# Override _trf_for to the OLD basename-only scheme — must abort.
_trf_for() {
  local -r src=$1
  printf '%s/%s.trf' "$trf_dir" "$(basename "${src%.MOV}")"
}
touch "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV"
if _assert_unique_trfs "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV" 2>"$sandbox/collision.err"
then
  echo "FAIL: expected collision abort for basename-only TRF keys" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/collision.err"
printf 'ok: negative — basename collision aborts before stabilize\n'

# Restore real _trf_for from the script (re-source helpers).
# shellcheck source=scripts/stabilize-video
source "$script"
trf_dir="$sandbox/trf-ok"
mkdir -p "$trf_dir"
_assert_unique_trfs "$sandbox/a/clip.MOV" "$sandbox/b/clip.MOV"
printf 'ok: hash-based keys pass uniqueness guard\n'

# --- e2e: full run with colliding basenames + spaces path -----------------
printf 'mov-a\n' > "$sandbox/a/clip.MOV"
printf 'mov-b\n' > "$sandbox/b/clip.MOV"
printf 'mov-sp\n' > "$sandbox/dir with spaces/clip.MOV"

"$script" \
  "$sandbox/a/clip.MOV" \
  "$sandbox/b/clip.MOV" \
  "$sandbox/dir with spaces/clip.MOV" \
  >"$sandbox/run.out" 2>"$sandbox/run.err" || {
    echo "FAIL: stabilize-video exited $?" >&2
    cat "$sandbox/run.out" "$sandbox/run.err" >&2
    exit 1
  }

for dir in a b "dir with spaces"; do
  out="$sandbox/$dir/stabilised-clip.mp4"
  [[ -f "$out" ]] || {
    echo "FAIL: missing output $out" >&2
    exit 1
  }
  used_trf=$(grep '^USED_TRF=' "$out" | cut -d= -f2-)
  trf_for=$(grep '^TRF_FOR=' "$out" | cut -d= -f2-)
  out_for=$(grep '^OUT_FOR=' "$out" | cut -d= -f2-)
  expected_src="$sandbox/$dir/clip.MOV"
  # Source should have been deleted after decode-OK + TRF present.
  if [[ -e "$expected_src" ]]; then
    echo "FAIL: source still present after success: $expected_src" >&2
    exit 1
  fi
  assert_eq "$dir OUT_FOR" "$expected_src" "$out_for"
  assert_eq "$dir TRF_FOR matches source" "$expected_src" "$trf_for"
  [[ -n "$used_trf" ]] || {
    echo "FAIL: empty USED_TRF in $out" >&2
    exit 1
  }
  printf 'ok: e2e correct TRF + delete for %s\n' "$dir"
done

# Distinct TRF paths actually used in the fake log (tab-separated).
mapfile -t trf_paths < <(awk -F'\t' '$1=="pass1"{print $3}' "$STAB_FAKE_LOG" | sort -u)
if ((${#trf_paths[@]} != 3)); then
  echo "FAIL: expected 3 distinct pass1 TRF paths, got ${#trf_paths[@]}" >&2
  printf '  %s\n' "${trf_paths[@]}" >&2
  exit 1
fi
printf 'ok: e2e used 3 distinct TRF files for 3 same-basename clips\n'

# --- main/CLI: same-realpath collision abort (duplicate args) -------------
# Exercises _assert_unique_trfs through main. Removing that call from main
# must make this test fail (stabilize would proceed and delete the source).
printf 'dup-src\n' > "$sandbox/real/clip.MOV"
: > "$STAB_FAKE_LOG"
set +e
"$script" "$sandbox/real/clip.MOV" "$sandbox/real/clip.MOV" \
  >"$sandbox/dup.out" 2>"$sandbox/dup.err"
dup_rc=$?
set -e
if ((dup_rc == 0)); then
  echo "FAIL: expected non-zero exit for duplicate-arg same realpath" >&2
  cat "$sandbox/dup.out" "$sandbox/dup.err" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/dup.err" || {
  echo "FAIL: missing collision message on duplicate args" >&2
  cat "$sandbox/dup.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/real/clip.MOV" ]]; then
  echo "FAIL: duplicate-arg run deleted source" >&2
  exit 1
fi
if [[ -e "$sandbox/real/stabilised-clip.mp4" ]]; then
  echo "FAIL: duplicate-arg run wrote output before abort" >&2
  exit 1
fi
printf 'ok: main/CLI — duplicate args abort, source kept\n'

# --- main/CLI: same-realpath collision abort (two symlinks) ---------------
ln -sfn "$sandbox/real/clip.MOV" "$sandbox/a/via-a.MOV"
ln -sfn "$sandbox/real/clip.MOV" "$sandbox/b/via-b.MOV"
: > "$STAB_FAKE_LOG"
set +e
"$script" "$sandbox/a/via-a.MOV" "$sandbox/b/via-b.MOV" \
  >"$sandbox/sym.out" 2>"$sandbox/sym.err"
sym_rc=$?
set -e
if ((sym_rc == 0)); then
  echo "FAIL: expected non-zero exit for symlink same-realpath pair" >&2
  cat "$sandbox/sym.out" "$sandbox/sym.err" >&2
  exit 1
fi
grep -q 'TRF key collision' "$sandbox/sym.err" || {
  echo "FAIL: missing collision message on symlink pair" >&2
  cat "$sandbox/sym.err" >&2
  exit 1
}
if [[ ! -f "$sandbox/real/clip.MOV" ]]; then
  echo "FAIL: symlink-pair run deleted real source" >&2
  exit 1
fi
if [[ ! -L "$sandbox/a/via-a.MOV" || ! -L "$sandbox/b/via-b.MOV" ]]; then
  echo "FAIL: symlink-pair run removed symlink args" >&2
  exit 1
fi
if [[ -e "$sandbox/a/stabilised-via-a.mp4" || -e "$sandbox/b/stabilised-via-b.mp4" ]]; then
  echo "FAIL: symlink-pair run wrote output before abort" >&2
  exit 1
fi
printf 'ok: main/CLI — symlink same-realpath abort, sources kept\n'

# --- main: missing TRF after decode-OK keeps source (presence check) ------
# Drive full main: fake ffmpeg encodes OK then removes the TRF so verify
# sees decode-OK + absent expected TRF path. This is a presence /
# defense-in-depth guard — not a content-identity binding test.
# Removing the keep-source branch in main must make this fail (source rm'd).
rm -f -- "$sandbox/a/stabilised-clip.mp4"
printf 'keep-me\n' > "$sandbox/a/clip.MOV"
: > "$STAB_FAKE_LOG"
export STAB_FAKE_RM_TRF_AFTER_PASS2=1
set +e
"$script" "$sandbox/a/clip.MOV" \
  >"$sandbox/miss.out" 2>"$sandbox/miss.err"
miss_rc=$?
set -e
unset STAB_FAKE_RM_TRF_AFTER_PASS2
if ((miss_rc != 0)); then
  echo "FAIL: missing-TRF run exited $miss_rc (expected 0)" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/a/clip.MOV" ]]; then
  echo "FAIL: source deleted despite missing TRF after decode-OK" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
fi
if [[ ! -f "$sandbox/a/stabilised-clip.mp4" ]]; then
  echo "FAIL: missing stabilized output for missing-TRF case" >&2
  exit 1
fi
grep -q 'missing TRF — keeping source' "$sandbox/miss.err" \
  || grep -q 'missing TRF — keeping source' "$sandbox/miss.out" || {
  echo "FAIL: expected keeping-source message for missing TRF" >&2
  cat "$sandbox/miss.out" "$sandbox/miss.err" >&2
  exit 1
}
if grep -q 'deleted source:' "$sandbox/miss.out" "$sandbox/miss.err"; then
  echo "FAIL: reported source delete when TRF was missing" >&2
  exit 1
fi
printf 'ok: main — missing TRF after decode-OK keeps source (presence)\n'

# --- syntax / shellcheck --------------------------------------------------
bash -n "$script"
bash -n "$repo/scripts/stabilize-video-e2e"
shellcheck -x "$script"
shellcheck -x "$repo/scripts/stabilize-video-e2e"
printf 'ok: bash -n + shellcheck\n'

echo ""
echo "stabilize-video-e2e: all checks passed"
