#!/usr/bin/env bash
# Wake-on-LAN and shutdown script for f3s hosts (f0, f1, f2, f3)
# and optional shutdown for Raspberry Pi nodes (pi0–pi3)

set -euo pipefail

_WOL_F3S_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/f3s-hosts.sh
source "${_WOL_F3S_DIR}/lib/f3s-hosts.sh"

#
# Before any shutdown of f3s Beelink hosts (f0/f1/f2/f3), this script will
# attempt to umount all NFS filesystems currently mounted on this machine
# (earth). NFS mounts here are tunnelled via stunnel (127.0.0.1:2323 →
# CARP VIP on f0/f1). If any NFS mount is active and
# cannot be umounted, the shutdown is aborted to prevent data loss or a
# hung filesystem.
#
# Usage:
#   wol-f3s              # Wake f0, f1, and f2
#   wol-f3s f0           # Wake only f0
#   wol-f3s f1           # Wake only f1
#   wol-f3s f2           # Wake only f2
#   wol-f3s f3           # Wake only f3
#   wol-f3s shutdown     # Shutdown f0, f1, and f2
#   wol-f3s shutdown-f3  # Shutdown only f3
#   wol-f3s shutdown-pis # Shutdown all four Raspberry Pis
#   wol-f3s shutdown-all # Shutdown f0, f1, f2, and Pis
#
# Fleet IPs/MACs/roles: scripts/lib/f3s-hosts.sh

# Local aliases for the inventory maps (keep call sites readable).
F0_MAC="${F3S_HOST_MAC[f0]}"
F1_MAC="${F3S_HOST_MAC[f1]}"
F2_MAC="${F3S_HOST_MAC[f2]}"
F3_MAC="${F3S_HOST_MAC[f3]}"
F0_IP="${F3S_HOST_IP[f0]}"
F1_IP="${F3S_HOST_IP[f1]}"
F2_IP="${F3S_HOST_IP[f2]}"
F3_IP="${F3S_HOST_IP[f3]}"
# k3s Rocky VMs on f0/f1/f2. Used as the readiness signal when un-muting
# Gogios: the alerts we mute on shutdown are the Prometheus ones scraped from
# this cluster, so the cluster being back is what makes them meaningful again.
R0_IP="${F3S_HOST_IP[r0]}"
R1_IP="${F3S_HOST_IP[r1]}"
R2_IP="${F3S_HOST_IP[r2]}"
# Raspberry Pi IP addresses (no WoL support, shutdown only)
PI0_IP="${F3S_HOST_IP[pi0]}"
PI1_IP="${F3S_HOST_IP[pi1]}"
PI2_IP="${F3S_HOST_IP[pi2]}"
PI3_IP="${F3S_HOST_IP[pi3]}"

# Shelly Plug M Gen 3 controlling the rack fans (HTTP RPC API).
# It is powered on when waking all hosts and powered off when shutting all
# hosts down. The plug uses digest auth (user "admin"); the password is read
# from ~/.shelly_plug if that file exists.
#
# The shutdown paths need root (to umount NFS), so this script is typically
# run elevated. When elevated, $HOME becomes root's home, where ~/.shelly_plug
# does not exist — so resolve the file relative to the invoking user's home
# ($SUDO_USER under sudo on Linux, $DOAS_USER under doas on NetBSD Pis),
# falling back to $HOME otherwise.
#
# Home resolution must not use eval (a crafted SUDO_USER/DOAS_USER could run
# arbitrary code as the elevated helper). getent is also avoided: NetBSD Pis
# historically lack it. Instead, validate the username and read the home
# directory from /etc/passwd (files-only; no NSS/LDAP). That covers local
# accounts on the hosts this script targets (Fedora "earth" and the NetBSD
# Pis). Username charset is restricted to [[:alnum:]_-]+ — sufficient for
# those local accounts; exotic NSS names are rejected and fall back to
# $HOME. Override via _PASSWD_FILE for tests.
SHELLY_IP="$F3S_SHELLY_IP"
_PASSWD_FILE="${_PASSWD_FILE:-/etc/passwd}"

# _user_home_from_passwd USER — print USER's home from $_PASSWD_FILE.
# Username must match [[:alnum:]_-]+; returns 1 if invalid or unknown.
_user_home_from_passwd() {
    local -r user="$1"
    local name home

    [[ "$user" =~ ^[[:alnum:]_-]+$ ]] || return 1

    # Handle a final passwd line that lacks a trailing newline.
    while IFS=: read -r name _ _ _ _ home _ || [[ -n "$name" ]]; do
        if [[ "$name" == "$user" ]]; then
            [[ -n "$home" ]] || return 1
            printf '%s\n' "$home"
            return 0
        fi
    done <"$_PASSWD_FILE"
    return 1
}

# _shelly_pass_file — path to the invoking user's ~/.shelly_plug, or $HOME's.
_shelly_pass_file() {
    local user="${SUDO_USER:-${DOAS_USER:-}}"
    local home=""

    if [[ -n "$user" ]]; then
        home="$(_user_home_from_passwd "$user")" || home=""
    fi

    if [[ -n "$home" ]]; then
        printf '%s\n' "${home}/.shelly_plug"
    else
        printf '%s\n' "${HOME}/.shelly_plug"
    fi
}

SHELLY_PASS_FILE="$(_shelly_pass_file)"

# SSH user (from inventory)
SSH_USER="$F3S_SSH_USER"
# Pinned host keys for power-control SSH. StrictHostKeyChecking=yes rejects
# unknown and changed keys (MITM protection stays on). UserKnownHostsFile is
# the pin; GlobalKnownHostsFile=/dev/null ignores the system store so a
# poisoned /etc/ssh/ssh_known_hosts cannot satisfy verification. Override
# _WOL_F3S_KNOWN_HOSTS in tests. After intentional key rotation, update the
# pin file via supervised ssh-keyscan — do not weaken checking.
: "${_WOL_F3S_KNOWN_HOSTS:=${_WOL_F3S_DIR}/wol-f3s.known_hosts}"
SSH_OPTIONS=(
    -o StrictHostKeyChecking=yes
    -o UserKnownHostsFile="${_WOL_F3S_KNOWN_HOSTS}"
    -o GlobalKnownHostsFile=/dev/null
    -o LogLevel=ERROR
)

# Give guests time to handle the ACPI shutdown request before killing bhyve.
# This must remain below the f-host rcshutdown_timeout (currently 300 seconds).
VM_SHUTDOWN_TIMEOUT=240

# Broadcast address for your LAN
BROADCAST="$F3S_LAN_BROADCAST"

# Gogios mute marker. Created on shutdown so the Prometheus-derived checks stay
# quiet while the cluster is deliberately down. Gogios expires it on its own
# after PrometheusOnlyIfNotExistsMaxS (24h by default), but relying on that
# expiry means a real outage after an early wake-up goes unnoticed for the rest
# of the day — that hid a two-day audiobookshelf outage in August 2026. So the
# wake path clears it explicitly instead.
GOGIOS_MUTE_FILE="/tmp/f3s_taken_down"
GOGIOS_GATEWAYS=("${F3S_GOGIOS_GATEWAYS[@]}")

# How long to wait for the k3s nodes before giving up on un-muting.
GOGIOS_UNMUTE_TIMEOUT=600

# mute_gogios places the mute marker on every Gogios gateway.
# Tries all gateways even if one fails (partial mute is better than none).
# Returns non-zero if any SSH failed — callers that must not abort shutdown
# should use: mute_gogios || true
mute_gogios() {
    local gw
    local -i failed=0

    for gw in "${GOGIOS_GATEWAYS[@]}"; do
        echo "Muting Gogios on $gw..."
        if ssh "${SSH_OPTIONS[@]}" -o BatchMode=yes -o ConnectTimeout=5 \
            "rex@$gw" touch "$GOGIOS_MUTE_FILE"; then
            echo "  ✓ Mute marker set on $gw"
        else
            echo "  ✗ Failed to mute Gogios on $gw (SSH unreachable or rejected)" >&2
            failed=1
        fi
    done

    if (( failed != 0 )); then
        echo "✗ Gogios mute incomplete — at least one gateway failed." >&2
        return 1
    fi
    return 0
}

# unmute_gogios waits for all three k3s nodes to answer before removing the
# marker, so that alerts do not fire during the boot window.
unmute_gogios() {
    local deadline=$((SECONDS + GOGIOS_UNMUTE_TIMEOUT))
    local ip gw pending=1

    echo "Waiting for k3s nodes before un-muting Gogios monitoring..."
    while (( SECONDS < deadline )); do
        pending=0
        for ip in "$R0_IP" "$R1_IP" "$R2_IP"; do
            ping -c1 -W2 "$ip" &>/dev/null || pending=1
        done
        (( pending == 0 )) && break
        sleep 15
    done

    if (( pending != 0 )); then
        echo "⚠️  k3s nodes not all reachable after ${GOGIOS_UNMUTE_TIMEOUT}s;"
        echo "    leaving Gogios muted. Clear it by hand once they are up:"
        echo "    ssh rex@<gateway> rm -f $GOGIOS_MUTE_FILE"
        return 1
    fi

    local -i unmute_failed=0
    for gw in "${GOGIOS_GATEWAYS[@]}"; do
        echo "Un-muting Gogios on $gw..."
        if ssh "${SSH_OPTIONS[@]}" -o BatchMode=yes -o ConnectTimeout=5 \
            "rex@$gw" rm -f "$GOGIOS_MUTE_FILE"; then
            echo "  ✓ Mute marker cleared on $gw"
        else
            echo "  ✗ Failed to un-mute Gogios on $gw (SSH unreachable or rejected)" >&2
            unmute_failed=1
        fi
    done

    if (( unmute_failed != 0 )); then
        echo "✗ Gogios un-mute incomplete — clear by hand:" >&2
        echo "    ssh rex@<gateway> rm -f $GOGIOS_MUTE_FILE" >&2
        return 1
    fi
    echo "✓ Gogios monitoring un-muted."
}

wake() {
    local name=$1
    local mac=$2

    if [[ "$mac" == "XX:XX:XX:XX:XX:XX" ]]; then
        echo "⚠️  $name MAC address not configured yet" >&2
        return 1
    fi

    echo "Sending WoL packet to $name ($mac)..."
    if wol -i "$BROADCAST" "$mac"; then
        echo "  ✓ WoL packet sent to $name"
        return 0
    fi

    echo "  ✗ Failed to send WoL packet to $name ($mac)" >&2
    return 1
}

# shelly_set turns the rack-fan Shelly plug on or off.
#   $1 — "true" to power on, "false" to power off
shelly_set() {
    local on=$1
    local label="on"
    local status
    [[ "$on" == "false" ]] && label="off"

    local auth=()
    if [[ -r "$SHELLY_PASS_FILE" ]]; then
        local pass
        pass="$(head -n 1 "$SHELLY_PASS_FILE" | tr -d '\r\n')"
        [[ -n "$pass" ]] && auth=(--digest -u "admin:$pass")
    fi

    if [[ ${#auth[@]} -eq 0 ]]; then
        echo "  ⚠️  No Shelly password found at $SHELLY_PASS_FILE"
        echo "     — cannot switch plug $label (digest auth required)."
        return 1
    fi

    echo "Turning rack-fan Shelly plug $label ($SHELLY_IP)..."
    # --fail is essential: without it curl returns 0 even on an HTTP 401
    # (auth failure), which would falsely report success while the plug is
    # left untouched.
    # Set the output using the query form supported by this plug's firmware,
    # then read status back. A successful HTTP response alone is not enough:
    # Shelly RPC errors can be JSON bodies.
    if curl -sS --fail --max-time 5 "${auth[@]}" \
        "http://${SHELLY_IP}/rpc/Switch.Set?id=0&on=${on}" >/dev/null &&
        status="$(curl -sS --fail --max-time 5 "${auth[@]}" \
        "http://${SHELLY_IP}/rpc/Switch.GetStatus?id=0")" &&
        grep -Eq "\"output\"[[:space:]]*:[[:space:]]*${on}([,}])" \
        <<<"$status"; then
        echo "  ✓ Shelly plug switched $label"
    else
        echo "  ✗ Failed to switch Shelly plug at $SHELLY_IP (auth or network error)"
        return 1
    fi
}

# umount_nfs_mounts tries to umount all currently mounted NFS filesystems on
# this local machine (earth). It reads /proc/mounts to find active nfs/nfs4
# mounts, attempts to umount each one, and returns 1 if any mount could not
# be umounted. This prevents shutting down f3s servers while NFS is still in
# use, which would leave the filesystem in a hung/stale state.
umount_nfs_mounts() {
    # Collect all active NFS mount points from /proc/mounts (covers nfs and nfs4)
    local nfs_mounts=()
    while IFS= read -r mountpoint; do
        nfs_mounts+=("$mountpoint")
    done < <(awk '$3 ~ /^nfs/ { print $2 }' /proc/mounts)

    if [[ ${#nfs_mounts[@]} -eq 0 ]]; then
        echo "  No NFS filesystems currently mounted — nothing to umount."
        return 0
    fi

    local failed=0
    for mp in "${nfs_mounts[@]}"; do
        echo "  Umounting NFS filesystem: $mp ..."
        if umount "$mp" 2>/dev/null; then
            echo "  ✓ Umounted $mp"
        else
            # If it's no longer listed in /proc/mounts, it's already gone.
            if ! grep -q "^[^ ]* $mp nfs" /proc/mounts; then
                echo "  ✓ $mp was already unmounted"
            else
                echo "  ✗ Failed to umount $mp (in use or already unmounted?)"
                failed=1
            fi
        fi
    done

    if [[ $failed -ne 0 ]]; then
        echo ""
        echo "✗ One or more NFS filesystems could not be umounted."
        echo "  Aborting shutdown to prevent data loss or a hung filesystem."
        echo "  Please check running processes that may have open files on NFS,"
        echo "  then retry."
        return 1
    fi

    return 0
}

shutdown_bhyve_host() {
    local name=$1
    local ip=$2

    echo "Shutting down $name ($ip)..."
    # Stop guests outside rc.shutdown so a stuck bhyve cannot trip init's
    # shutdown watchdog and strand the host in networkless single-user mode.
    # vm-bhyve 1.7.3 has no stop timeout, so enforce one here and use SIGKILL
    # only after the grace period. The forced stop is deliberately loud: it
    # can require an etcd health check/recovery after the next k3s boot.
    if ssh "${SSH_OPTIONS[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$SSH_USER@$ip" \
        "doas /bin/sh -s -- '$VM_SHUTDOWN_TIMEOUT'" <<'REMOTE_SHUTDOWN'
timeout=$1

echo "VM state before shutdown:"
vm list

get_bhyve_pids() {
    pids=$(pgrep -f 'bhyve:')
    pgrep_status=$?
    if [ "$pgrep_status" -gt 1 ]; then
        echo "ERROR: unable to inspect bhyve processes; refusing host poweroff" >&2
        exit 1
    fi
    [ "$pgrep_status" -eq 0 ]
}

# vm-bhyve 1.7.3's stopall sends SIGTERM twice and then waits indefinitely.
# Send the same ACPI shutdown signal ourselves so our polling timeout applies.
if get_bhyve_pids; then
    kill $pids 2>/dev/null || true
    sleep 1
    kill $pids 2>/dev/null || true
fi

elapsed=0
while get_bhyve_pids; do
    if [ "$elapsed" -ge "$timeout" ]; then
        echo "WARNING: guest shutdown exceeded ${timeout}s; force-killing bhyve" >&2
        echo "Force-killing bhyve PID(s): $pids" >&2
        kill -9 $pids 2>/dev/null || true
        sleep 2
        break
    fi
    sleep 5
    elapsed=$((elapsed + 5))
done

if get_bhyve_pids; then
    echo "ERROR: a VM is still running; refusing host poweroff" >&2
    exit 1
fi

echo "Guests stopped after ${elapsed}s; powering off host"
poweroff
REMOTE_SHUTDOWN
    then
        echo "  ✓ $name accepted the bounded shutdown sequence"
    else
        echo "  ✗ Failed to shut down $name (unreachable or a VM remained running)"
        return 1
    fi
}

shutdown_host() {
    local name=$1
    local ip=$2

    echo "Shutting down $name ($ip)..."
    if ssh "${SSH_OPTIONS[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$SSH_USER@$ip" \
        "doas poweroff" 2>/dev/null; then
        echo "  ✓ Shutdown command sent to $name"
    else
        echo "  ✗ Failed to reach $name (already down?)"
        return 1
    fi
}

# shutdown_fleet [--with-pis]
# Shared Beelink (f0/f1/f2) shutdown path used by both "shutdown" and
# "shutdown-all". Umounts NFS, mutes Gogios (best-effort), shuts hosts,
# optionally includes Pis, then powers off rack fans on full success.
shutdown_fleet() {
    local with_pis=no
    local -i failed=0

    case "${1:-}" in
        --with-pis) with_pis=yes ;;
        "") ;;
        *)
            echo "shutdown_fleet: unknown option: $1" >&2
            return 2
            ;;
    esac

    # Umount local NFS filesystems first; abort if any are stuck.
    # The NFS mounts on earth tunnel through stunnel to the f3s CARP VIP,
    # so they will hang or corrupt if the servers go down while mounted.
    echo "Checking for locally mounted NFS filesystems..."
    umount_nfs_mounts || return 1
    # Mute Gogios on both gateways. Best-effort: mute_gogios reports
    # clear per-gateway SSH errors and returns non-zero on failure, but
    # must not abort the privileged host shutdown (pre-set -e behaviour).
    mute_gogios || true

    shutdown_bhyve_host "f0" "$F0_IP" || failed=1
    shutdown_bhyve_host "f1" "$F1_IP" || failed=1
    shutdown_bhyve_host "f2" "$F2_IP" || failed=1

    if [[ "$with_pis" == yes ]]; then
        shutdown_host "pi0" "$PI0_IP" || failed=1
        shutdown_host "pi1" "$PI1_IP" || failed=1
        shutdown_host "pi2" "$PI2_IP" || failed=1
        shutdown_host "pi3" "$PI3_IP" || failed=1
    fi

    if (( failed != 0 )); then
        if [[ "$with_pis" == yes ]]; then
            echo "✗ At least one machine did not accept shutdown; leaving rack fans on."
        else
            echo "✗ At least one Beelink did not complete shutdown; leaving rack fans on."
        fi
        return 1
    fi

    # Power off the rack fans once all hosts are shutting down.
    shelly_set "false" || return 1
    echo ""
    if [[ "$with_pis" == yes ]]; then
        echo "✓ Shutdown commands sent to all machines."
    else
        echo "✓ Shutdown commands sent to all Beelinks."
    fi
    return 0
}

main() {
    local ACTION="${1:-all}"
    local pi_shutdown_failed=0
    # Set when the all-path wake continues past a WoL failure so the final
    # banner reports partial/failure instead of unconditional success.
    local -i wake_failed=0

    case "$ACTION" in
        f0)
            wake "f0" "$F0_MAC"
            ;;
        f1)
            wake "f1" "$F1_MAC"
            ;;
        f2)
            wake "f2" "$F2_MAC"
            ;;
        f3)
            wake "f3" "$F3_MAC"
            ;;
        all|"")
            # Power on the rack fans before booting the hosts.
            shelly_set "true" || exit 1
            # WoL failures must not skip remaining hosts or the unmute step
            # (pre-set -e behaviour). Helpers still print clear errors and
            # return non-zero; we only suppress abort here.
            wake "f0" "$F0_MAC" || wake_failed=1
            wake "f1" "$F1_MAC" || wake_failed=1
            wake "f2" "$F2_MAC" || wake_failed=1
            if (( wake_failed != 0 )); then
                echo "⚠️  At least one WoL send failed; continuing with un-mute." >&2
            fi
            # Counterpart to the mute in the shutdown path below. Only the "all"
            # wake clears it: waking a single host would un-mute alerts for the
            # others that are still down.
            unmute_gogios || true
            ;;
        shutdown|poweroff|down)
            shutdown_fleet || exit 1
            exit 0
            ;;
        shutdown-f3|poweroff-f3|down-f3)
            # Umount local NFS filesystems first; abort if any are stuck.
            # f3 does not host the NFS CARP VIP (that is f0/f1), but umounting
            # first is still the safe default to avoid stale state.
            echo "Checking for locally mounted NFS filesystems..."
            umount_nfs_mounts || exit 1
            shutdown_bhyve_host "f3" "$F3_IP" || exit 1
            echo ""
            echo "✓ Shutdown command sent to f3."
            exit 0
            ;;
        shutdown-pis)
            # Raspberry Pis do not serve NFS, so no umount check is needed here.
            pi_shutdown_failed=0
            shutdown_host "pi0" "$PI0_IP" || pi_shutdown_failed=1
            shutdown_host "pi1" "$PI1_IP" || pi_shutdown_failed=1
            shutdown_host "pi2" "$PI2_IP" || pi_shutdown_failed=1
            shutdown_host "pi3" "$PI3_IP" || pi_shutdown_failed=1
            if [[ $pi_shutdown_failed -ne 0 ]]; then
                echo "✗ At least one Pi did not accept its shutdown command."
                exit 1
            fi
            echo ""
            echo "✓ Shutdown commands sent to all Pis."
            exit 0
            ;;
        shutdown-all)
            shutdown_fleet --with-pis || exit 1
            exit 0
            ;;
        *)
            echo "Usage: $0 [f0|f1|f2|f3|all|shutdown|shutdown-f3|shutdown-pis|shutdown-all]"
            exit 1
            ;;
    esac

    echo ""
    if (( wake_failed != 0 )); then
        echo "⚠️  WoL incomplete — at least one packet failed to send."
        echo "  Check which hosts came up, then try: ssh ${SSH_USER}@${F0_IP}"
        exit 1
    fi
    echo "✓ WoL packets sent. Machines should boot in a few seconds."
    echo "  Wait ~30 seconds, then try: ssh ${SSH_USER}@${F0_IP}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
