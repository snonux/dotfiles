#!/usr/bin/env bash
# Mirror selected local directories to a remote tempbackup via rsync --delete.
#
# Usage:
#   temp-backup                  # Notes + Documents (defaults)
#   temp-backup DIR [DIR ...]    # Explicit source directories
#
# Override remote host with TEMP_BACKUP_HOST (default: f0.wg0).
set -euo pipefail

declare -a dirs
if (($# > 0)); then
    dirs=("$@")
else
    dirs=(
        "${HOME}/Syncthing/Notes/"
        "${HOME}/Documents/"
    )
fi

# Remote leaf name under tempbackup/; never allow empty, ., .., or /
# (dest escape: basename -- // is /, which would yield tempbackup//).
_remote_basename() {
    local -r src="$1"
    local name
    name="$(basename -- "$src")"
    if [[ -z "$name" || "$name" == '.' || "$name" == '..' || "$name" == / ]]; then
        printf 'temp-backup: refused remote basename %q for source: %s\n' \
            "$name" "$src" >&2
        exit 1
    fi
    printf '%s\n' "$name"
}

# Trailing slash on source syncs contents into the remote basename dir.
_normalize_source() {
    local src="$1"
    if [[ "$src" != */ ]]; then
        src="${src}/"
    fi
    printf '%s\n' "$src"
}

for dir in "${dirs[@]}"; do
    if [[ ! -e "$dir" ]]; then
        printf 'temp-backup: source does not exist: %s\n' "$dir" >&2
        exit 1
    fi
    if [[ ! -d "$dir" ]]; then
        printf 'temp-backup: source is not a directory: %s\n' "$dir" >&2
        exit 1
    fi
    # Reject filesystem root. On Linux, cd // && pwd -P can print //
    # (POSIX quirk), so == / alone misses it; any all-slashes path is root.
    resolved="$(cd -- "$dir" && pwd -P)"
    if [[ -z "${resolved//\/}" ]]; then
        printf 'temp-backup: refusing filesystem root as source: %s\n' \
            "$dir" >&2
        exit 1
    fi
    # Validate remote leaf early (before any --delete rsync).
    _remote_basename "$dir" >/dev/null
done

declare -r remote_host="${TEMP_BACKUP_HOST:-f0.wg0}"

for dir in "${dirs[@]}"; do
    remote_name="$(_remote_basename "$dir")"
    source_path="$(_normalize_source "$dir")"
    rsync -av --delete -- \
        "$source_path" \
        "${remote_host}:tempbackup/${remote_name}"
done
