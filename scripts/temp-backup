#!/usr/bin/env bash
# Sync selected local directories to a remote tempbackup via rsync.
#
# Usage:
#   temp-backup [-n] [-d DEST] [--delete] [--] [DIR ...]
#   temp-backup -h
#
# Defaults (no DIR args): Notes + Documents under $HOME.
#
# Destination (remote base, sources land in DEST/<basename>):
#   TEMP_BACKUP_DEST env, or -d DEST, else
#   ${TEMP_BACKUP_HOST:-f0.wg0}:tempbackup
#   Empty, CHANGEME_*, and host:/ (empty or root-only path) are refused.
#
# Note: does NOT read home-backup's BACKUP_DEST. An ambient BACKUP_DEST for
# home-backup must not retarget this script; use TEMP_BACKUP_DEST or -d.
#
# Sources that begin with '-' must be passed after '--', e.g.:
#   temp-backup -- -dashy
#
# Safety policy (differs from home-backup on purpose):
#   --delete is opt-in. home-backup always mirrors with --delete; this script
#   only passes --delete when --delete is given, so a casual run cannot wipe
#   remote tempbackup trees. Use -n to dry-run first.
set -euo pipefail

declare -r PROGRAM=${0##*/}

# Prefer TEMP_BACKUP_DEST; else host:tempbackup from TEMP_BACKUP_HOST.
# Intentionally ignores BACKUP_DEST (home-backup) to avoid silent retarget.
declare DEST="${TEMP_BACKUP_DEST:-${TEMP_BACKUP_HOST:-f0.wg0}:tempbackup}"
declare DRY_RUN=""
declare DO_DELETE="no"

log() {
    printf '%s\n' "$*"
}

error() {
    log "$*" >&2
}

usage() {
    cat <<EOF
Usage: $PROGRAM [-n] [-d DEST] [--delete] [--] [DIR ...]

  -n           Dry run (show what would be transferred, transfer nothing)
  -d DEST      Remote base destination (host:path), overrides TEMP_BACKUP_DEST
  --delete     Opt-in: remove remote files that no longer exist locally
  --           End of options; following args are sources (needed for
               relative paths that start with '-', e.g. -- -dashy)
  -h, --help   Show this help

Without DIR arguments, backs up:
  \$HOME/Syncthing/Notes/
  \$HOME/Documents/

Destination may also be set via TEMP_BACKUP_DEST. If unset, defaults to
\${TEMP_BACKUP_HOST:-f0.wg0}:tempbackup. Empty, CHANGEME_*, and
host:/ (empty or root-only path after host:) are refused.

This script does not use BACKUP_DEST (that is home-backup's variable).

Unlike home-backup (always --delete), this script requires --delete
explicitly before any destructive remote pruning.
EOF
}

# Remote leaf name under DEST/; never allow empty, ., .., or /
# (dest escape: basename -- // is /, which would yield DEST//).
_remote_basename() {
    local -r src="$1"
    local name
    name="$(basename -- "$src")"
    if [[ -z "$name" || "$name" == '.' || "$name" == '..' || "$name" == / ]]; then
        printf 'temp-backup: refused remote basename %q for source: %s\n' \
            "$name" "$src" >&2
        exit 1
    fi
    printf '%s\n' "$name"
}

# Trailing slash on source syncs contents into the remote basename dir.
_normalize_source() {
    local src="$1"
    if [[ "$src" != */ ]]; then
        src="${src}/"
    fi
    printf '%s\n' "$src"
}

_validate_dest() {
    local -r dest="$1"
    if [[ -z "$dest" || "$dest" == CHANGEME_* ]]; then
        error "No backup destination set."
        error "Set TEMP_BACKUP_DEST, pass -d host:path, or edit DEST in $PROGRAM."
        exit 1
    fi
    if [[ "$dest" != *:* ]]; then
        error "Destination must be host:path (got: $dest)."
        exit 1
    fi
    # Path after the last ':' (rsync user@host:path / host:path).
    local -r remote_path="${dest##*:}"
    # Refuse empty (host:) and root-only (host:/, host://, …).
    if [[ -z "$remote_path" || -z "${remote_path//\/}" ]]; then
        error "Destination path after host: is empty or root-only: $dest"
        exit 1
    fi
}

_validate_sources() {
    local -n _dirs="$1"
    local dir resolved
    for dir in "${_dirs[@]}"; do
        if [[ ! -e "$dir" ]]; then
            printf 'temp-backup: source does not exist: %s\n' "$dir" >&2
            exit 1
        fi
        if [[ ! -d "$dir" ]]; then
            printf 'temp-backup: source is not a directory: %s\n' "$dir" >&2
            exit 1
        fi
        # Reject filesystem root. On Linux, cd // && pwd -P can print //
        # (POSIX quirk), so == / alone misses it; any all-slashes path is root.
        resolved="$(cd -- "$dir" && pwd -P)"
        if [[ -z "${resolved//\/}" ]]; then
            printf 'temp-backup: refusing filesystem root as source: %s\n' \
                "$dir" >&2
            exit 1
        fi
        # Validate remote leaf early (before any --delete rsync).
        _remote_basename "$dir" >/dev/null
    done
}

_log_run_plan() {
    log "Destination: $DEST"
    if [[ -n "$DRY_RUN" ]]; then
        log "Mode:        DRY RUN (no data transferred)"
    else
        log "Mode:        LIVE"
    fi
    if [[ "$DO_DELETE" == yes ]]; then
        log "Delete:      yes (--delete)"
    else
        log "Delete:      no (pass --delete to prune remote)"
    fi
    log ""
}

main() {
    local -a dirs=()

    while (($# > 0)); do
        case "$1" in
            -n)
                DRY_RUN="--dry-run"
                shift
                ;;
            -d)
                if (($# < 2)); then
                    error "Option -d requires an argument."
                    usage
                    exit 2
                fi
                DEST="$2"
                shift 2
                ;;
            --delete)
                DO_DELETE="yes"
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            --)
                shift
                dirs+=("$@")
                break
                ;;
            -*)
                error "Unknown option: $1"
                usage
                exit 2
                ;;
            *)
                dirs+=("$1")
                shift
                ;;
        esac
    done

    _validate_dest "$DEST"

    if ((${#dirs[@]} == 0)); then
        dirs=(
            "${HOME}/Syncthing/Notes/"
            "${HOME}/Documents/"
        )
    fi

    _validate_sources dirs
    _log_run_plan

    local dir remote_name source_path
    local -a rsync_args

    for dir in "${dirs[@]}"; do
        remote_name="$(_remote_basename "$dir")"
        source_path="$(_normalize_source "$dir")"
        rsync_args=(-av)
        if [[ "$DO_DELETE" == yes ]]; then
            rsync_args+=(--delete)
        fi
        if [[ -n "$DRY_RUN" ]]; then
            rsync_args+=(--dry-run)
        fi
        rsync "${rsync_args[@]}" -- \
            "$source_path" \
            "${DEST%/}/${remote_name}"
    done
}

main "$@"
