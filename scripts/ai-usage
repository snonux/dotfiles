#!/usr/bin/env bash
# ai-usage — print AI subscription usage for Codex and Claude Code.
#
# Codex limits are read through the local Codex app server, so the ChatGPT
# authentication token never leaves Codex. Claude Code limits come from the
# Anthropic usage API (the same one Claude Code's own /usage view uses) with
# the OAuth token Claude Code stores on sign-in; the token is read only to
# build the request header and is never printed.
#
# The default output is a coloured terminal summary. Machine-readable JSON
# remains available, with one top-level object per provider:
#
#   ai-usage --format json | jq -r '.claude.five_hour.utilization'
#
# Usage:
#   ai-usage [--format text|json|remaining] [--color auto|always|never]
#
# Requires: jq; codex (signed in with ChatGPT) and/or Claude Code (signed in
# with a Claude subscription). The Claude section also needs curl.

set -euo pipefail

format=text
color=auto

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  printf 'ai-usage: %s\n' "$*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --format)
      (($# >= 2)) || die '--format needs an argument'
      format=$2
      shift 2
      ;;
    --format=*)
      format=${1#*=}
      shift
      ;;
    --json)
      format=json
      shift
      ;;
    --color)
      (($# >= 2)) || die '--color needs an argument'
      color=$2
      shift 2
      ;;
    --color=*)
      color=${1#*=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$format" in
  json|text|remaining) ;;
  *) die "unknown format: $format (use json, text, or remaining)" ;;
esac

case "$color" in
  auto|always|never) ;;
  *) die "unknown color mode: $color (use auto, always, or never)" ;;
esac

command -v jq >/dev/null || die 'jq is not on PATH'

# ---------- Codex ----------

# Each provider section leaves either a JSON document in <provider>_json or
# a reason in <provider>_error, never both empty.

codex_json=
codex_error=
server_pid=
server_in=
server_out=

_codex_cleanup() {
  if [ -n "${server_in:-}" ]; then
    exec {server_in}>&- 2>/dev/null || true
  fi
  if [ -n "${server_out:-}" ]; then
    exec {server_out}<&- 2>/dev/null || true
  fi
  if [ -n "$server_pid" ]; then
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap _codex_cleanup EXIT

_codex_read_response() {
  local wanted_id=$1 line

  while IFS= read -r line <&"$server_out"; do
    if jq -e --argjson wanted_id "$wanted_id" \
      '.id == $wanted_id' >/dev/null <<<"$line"; then
      printf '%s\n' "$line"
      return 0
    fi
  done

  return 1
}

if ! command -v codex >/dev/null 2>&1; then
  codex_error='codex is not on PATH'
else
  coproc CODEX_APP_SERVER { exec timeout 15s codex app-server --stdio; }
  server_pid=$CODEX_APP_SERVER_PID
  server_in=${CODEX_APP_SERVER[1]}
  server_out=${CODEX_APP_SERVER[0]}

  if printf '%s\n' \
      '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"ai-usage","version":"2.0.0"}}}' \
      >&"$server_in" \
    && _codex_read_response 1 >/dev/null \
    && printf '%s\n' \
      '{"id":2,"method":"account/rateLimits/read","params":{"excludeResetCreditDetails":true}}' \
      >&"$server_in" \
    && codex_raw=$(_codex_read_response 2) \
    && codex_json=$(jq -e '.result | del(.accountId)' <<<"$codex_raw"); then
    :
  else
    codex_json=
    codex_error='could not read Codex rate limits'
  fi
fi

# ---------- Claude Code ----------

claude_json=
claude_error=
claude_plan=unknown
claude_config_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
claude_credentials=$claude_config_dir/.credentials.json

_claude_fetch() {
  local token body status config

  token=$(jq -r '.claudeAiOauth.accessToken // empty' "$claude_credentials" 2>/dev/null) \
    || { claude_error='could not read the Claude Code credentials'; return 1; }
  [ -n "$token" ] || { claude_error='Claude Code is not signed in'; return 1; }
  claude_plan=$(jq -r '.claudeAiOauth.subscriptionType // "unknown"' \
    "$claude_credentials" 2>/dev/null) || claude_plan=unknown

  # The token travels to curl through stdin, not the command line, so it
  # never shows up in /proc/<pid>/cmdline or process listings.
  config=$(printf 'url = "https://api.anthropic.com/api/oauth/usage"
max-time = "15"
silent
show-error
user-agent = "ai-usage/2.0"
write-out = "\\n%%{http_code}"
header = "Authorization: Bearer %s"
header = "anthropic-beta: oauth-2025-04-20"
header = "anthropic-version: 2023-06-01"
header = "x-app: cli"' "$token")

  body=$(curl --config - <<<"$config") \
    || { claude_error='could not reach the Anthropic usage API'; return 1; }

  status=${body##*$'\n'}
  body=${body%$'\n'*}

  case $status in
    200) ;;
    401|403)
      claude_error='the Claude subscription is not usable (re-sign-in or check billing)'
      return 1
      ;;
    429)
      claude_error='the Anthropic usage API is rate limiting requests'
      return 1
      ;;
    *)
      claude_error="the Anthropic usage API returned HTTP $status"
      return 1
      ;;
  esac

  # Claude Code itself only accepts a body that carries at least one of
  # these top-level window keys; anything else is an in-band error.
  if claude_json=$(jq -e '
      select(type == "object")
      | select(has("five_hour") or has("seven_day")
          or has("seven_day_oauth_apps") or has("seven_day_opus")
          or has("seven_day_sonnet") or has("cinder_cove")
          or has("wattle_ember") or has("extra_usage") or has("limits"))
    ' <<<"$body" 2>/dev/null); then
    return 0
  fi
  claude_json=
  claude_error='Claude returned an unexpected usage response'
  return 1
}

if [ ! -r "$claude_credentials" ]; then
  claude_error='Claude Code is not signed in'
elif ! command -v curl >/dev/null 2>&1; then
  claude_error='curl is not on PATH'
else
  _claude_fetch || true
fi

# ---------- output ----------

colorize=no
if [ "$color" = always ] || { [ "$color" = auto ] && [ -t 1 ]; }; then
  colorize=yes
fi

if [ "$colorize" = yes ]; then
  reset=$'\033[0m'
  bold=$'\033[1m'
  dim=$'\033[2m'
  cyan=$'\033[36m'
  green=$'\033[32m'
  yellow=$'\033[33m'
  red=$'\033[31m'
else
  reset=
  bold=
  dim=
  cyan=
  green=
  yellow=
  red=
fi

bar=
usage_color=

# _bar N — fill $bar (10 blocks) and $usage_color for N percent remaining.
_bar() {
  local -i remaining=$1 filled empty i

  filled=$((remaining / 10))
  empty=$((10 - filled))

  if ((remaining >= 50)); then
    usage_color=$green
  elif ((remaining >= 20)); then
    usage_color=$yellow
  else
    usage_color=$red
  fi

  bar=
  for ((i = 0; i < filled; i++)); do bar+='█'; done
  for ((i = 0; i < empty; i++)); do bar+='░'; done
}

print_codex_text() {
  local plan used reset_at remaining summary

  if [ -n "$codex_error" ]; then
    printf '%sCodex usage unavailable%s (%s)\n' \
      "$yellow" "$reset" "$codex_error"
    return
  fi

  summary=$(jq -r '
    .rateLimits.primary as $primary
    | if $primary == null then empty else
        [
          (.rateLimits.planType // "unknown"),
          ($primary.usedPercent | if . == null then "" else floor end),
          ($primary.resetsAt
            | if . == null then "unknown" else todateiso8601 end)
        ] | join("|")
      end
  ' <<<"$codex_json") || summary=

  if [ -z "$summary" ]; then
    printf '%sCodex usage unavailable%s\n' "$yellow" "$reset"
    return
  fi

  IFS='|' read -r plan used reset_at <<<"$summary"
  if [ -z "$used" ]; then
    printf '%sCodex usage unavailable%s\n' "$yellow" "$reset"
    return
  fi
  remaining=$((100 - used))
  _bar "$remaining"

  printf '%s%sCodex usage%s %s(%s)%s\n' \
    "$bold" "$cyan" "$reset" "$dim" "$plan" "$reset"
  printf '  %s[%s%s%s]%s %s%3d%%%s left %s· %d%% used%s\n' \
    "$dim" "$usage_color" "$bar" "$dim" "$reset" \
    "$usage_color" "$remaining" "$reset" "$dim" "$used" "$reset"
  printf '  %s↳ resets %s%s\n' "$dim" "$reset_at" "$reset"
}

print_claude_text() {
  local plan used5 reset5 used7 reset7 remaining summary

  if [ -n "$claude_error" ]; then
    printf '%sClaude usage unavailable%s (%s)\n' \
      "$yellow" "$reset" "$claude_error"
    return
  fi

  summary=$(jq -r --arg plan "$claude_plan" '
    def iso:
      if . == null then "unknown"
      elif type == "number" then todate
      else . end;
    [
      $plan,
      (.five_hour.utilization
        | if . == null then "" else floor end),
      (.five_hour.resets_at | iso),
      (.seven_day.utilization
        | if . == null then "" else floor end),
      (.seven_day.resets_at | iso)
    ] | join("|")
  ' <<<"$claude_json") || summary=

  IFS='|' read -r plan used5 reset5 used7 reset7 <<<"$summary"

  printf '%s%sClaude usage%s %s(%s)%s\n' \
    "$bold" "$cyan" "$reset" "$dim" "$plan" "$reset"

  if [ -n "$used5" ]; then
    remaining=$((100 - used5))
    _bar "$remaining"
    printf '  5h %s[%s%s%s]%s %s%3d%%%s left %s· %d%% used%s\n' \
      "$dim" "$usage_color" "$bar" "$dim" "$reset" \
      "$usage_color" "$remaining" "$reset" "$dim" "$used5" "$reset"
    printf '     %s↳ resets %s%s\n' "$dim" "$reset5" "$reset"
  fi

  if [ -n "$used7" ]; then
    remaining=$((100 - used7))
    _bar "$remaining"
    printf '  7d %s[%s%s%s]%s %s%3d%%%s left %s· %d%% used%s\n' \
      "$dim" "$usage_color" "$bar" "$dim" "$reset" \
      "$usage_color" "$remaining" "$reset" "$dim" "$used7" "$reset"
    printf '     %s↳ resets %s%s\n' "$dim" "$reset7" "$reset"
  fi

  if [ -z "$used5" ] && [ -z "$used7" ]; then
    printf '  %sno subscription usage data%s\n' "$dim" "$reset"
  fi
}

print_text() {
  print_codex_text
  printf '\n'
  print_claude_text
}

print_json() {
  local codex_arg claude_arg

  if [ -n "$codex_json" ]; then
    codex_arg=$codex_json
  else
    codex_arg=$(jq -cn --arg error "$codex_error" '{error: $error}')
  fi

  if [ -n "$claude_json" ]; then
    claude_arg=$claude_json
  else
    claude_arg=$(jq -cn --arg error "$claude_error" '{error: $error}')
  fi

  jq -n --argjson codex "$codex_arg" --argjson claude "$claude_arg" \
    '{codex: $codex, claude: $claude}'
}

print_remaining() {
  local used

  if [ -n "$codex_error" ]; then
    printf 'ai-usage: Codex unavailable (%s)\n' "$codex_error" >&2
  else
    used=$(jq -r '.rateLimits.primary
      | if . == null or .usedPercent == null then empty
        else 100 - (.usedPercent | floor) end' <<<"$codex_json" 2>/dev/null) || true
    if [ -n "$used" ]; then
      printf 'codex %d\n' "$used"
    else
      printf 'ai-usage: Codex usage data unavailable\n' >&2
    fi
  fi

  if [ -n "$claude_error" ]; then
    printf 'ai-usage: Claude unavailable (%s)\n' "$claude_error" >&2
  else
    used=$(jq -r '.five_hour.utilization
      | if . == null then empty else floor end' <<<"$claude_json" 2>/dev/null) || true
    if [ -n "$used" ]; then
      printf 'claude 5h %d\n' "$((100 - used))"
    fi
    used=$(jq -r '.seven_day.utilization
      | if . == null then empty else floor end' <<<"$claude_json" 2>/dev/null) || true
    if [ -n "$used" ]; then
      printf 'claude 7d %d\n' "$((100 - used))"
    fi
  fi
}

case "$format" in
  json)
    print_json
    ;;
  remaining)
    print_remaining
    ;;
  text)
    print_text
    ;;
esac
