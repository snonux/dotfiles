#!/usr/bin/env bash
# Upload images to Immich, skipping duplicates via SHA1 checksum.
# Usage: immich-upload <file_or_directory>
#
# If <file_or_directory> is a single file, upload just that file.
# If it is a directory, recursively find all image files and upload them.
# Duplicates are detected via the bulk-upload-check API before uploading.
# Exits non-zero, after a summary naming the failed count, when any upload
# fails (curl error or an HTTP reply other than 200/201).

set -euo pipefail

_IMMICH_UPLOAD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/immich.sh
source "${_IMMICH_UPLOAD_DIR}/lib/immich.sh"

# Upload defaults to the paul account key; URL/CURL_* come from lib/immich.sh.
declare -r IMMICH_UPLOAD_ACCOUNT=paul

# Supported image extensions (case-insensitive)
IMAGE_EXTENSIONS='\.(jpg|jpeg|png|gif|webp|heic|heif|raw|cr2|nef|arw|dng|tiff|tif|bmp)$'

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

# Compute SHA1 (hex, lowercase) for a file.
file_sha1() {
    sha1sum "$1" | awk '{print $1}'
}

# Extract fileCreatedAt and fileModifiedAt from exiftool if available,
# otherwise fall back to filesystem timestamps.
# Output is ISO 8601 with milliseconds, e.g. 2024-01-15T10:30:00.000Z
# Returns 1 if the filesystem timestamp cannot be read: it runs inside
# $(...) under upload_file's '||', where set -e does not apply, so the date
# calls are checked explicitly.
file_timestamps() {
    local path="$1"
    local created modified

    if command -v exiftool &>/dev/null; then
        # Try to get DateTimeOriginal first, then CreateDate, then FileModifyDate
        created=$(exiftool -s3 -DateTimeOriginal "$path" 2>/dev/null || true)
        if [[ -z "$created" ]]; then
            created=$(exiftool -s3 -CreateDate "$path" 2>/dev/null || true)
        fi
        if [[ -z "$created" ]]; then
            created=$(exiftool -s3 -FileModifyDate "$path" 2>/dev/null || true)
        fi
        # exiftool returns something like "2024:01:15 10:30:00" or
        # "2024:01:15 10:30:00+03:00" with timezone offset.
        if [[ -n "$created" ]]; then
            # Strip timezone offset if present, replace colons with dashes for date part,
            # replace space with T, append .000Z
            created=$(echo "$created" | sed -E 's/([0-9]{4}):([0-9]{2}):([0-9]{2})/\1-\2-\3/; s/ /T/; s/[+-][0-9]{2}:[0-9]{2}$//; s/$/.000Z/')
        fi
    fi

    if [[ -z "$created" ]]; then
        created=$(date -r "$path" -u '+%Y-%m-%dT%H:%M:%S.000Z') || return 1
    fi

    modified=$(date -r "$path" -u '+%Y-%m-%dT%H:%M:%S.000Z') || return 1

    echo "$created"
    echo "$modified"
}

# Reject paths that cannot travel safely through checksum<TAB>path lines
# or line-oriented file lists (find -print / while read).
_assert_safe_path() {
    local -r path="$1"
    case "$path" in
        *$'\n'*|*$'\r'*|*$'\t'*)
            die "path contains newline/tab (unsupported): ${path@Q}"
            ;;
    esac
}

# Escape a path for curl -F quoted-filename syntax: field=@"path"
# Backslashes and double quotes must be escaped inside the quotes.
_curl_escape_form_path() {
    local path="$1"
    path=${path//\\/\\\\}
    path=${path//\"/\\\"}
    printf '%s' "$path"
}

# Build a curl -F file-field argument with quoted path (and optional
# Content-Disposition filename). Commas/semicolons in the path then stay
# inside quotes and are not treated as multipart separators.
# Callers that need Immich's DTO filename field should also pass
# --form-string filename=... (safer for quote-heavy names than relying
# only on the disposition filename= segment).
_curl_form_file_field() {
    local -r field="$1"
    local -r path="$2"
    local -r name="${3:-}"
    local escaped_path escaped_name
    escaped_path=$(_curl_escape_form_path "$path")
    if [[ -n "$name" ]]; then
        escaped_name=$(_curl_escape_form_path "$name")
        printf '%s=@"%s";filename="%s"' "$field" "$escaped_path" "$escaped_name"
    else
        printf '%s=@"%s"' "$field" "$escaped_path"
    fi
}

# stdin: checksum<TAB>path lines → stdout: Immich bulk-upload-check JSON.
# Paths are encoded with json.dumps (never printf into JSON).
# Dies clearly if a record is not exactly checksum<TAB>path.
_build_bulk_check_json() {
    python3 -c '
import json
import sys

assets = []
for lineno, raw in enumerate(sys.stdin, start=1):
    line = raw.rstrip("\n")
    if not line:
        continue
    if "\t" not in line:
        raise SystemExit(
            f"bulk-check record {lineno}: missing tab separator"
        )
    checksum, path = line.split("\t", 1)
    if not checksum or not path:
        raise SystemExit(
            f"bulk-check record {lineno}: empty checksum or path"
        )
    if "\t" in path or "\n" in path or "\r" in path:
        raise SystemExit(
            f"bulk-check record {lineno}: path contains newline/tab"
        )
    assets.append({"id": path, "checksum": checksum})
json.dump({"assets": assets}, sys.stdout, separators=(",", ":"))
sys.stdout.write("\n")
'
}

# Parse bulk-upload-check response; print duplicate asset ids (one per line).
# Fails loud on invalid JSON or a missing/non-list results field.
_duplicate_ids_from_response() {
    local -r resp_file="$1"
    python3 -c '
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
if not isinstance(data, dict):
    raise SystemExit(
        "bulk-upload-check response is not a JSON object"
    )
results = data.get("results")
if results is None:
    raise SystemExit("bulk-upload-check response missing results")
if not isinstance(results, list):
    raise SystemExit("bulk-upload-check results is not a list")
for item in results:
    if not isinstance(item, dict):
        raise SystemExit(
            "bulk-upload-check result entry is not an object"
        )
    if item.get("action") == "reject" and item.get("reason") == "duplicate":
        asset_id = item.get("id")
        if asset_id is None:
            raise SystemExit(
                "duplicate result missing id"
            )
        print(asset_id)
' "$resp_file"
}

# ------------------------------------------------------------------
# Upload a single file
# ------------------------------------------------------------------

# Returns 0 when the server answers 201 (uploaded) or 200 (duplicate) and
# 1 on a curl error or any other HTTP code, so callers can count failures.
# Callers run it as `upload_file ... || ...`, which turns set -e off inside
# this function; steps that used to rely on set -e check their status here.
upload_file() {
    local file="$1"
    local api_key="$2"
    _assert_safe_path "$file"
    local filename
    filename=$(basename "$file")
    local checksum
    # Status checked right here (sha1sum | awk under pipefail).
    # shellcheck disable=SC2310
    checksum=$(file_sha1 "$file") || {
        warn "  Failed to checksum: $filename"
        return 1
    }

    local fileCreatedAt fileModifiedAt
    local timestamps
    # Without this check a failed date uploaded empty timestamps.
    # shellcheck disable=SC2310
    timestamps=$(file_timestamps "$file") || {
        warn "  Failed to read timestamps: $filename"
        return 1
    }
    fileCreatedAt=$(echo "$timestamps" | sed -n '1p')
    fileModifiedAt=$(echo "$timestamps" | sed -n '2p')

    info "Uploading: $filename"

    # tmpfile is removed explicitly at the end of this function. No RETURN
    # trap: one set inside a function stays set and fires again when the
    # caller (main, bulk_upload) returns, where the local tmpfile is gone,
    # so set -u aborted with "tmpfile: unbound variable" (exit 1). Every
    # path after mktemp reaches that rm (curl failure is caught).
    local tmpfile form_asset
    tmpfile=$(mktemp) || {
        warn "  mktemp failed for: $filename"
        return 1
    }

    # Quoted @path + disposition filename= for curl multipart parsing;
    # also send Immich DTO filename via --form-string (quote-safe).
    form_asset=$(_curl_form_file_field assetData "$file" "$filename")

    # Immich 3.x dropped the deviceAssetId/deviceId columns (migration
    # DropDeviceIdAndDeviceAssetId). The /api/assets endpoint still tolerates
    # those multipart fields but ignores them, so they are removed here to stay
    # correct and future-proof. Duplicate detection is done server-side via the
    # x-immich-checksum header (and the bulk-upload-check pre-pass), which
    # returns HTTP 200 {"status":"duplicate"} instead of 201 {"status":"created"}.
    local http_code rc=0
    # curl_immich_key keeps the API key off curl's argv (see lib); the
    # multipart body comes from -F/--form-string, so curl's stdin is free.
    # Its status is curl's and is handled below (000 = curl error).
    # shellcheck disable=SC2310
    http_code=$(curl_immich_key "$CURL_DOWNLOAD_TIMEOUT" "$api_key" \
        -s -o "$tmpfile" -w '%{http_code}' -X POST \
        -H "x-immich-checksum: $checksum" \
        -F "$form_asset" \
        --form-string "filename=$filename" \
        --form-string "fileCreatedAt=$fileCreatedAt" \
        --form-string "fileModifiedAt=$fileModifiedAt" \
        "$IMMICH_URL/api/assets" 2>/dev/null) || { http_code="000"; }

    if [[ "$http_code" == "200" ]]; then
        info "  Skipped (duplicate): $filename"
    elif [[ "$http_code" == "201" ]]; then
        info "  Uploaded: $filename"
    elif [[ "$http_code" == "000" ]]; then
        warn "  Failed to upload: $filename (curl error)"
        rc=1
    else
        warn "  Unexpected response $http_code for: $filename"
        cat "$tmpfile" >&2 || true
        rc=1
    fi

    rm -f "$tmpfile"
    return "$rc"
}

# ------------------------------------------------------------------
# Bulk upload with duplicate checking
# ------------------------------------------------------------------

bulk_upload() {
    local api_key="$1"
    local files_list="$2"

    local total missing_count
    total=$(wc -l < "$files_list")

    # Compute SHA1 for each file and build checksum<TAB>path records
    local tmp_json tmp_missing
    tmp_json=$(mktemp)
    tmp_missing=$(mktemp)

    info "Computing SHA1 checksums for $total file(s)..."
    while IFS= read -r file; do
        _assert_safe_path "$file"
        local checksum
        checksum=$(file_sha1 "$file")
        printf '%s\t%s\n' "$checksum" "$file" >> "$tmp_json"
    done < "$files_list"

    # Build the bulk-upload-check JSON via json.dumps (safe for " \ etc.)
    _build_bulk_check_json < "$tmp_json" > "$tmp_json.json"

    info "Checking for duplicates on server..."
    local response
    # Key off curl's argv via curl_immich_key; the body is read from a file.
    # shellcheck disable=SC2310 # status is curl's; failure dies right here
    response=$(curl_immich_key -f "$CURL_SEARCH_TIMEOUT" "$api_key" -X POST \
        -H "Content-Type: application/json" \
        -d @"$tmp_json.json" \
        "$IMMICH_URL/api/assets/bulk-upload-check" 2>/dev/null) \
        || die "bulk-upload-check failed"

    # Parse the response to find which files are duplicates.
    # Response: { "results": [{ "id": "...", "action": "reject", "reason": "duplicate", ... }] }
    local resp_file
    resp_file=$(mktemp)
    printf '%s\n' "$response" > "$resp_file"
    # shellcheck disable=SC2310 # a single python3 call; failure dies here
    _duplicate_ids_from_response "$resp_file" > "$tmp_missing.exists" \
        || die "failed to parse bulk-upload-check response"
    rm -f "$resp_file"

    # Build the missing files list
    while IFS=$'\t' read -r checksum file; do
        if ! grep -Fxq "$file" "$tmp_missing.exists"; then
            echo "$file" >> "$tmp_missing"
        fi
    done < "$tmp_json"

    missing_count=$(wc -l < "$tmp_missing" | awk '{print $1}')
    local dup_count=$(( total - missing_count ))
    info "Found $dup_count duplicate(s), $missing_count file(s) to upload"

    if [[ "$missing_count" -eq 0 ]]; then
        info "Nothing to upload."
        rm -f "$tmp_json" "$tmp_json.json" "$tmp_missing" "$tmp_missing.exists"
        return
    fi

    # Upload missing files, counting failures (like immich-export's
    # download_assets) so a run with failed uploads does not exit 0.
    local n=0
    local -i failed=0
    while IFS= read -r file; do
        ((n++)) || true
        echo "[$n/$missing_count] $file"
        # shellcheck disable=SC2310 # upload_file checks each step itself
        upload_file "$file" "$api_key" || ((failed++)) || true
    done < "$tmp_missing"

    rm -f "$tmp_json" "$tmp_json.json" "$tmp_missing" "$tmp_missing.exists"

    # Dies here rather than returning non-zero: main would have to call
    # bulk_upload in a `||` context, which turns set -e off inside it.
    if ((failed > 0)); then
        die "$failed upload(s) failed (of $missing_count attempted)"
    fi
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------

main() {
    if [[ $# -ne 1 ]]; then
        die "Usage: $(basename "$0") <file_or_directory>"
    fi

    local src="$1"

    if [[ ! -e "$src" ]]; then
        die "Path does not exist: $src"
    fi

    if [[ ! -r "$src" ]]; then
        die "Path is not readable: $src"
    fi

    local api_key
    api_key=$(_account_api_key "$IMMICH_UPLOAD_ACCOUNT")

    detect_immich_url

    if [[ -f "$src" ]]; then
        # Single file upload
        info "Uploading single file: $src"
        # shellcheck disable=SC2310 # upload_file checks each step itself
        upload_file "$src" "$api_key" || die "1 upload(s) failed (of 1 attempted)"
    elif [[ -d "$src" ]]; then
        # Directory: collect image files recursively
        local files_list
        files_list=$(mktemp)
        # Expand the path now: the EXIT trap fires after main has returned,
        # when the local files_list no longer exists and set -u would abort
        # with "files_list: unbound variable" (exit 1).
        # shellcheck disable=SC2064 # early expansion is intended
        trap "rm -f ${files_list@Q}" EXIT

        info "Scanning directory: $src"
        find "$src" -type f -regextype posix-extended -iregex ".*$IMAGE_EXTENSIONS" -print > "$files_list"

        local count
        count=$(wc -l < "$files_list" | awk '{print $1}')
        if [[ "$count" -eq 0 ]]; then
            die "No image files found in: $src"
        fi
        info "Found $count image file(s)"

        bulk_upload "$api_key" "$files_list"
        rm -f "$files_list"
    else
        die "Unsupported path type: $src"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
