#!/usr/bin/env bash
# End-to-end test for the taskwarrior tag export/import round trip and the
# sibling note/gos exporters in fish/conf.d/taskwarrior.fish
# (_taskwarrior::export_tag, _taskwarrior::import_label, taskwarrior::export::bd,
# taskwarrior::export::maybe, taskwarrior::export::add, taskwarrior::export::wins,
# taskwarrior::gos_queue) against a sandboxed taskwarrior database.
#
# Covered hardening properties:
#   1. Tasks are deleted only after the export file was written successfully.
#      A failed write (missing $WORKTIME_DIR) and an empty export (exit 0 but
#      no content) must both keep the tasks. The same guard applies to the
#      note exporters (bd/maybe/add/wins) and gos_queue: a broken pipeline
#      (simulated with a jq-less PATH) or an unwritable target must keep the
#      tasks, while successful exports delete them.
#   2. Same-second exports of the same tag from different hosts produce
#      distinct files (tw-<tag>-export-<ts>-<host>-<status>.json) instead of
#      clobbering each other in the git-synced worktime dir. The "different
#      hosts" are simulated with per-sandbox fake `hostname` binaries, separate
#      sandbox task DBs and one shared worktime dir.
#   3. The importer's glob (tw-<label>-export-*.json) still finds the new
#      filenames, imports the tasks and removes the files — but only after a
#      successful import; a malformed file must survive for a later retry.
#   4. Repeated bd exports preserve the compacted note. A failed source read
#      or an installed note missing an exported entry must keep the task.
#
# Safety properties of this harness:
#   * Every `task` and `fish` invocation runs via env -i with HOME, TASKDATA
#     and .taskrc (data.location) pointed at the sandbox, so the real ~/.taskrc
#     (S3 sync, 80MB+ DB) is never read and the real DB is never touched.
#     The real task binary is never launched against the real home.
#   * Hostnames come from fake binaries in the sandbox PATH; no real hostname
#     leaks into assertions.
#   * The sandbox (mktemp -d under /tmp) is removed on exit, even on failure.
#
# Usage: ./scripts/taskwarrior-export-e2e
#
# Exit status: 0 = all phases passed; 1 = at least one assertion failed

set -uo pipefail

PROGRAM=${0##*/}
FAILURES=0
SAN=""
REAL_TASK=$(command -v task)
REAL_FISH=$(command -v fish)
CHILD_PATH="/usr/local/bin:/usr/bin:/bin"
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
TASKWARRIOR_FISH="$DOTFILES/fish/conf.d/taskwarrior.fish"

# Fixed timestamps so every expected filename is deterministic
TS_MAIN=1790000000
TS_MISSING=1790000001
TS_COLLISION=1790000002

cleanup() {
  [[ -n "$SAN" && -d "$SAN" ]] && rm -rf "$SAN"
}
trap cleanup EXIT

# shellcheck source=scripts/lib/e2e-assert.sh
source "$(cd "$(dirname "$0")" && pwd)/lib/e2e-assert.sh"

# real taskwarrior against a sandbox DB. tw HOME TASKDATA <args...>
tw() {
  env -i HOME="$1" TASKDATA="$2" PATH="$CHILD_PATH" \
    "$REAL_TASK" rc.verbose=nothing "${@:3}"
}

# run the repo fish functions against a sandbox DB. run_fish HOME TASKDATA
# WORKTIME_DIR EXTRA_PATH <fish code>
run_fish() {
  env -i HOME="$1" TASKDATA="$2" WORKTIME_DIR="$3" QUICKLOG_HEADLESS=1 \
    PATH="$4:$CHILD_PATH" "$REAL_FISH" --no-config -c \
    "source '$TASKWARRIOR_FISH'; ${5}"
}

# --- preflight --------------------------------------------------------------------------

if [[ -z "$REAL_TASK" || -z "$REAL_FISH" ]]; then
  echo "$PROGRAM: need task and fish in PATH" >&2
  exit 1
fi
if [[ ! -r "$TASKWARRIOR_FISH" ]]; then
  echo "$PROGRAM: $TASKWARRIOR_FISH not readable — run from the dotfiles repo" >&2
  exit 1
fi
if ! command -v jq >/dev/null; then
  echo "$PROGRAM: jq not found in PATH" >&2
  exit 1
fi

# --- sandbox ----------------------------------------------------------------------------

say "build sandbox"

SAN=$(mktemp -d /tmp/tw-export-e2e.XXXXXX)
mkdir -p "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/bin" "$SAN/binA" "$SAN/binB"
echo "data.location=$SAN/taskdata" >"$SAN/home/.taskrc"
printf '#!/bin/sh\necho hostA\n' >"$SAN/binA/hostname"
printf '#!/bin/sh\necho hostB\n' >"$SAN/binB/hostname"
chmod +x "$SAN/binA/hostname" "$SAN/binB/hostname"
# Fake `task` for the empty-export phase: count says 1, export writes nothing
# and exits 0, delete must never run (marker file stays absent).
FAKE_TASK_MARKER="$SAN/fake-task-delete-marker"
printf '#!/bin/sh\ncase "$*" in\n  *count*) echo 1 ;;\n  *export*) exit 0 ;;\n  *delete*) : >"$FAKE_TASK_MARKER" ;;\nesac\nexit 0\n' \
  >"$SAN/bin/task"
chmod +x "$SAN/bin/task"
# jq-less PATH to simulate a broken export pipeline deterministically (used by
# the note/gos exporter failure phases). Everything the exporters need except
# jq; hostname comes from the fake-hostname dir appended after this one.
mkdir -p "$SAN/nojq"
for bin in task date sort cat rm mv grep sed find yes touch uname sh; do
  if ! command -v "$bin" >/dev/null; then
    echo "$PROGRAM: $bin not found in PATH" >&2
    exit 1
  fi
  ln -s "$(command -v "$bin")" "$SAN/nojq/$bin"
done
echo "sandbox at $SAN"

# --- phase 1: successful export writes per-host files and deletes the tasks ---------------

say "phase 1: export success path"

tw "$SAN/home" "$SAN/taskdata" add "e2e pending alpha" +e2e >/dev/null
tw "$SAN/home" "$SAN/taskdata" add "e2e completed alpha" +e2e >/dev/null
tw "$SAN/home" "$SAN/taskdata" rc.confirmation=off '/e2e completed alpha/' done >/dev/null
assert_eq "one pending +e2e task staged" \
  "$(tw "$SAN/home" "$SAN/taskdata" +e2e status:pending count)" 1
assert_eq "one completed +e2e task staged" \
  "$(tw "$SAN/home" "$SAN/taskdata" +e2e status:completed count)" 1

rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "_taskwarrior::export_tag e2e $TS_MAIN" >"$SAN/phase1.out" 2>"$SAN/phase1.err" || rc=$?
assert_rc "export_tag run" 0 "$rc"

PENDING_FILE="$SAN/wt/tw-e2e-export-$TS_MAIN-hostA-pending.json"
COMPLETED_FILE="$SAN/wt/tw-e2e-export-$TS_MAIN-hostA-completed.json"
assert_exists "pending export file has host segment" "$PENDING_FILE"
assert_exists "completed export file has host segment" "$COMPLETED_FILE"
assert_eq "pending export content" \
  "$(jq -r '.[].description' "$PENDING_FILE")" "e2e pending alpha"
assert_eq "completed export content" \
  "$(jq -r '.[].description' "$COMPLETED_FILE")" "e2e completed alpha"
assert_eq "pending tasks deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" +e2e status:pending count)" 0
assert_eq "completed tasks deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" +e2e status:completed count)" 0
assert_contains "export progress reported" "$(cat "$SAN/phase1.out")" "Exporting 1 pending tasks tagged +e2e"

# --- phase 2: failed write keeps the tasks ------------------------------------------------

say "phase 2: missing WORKTIME_DIR keeps the tasks"

tw "$SAN/home" "$SAN/taskdata" add "keeper task" +keep >/dev/null
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/does-not-exist" "$SAN/binA" \
  "_taskwarrior::export_tag keep $TS_MISSING" >"$SAN/phase2.out" 2>"$SAN/phase2.err" || rc=$?
assert_rc "export_tag run with missing dir" 1 "$rc"
assert_eq "task NOT deleted when the export write fails" \
  "$(tw "$SAN/home" "$SAN/taskdata" +keep status:pending count)" 1
assert_contains "failure warning on stderr" "$(cat "$SAN/phase2.err")" "Export failed"
assert_contains "warning names the bad path" \
  "$(cat "$SAN/phase2.err")" "$SAN/does-not-exist/tw-keep-export-$TS_MISSING"
assert_eq "no stray export file materialized anywhere" \
  "$(find "$SAN" -name 'tw-keep-*' | wc -l | tr -d ' ')" 0

# --- phase 3: empty export (exit 0, no content) must not delete ----------------------------

say "phase 3: empty export keeps the tasks (test -s guard)"

rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" WORKTIME_DIR="$SAN/wt" \
  QUICKLOG_HEADLESS=1 FAKE_TASK_MARKER="$FAKE_TASK_MARKER" \
  PATH="$SAN/bin:$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; _taskwarrior::export_tag empty $TS_MAIN" \
  >"$SAN/phase3.out" 2>"$SAN/phase3.err" || rc=$?
assert_rc "export_tag run with empty export" 1 "$rc"
assert_missing "delete not invoked when the export file is empty" "$FAKE_TASK_MARKER"
assert_contains "failure warning on stderr" "$(cat "$SAN/phase3.err")" "Export failed"
assert_eq "empty partial export file cleaned up" \
  "$(find "$SAN/wt" -name 'tw-empty-*' | wc -l | tr -d ' ')" 0

# --- phase 4: same-second exports from two hosts do not clobber each other ----------------

say "phase 4: same-second exports from two hosts"

# Second sandbox home/DB pair, so hostA and hostB have independent task DBs
# but share one git-synced worktime dir.
mkdir -p "$SAN/homeA" "$SAN/homeB" "$SAN/taskdataA" "$SAN/taskdataB" "$SAN/wt-shared"
echo "data.location=$SAN/taskdataA" >"$SAN/homeA/.taskrc"
echo "data.location=$SAN/taskdataB" >"$SAN/homeB/.taskrc"
tw "$SAN/homeA" "$SAN/taskdataA" add "collision from hostA" +mult >/dev/null
tw "$SAN/homeB" "$SAN/taskdataB" add "collision from hostB" +mult >/dev/null

rc=0
run_fish "$SAN/homeA" "$SAN/taskdataA" "$SAN/wt-shared" "$SAN/binA" \
  "_taskwarrior::export_tag mult $TS_COLLISION" >"$SAN/phase4a.out" 2>&1 || rc=$?
assert_rc "hostA export run" 0 "$rc"
rc=0
run_fish "$SAN/homeB" "$SAN/taskdataB" "$SAN/wt-shared" "$SAN/binB" \
  "_taskwarrior::export_tag mult $TS_COLLISION" >"$SAN/phase4b.out" 2>&1 || rc=$?
assert_rc "hostB export run" 0 "$rc"

HOSTA_FILE="$SAN/wt-shared/tw-mult-export-$TS_COLLISION-hostA-pending.json"
HOSTB_FILE="$SAN/wt-shared/tw-mult-export-$TS_COLLISION-hostB-pending.json"
assert_exists "hostA export file" "$HOSTA_FILE"
assert_exists "hostB export file" "$HOSTB_FILE"
assert_eq "hostA file kept its own tasks" \
  "$(jq -r '.[].description' "$HOSTA_FILE")" "collision from hostA"
assert_eq "hostB file kept its own tasks" \
  "$(jq -r '.[].description' "$HOSTB_FILE")" "collision from hostB"

# --- phase 5: importer glob finds the new filenames and round-trips ------------------------

say "phase 5: import round trip"

rc=0
run_fish "$SAN/homeA" "$SAN/taskdataA" "$SAN/wt-shared" "$SAN/binA" \
  "_taskwarrior::import_label mult" >"$SAN/phase5.out" 2>&1 || rc=$?
assert_rc "import_label run" 0 "$rc"
assert_missing "hostA export file consumed" "$HOSTA_FILE"
assert_missing "hostB export file consumed" "$HOSTB_FILE"
IMPORTED=$(tw "$SAN/homeA" "$SAN/taskdataA" status:pending export | jq -r '.[].description' | sort)
assert_contains "hostA DB re-imported its own task" "$IMPORTED" "collision from hostA"
assert_contains "hostA DB imported hostB's task" "$IMPORTED" "collision from hostB"

# --- phase 6: old-format (pre-hostname) files still import ---------------------------------

say "phase 6: legacy filename still imports"

mkdir -p "$SAN/wt-legacy"
cat >"$SAN/wt-legacy/tw-legacy-export-1-pending.json" <<'EOF'
[
{"description": "legacy file task", "status": "pending", "entry": "20260101T000000Z", "uuid": "11111111-2222-3333-4444-555555555555"}
]
EOF
rc=0
run_fish "$SAN/homeA" "$SAN/taskdataA" "$SAN/wt-legacy" "$SAN/binA" \
  "_taskwarrior::import_label legacy" >"$SAN/phase6.out" 2>&1 || rc=$?
assert_rc "legacy import_label run" 0 "$rc"
assert_contains "legacy-format file imported" \
  "$(tw "$SAN/homeA" "$SAN/taskdataA" status:pending export | jq -r '.[].description')" \
  "legacy file task"
assert_missing "legacy export file consumed" "$SAN/wt-legacy/tw-legacy-export-1-pending.json"

# --- phase 7: import_label keeps files that fail to import ------------------

say "phase 7: import_label keeps files that fail to import"

mkdir -p "$SAN/wt-import"
printf 'not valid json' >"$SAN/wt-import/tw-imp-export-1-pending.json"
cat >"$SAN/wt-import/tw-imp-export-2-pending.json" <<'EOF'
[
{"description": "import guard task", "status": "pending", "entry": "20260102T000000Z", "uuid": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"}
]
EOF
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt-import" "$SAN/binA" \
  "_taskwarrior::import_label imp" >"$SAN/phase7.out" 2>&1 || rc=$?
assert_rc "import_label reports one failed file" 1 "$rc"
assert_exists "malformed file kept for a later retry on failed import" \
  "$SAN/wt-import/tw-imp-export-1-pending.json"
assert_missing "valid file consumed after successful import" \
  "$SAN/wt-import/tw-imp-export-2-pending.json"
assert_contains "valid file's task imported" \
  "$(tw "$SAN/home" "$SAN/taskdata" status:pending export | jq -r '.[].description')" "import guard task"
assert_contains "import error reported for the malformed file" \
  "$(cat "$SAN/phase7.out")" "tw-imp-export-1"

# --- phase 8: export::maybe and export::wins guard the delete ----------------

say "phase 8: export::maybe/export::wins guard the delete"

mkdir -p "$SAN/home/Notes/random"
cat >"$SAN/home/Notes/random/Maybe.md" <<'EOF'
# Maybe (7)

Thinks I maybe will do something about or maybe not

* old maybe line
EOF
cat >"$SAN/home/Notes/random/Wins.md" <<'EOF'
# wins (7)

Wins I had

* old win line
EOF
tw "$SAN/home" "$SAN/taskdata" add project:foo +maybe "maybe entry one" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add +win "wins entry one" >/dev/null

# Failure path: no jq on PATH → the capture is empty → the deletes must not run
rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/nojq:$SAN/binA" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::export::maybe" \
  >"$SAN/phase8-maybe-fail.out" 2>"$SAN/phase8-maybe-fail.err" || rc=$?
assert_rc "maybe export reports missing jq" 1 "$rc"
rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/nojq:$SAN/binA" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::export::wins" \
  >"$SAN/phase8-wins-fail.out" 2>"$SAN/phase8-wins-fail.err" || rc=$?
assert_rc "wins export reports missing jq" 1 "$rc"
assert_eq "failed pipeline keeps the maybe task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +maybe status:pending count)" 1
assert_eq "failed pipeline keeps the win task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +win status:pending count)" 1
assert_not_contains "Maybe.md has no new line on failure" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "maybe entry one"
assert_contains "Maybe.md keeps its old lines on failure" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "old maybe line"
assert_eq "no leftover tmp files on failure" \
  "$(find "$SAN/home/Notes/random" -name '*.tmp.*' | wc -l | tr -d ' ')" 0

# Success path: entries written, then tasks deleted
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::maybe; taskwarrior::export::wins" >"$SAN/phase8-ok.out" 2>&1 || rc=$?
assert_rc "maybe/wins success run" 0 "$rc"
assert_contains "maybe entry exported to Maybe.md" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "* foo: maybe entry one"
assert_contains "old maybe line preserved" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "* old maybe line"
assert_contains "wins entry exported to Wins.md" \
  "$(cat "$SAN/home/Notes/random/Wins.md")" "* wins entry one"
assert_eq "maybe task deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" +maybe status:pending count)" 0
assert_eq "win task deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" +win status:pending count)" 0

# --- phase 9: export::bd guards the delete -----------------------------------

say "phase 9: export::bd guards the delete"

mkdir -p "$SAN/home/Notes/Bulgarian"
tw "$SAN/home" "$SAN/taskdata" add +bd "dumi edno" >/dev/null

rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/nojq:$SAN/binA" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::export::bd" \
  >"$SAN/phase9-fail.out" 2>"$SAN/phase9-fail.err" || rc=$?
assert_rc "Bulgarian export reports missing jq" 1 "$rc"
assert_eq "failed pipeline keeps the +bd dumi" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 1
assert_eq "empty export file cleaned up by compaction" \
  "$(find "$SAN/home/Notes/Bulgarian" \( -name 'bd-[0-9]*' -o -name '*.tmp' \) | wc -l | tr -d ' ')" 0

rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::bd" >"$SAN/phase9-ok.out" 2>&1 || rc=$?
assert_rc "export::bd success run" 0 "$rc"
assert_contains "dumi compacted" \
  "$(cat "$SAN/home/Notes/Bulgarian/bd-compacted.txt")" "dumi edno"
assert_eq "+bd dumi deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 0

BD_NOTE="$SAN/home/Notes/Bulgarian/bd-compacted.txt"
tw "$SAN/home" "$SAN/taskdata" add +bd "dumi dve" >/dev/null
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::bd" >"$SAN/phase9-rerun.out" 2>&1 || rc=$?
assert_rc "export::bd rerun" 0 "$rc"
assert_exists "compacted note survives rerun" "$BD_NOTE"
assert_eq "rerun retains old and new dumi" \
  "$(cat "$BD_NOTE")" $'dumi dve\ndumi edno'
assert_eq "rerun removes dated source files" \
  "$(find "$SAN/home/Notes/Bulgarian" -name 'bd-[0-9]*.txt' | wc -l | tr -d ' ')" 0
assert_eq "rerun deletes exported task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 0

# Simulate cat printing the new source and then failing before the old note.
# sort still exits successfully; the pipeline must not install that partial note.
tw "$SAN/home" "$SAN/taskdata" add +bd "dumi tri" >/dev/null
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "function cat; command cat \$argv[1]; return 1; end; taskwarrior::export::bd" \
  >"$SAN/phase9-cat-fail.out" 2>&1 || rc=$?
assert_rc "export::bd failed source read run" 1 "$rc"
assert_eq "failed source read preserves compacted note" \
  "$(cat "$BD_NOTE")" $'dumi dve\ndumi edno'
assert_eq "failed source read keeps exported task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 1
assert_eq "failed source read keeps dated source" \
  "$(find "$SAN/home/Notes/Bulgarian" -name 'bd-[0-9]*.txt' | wc -l | tr -d ' ')" 1

rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::bd" >"$SAN/phase9-retry.out" 2>&1 || rc=$?
assert_rc "export::bd retry after failed read" 0 "$rc"
assert_eq "retry restores all dumi" \
  "$(cat "$BD_NOTE")" $'dumi dve\ndumi edno\ndumi tri'
assert_eq "retry deletes exported task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 0

# Make mv return success after installing an incomplete note. The verification
# must retain the dated source and task for a later retry.
cp "$BD_NOTE" "$SAN/bd-before-corruption.txt"
tw "$SAN/home" "$SAN/taskdata" add +bd "dumi chetiri" >/dev/null
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "function mv; command mv \$argv; if string match -q '*/bd-compacted.txt' -- \$argv[-1]; printf '%s\\n' 'truncated' >\$argv[-1]; end; end; taskwarrior::export::bd" \
  >"$SAN/phase9-incomplete.out" 2>&1 || rc=$?
assert_rc "export::bd incomplete note run" 1 "$rc"
assert_eq "incomplete installed note keeps exported task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 1
assert_eq "incomplete installed note keeps dated source" \
  "$(find "$SAN/home/Notes/Bulgarian" -name 'bd-[0-9]*.txt' | wc -l | tr -d ' ')" 1
cp "$SAN/bd-before-corruption.txt" "$BD_NOTE"
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::bd" >"$SAN/phase9-incomplete-retry.out" 2>&1 || rc=$?
assert_rc "export::bd retry after incomplete note" 0 "$rc"
assert_eq "retry after incomplete note preserves all entries" \
  "$(cat "$BD_NOTE")" $'dumi chetiri\ndumi dve\ndumi edno\ndumi tri'
assert_eq "retry after incomplete note deletes task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 0

# --- phase 10: export::add guards the delete ---------------------------------

say "phase 10: export::add guards the delete"

tw "$SAN/home" "$SAN/taskdata" add project:e2eproj +add "note line one" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add project:dirproj +add "dir note" >/dev/null
# A directory where the note file should go: every write to it fails
mkdir "$SAN/home/Notes/random/dirproj.md"
rc=0
run_fish "$SAN/home" "$SAN/taskdata" "$SAN/wt" "$SAN/binA" \
  "taskwarrior::export::add" >"$SAN/phase10.out" 2>"$SAN/phase10.err" || rc=$?
assert_rc "export::add run" 1 "$rc"
assert_contains "note routed to the project file" \
  "$(cat "$SAN/home/Notes/random/e2eproj.md")" "* note line one"
assert_eq "routed note deleted after successful export" \
  "$(tw "$SAN/home" "$SAN/taskdata" project:e2eproj +add status:pending count)" 0
assert_eq "unwritable target keeps the note" \
  "$(tw "$SAN/home" "$SAN/taskdata" project:dirproj +add status:pending count)" 1
assert_contains "failure warning on stderr" "$(cat "$SAN/phase10.err")" "Export failed"

# --- phase 11: gos_queue guards the delete -----------------------------------

say "phase 11: gos_queue guards the delete"

mkdir -p "$SAN/gos"
tw "$SAN/home" "$SAN/taskdata" add +share +li "share me" >/dev/null
rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" GOS_DIR="$SAN/gos" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::gos_queue" >"$SAN/phase11.out" 2>&1 || rc=$?
assert_rc "gos_queue success run" 0 "$rc"
GOS_FILE=$(find "$SAN/gos" -name '*.txt' | head -1)
assert_exists "gos queue file written" "$GOS_FILE"
assert_contains "gos message content" "$(cat "$GOS_FILE")" "share:li share me"
assert_eq "shared task deleted after queueing" \
  "$(tw "$SAN/home" "$SAN/taskdata" +share status:pending count)" 0

# Failure path: read-only gos dir → the queue write fails → the share is kept
chmod a-w "$SAN/gos"
tw "$SAN/home" "$SAN/taskdata" add +share "share two" >/dev/null
rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" GOS_DIR="$SAN/gos" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::gos_queue" >"$SAN/phase11b.out" 2>&1 || rc=$?
assert_rc "unwritable gos dir reports failure" 1 "$rc"
assert_eq "unwritable gos dir keeps the share" \
  "$(tw "$SAN/home" "$SAN/taskdata" +share status:pending count)" 1
assert_contains "failure warning printed" "$(cat "$SAN/phase11b.out")" "keeping the share"
chmod u+w "$SAN/gos"

# --- phase 12: partial output from a failed task export keeps every task ----

say "phase 12: partial task export failure keeps every task"

tw "$SAN/home" "$SAN/taskdata" add +bd "partial bd" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add project:partial +maybe "partial maybe" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add +win "partial win" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add project:partial +add "partial add" >/dev/null
tw "$SAN/home" "$SAN/taskdata" add +share "partial share" >/dev/null
for exporter in \
  taskwarrior::export::bd taskwarrior::export::maybe \
  taskwarrior::export::wins taskwarrior::export::add taskwarrior::gos_queue; do
  rc=0
  env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" WORKTIME_DIR="$SAN/wt" GOS_DIR="$SAN/gos" QUICKLOG_HEADLESS=1 \
    PATH="$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
    "source '$TASKWARRIOR_FISH'; function task; if contains -- export \$argv; printf '[{\\\"description\\\":\\\"partial\\\",\\\"project\\\":\\\"partial\\\",\\\"tags\\\":[\\\"share\\\"]}]'; return 1; end; command task \$argv; end; $exporter" \
    >"$SAN/phase12-${exporter##*::}.out" 2>&1 || rc=$?
  assert_rc "$exporter reports partial export" 1 "$rc"
done
assert_eq "partial failed export keeps the bd task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +bd status:pending count)" 1
assert_eq "partial failed export keeps the maybe task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +maybe status:pending count)" 1
assert_eq "partial failed export keeps the win task" \
  "$(tw "$SAN/home" "$SAN/taskdata" +win status:pending count)" 1
assert_eq "partial failed export keeps the add task" \
  "$(tw "$SAN/home" "$SAN/taskdata" project:partial +add status:pending count)" 1
assert_eq "partial failed export keeps the new share task" \
  "$(tw "$SAN/home" "$SAN/taskdata" /partial\ share/ status:pending count)" 1

# --- phase 13: final note write failure defers deletion ---------------------

say "phase 13: failed final note write keeps maybe tasks"

mkdir "$SAN/home/Notes/random/Maybe.md.tmp.2"
rc=0
env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" WORKTIME_DIR="$SAN/wt" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; taskwarrior::export::maybe" \
  >"$SAN/phase13.out" 2>"$SAN/phase13.err" || rc=$?
assert_rc "failed final maybe note write reports failure" 1 "$rc"
assert_eq "maybe task survives a failed final note write" \
  "$(tw "$SAN/home" "$SAN/taskdata" +maybe status:pending count)" 1
assert_not_contains "Maybe.md remains unchanged after final write failure" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "partial maybe"
rmdir "$SAN/home/Notes/random/Maybe.md.tmp.2"

# --- phase 14: delete only the UUIDs from the exported snapshot -------------

say "phase 14: late matching task survives snapshot delete"

env -i HOME="$SAN/home" TASKDATA="$SAN/taskdata" WORKTIME_DIR="$SAN/wt" QUICKLOG_HEADLESS=1 \
  PATH="$SAN/binA:$CHILD_PATH" "$REAL_FISH" --no-config -c \
  "source '$TASKWARRIOR_FISH'; set -g inserted 0; function task; if contains -- delete \$argv; and test \$inserted -eq 0; set -g inserted 1; command task add project:foo +maybe 'late maybe'; end; command task \$argv; end; taskwarrior::export::maybe" \
  >"$SAN/phase14.out" 2>"$SAN/phase14.err"
assert_eq "exported maybe task is deleted" \
  "$(tw "$SAN/home" "$SAN/taskdata" /partial\ maybe/ status:pending count)" 0
assert_eq "late matching maybe task survives" \
  "$(tw "$SAN/home" "$SAN/taskdata" /late\ maybe/ status:pending count)" 1
assert_contains "snapshot task reached Maybe.md" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "partial maybe"
assert_not_contains "late task was not falsely recorded as exported" \
  "$(cat "$SAN/home/Notes/random/Maybe.md")" "late maybe"

# --- summary ------------------------------------------------------------------------------

echo
if [[ "$FAILURES" -eq 0 ]]; then
  echo "$PROGRAM: all phases passed"
  exit 0
fi
echo "$PROGRAM: $FAILURES assertion(s) failed" >&2
exit 1
