# Proton Bridge connection settings. Source with: set -a; . ~/.protonbridge; set +a
# Both protocols read the same local Bridge-generated password; no secret here.
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=mail@paul.buetow.org
IMAP_PASS=$(cat "$HOME/.config/aerc/protonbridge-password")
IMAP_SECURITY=STARTTLS
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=mail@paul.buetow.org
SMTP_PASS=$(cat "$HOME/.config/aerc/protonbridge-password")
SMTP_SECURITY=STARTTLS
