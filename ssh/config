#ControlPath ~/.ssh/cp-%C
#ControlMaster auto
#UseKeychain yes
AddKeysToAgent yes
ControlPersist 60m
#StrictHostKeyChecking no
LogLevel ERROR
#WarnWeakCrypto no

Host blowfish.buetow.org
User rex
Port 2

Host fishfinger.buetow.org
User rex
Port 2

Host *.aws.buetow.org
User ec2-user
Port 22

# Forgejo: hosts with a dedicated passphrase-less Forgejo key (e.g. rocky)
# must offer only that key. Guarded by the file check because this config is
# shared with hosts (e.g. earth) that authenticate with their default keys.
# Must stay above *.buetow.org so it is evaluated first.
Match host code.f3s.buetow.org exec "test -f %d/.ssh/id_ed25519_forgejo"
IdentityFile ~/.ssh/id_ed25519_forgejo
IdentitiesOnly yes

Host *.buetow.org
Port 2

Host git-server
HostName r0
Port 30022
User git
